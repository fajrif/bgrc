<%= content_for :head do %>
	<% if user_signed_in? && @booking.is_unpaid? %>
		<%= gateway_checkout_script_tag %>
	<% end %>
<% end %>
<% content_for :header_light, true %>

<section class="bbcc-section bbcc-confirm">
	<div class="container-lg">
		<div class="row g-4 g-lg-5">
			<article class="col-12 col-lg-8">
				<p class="bbcc-confirm-id">Order ID: <%= @booking.order_id %></p>
				<h1 class="bbcc-confirm-title">Booking Confirmation</h1>
				<p class="bbcc-confirm-when">
					<%= @booking.date.strftime('%A %b %d, %Y %I:%M %p') %>
					<span class="bbcc-confirm-sep">|</span>
					<%= @booking.court.name_label %>
				</p>

				<ul class="bbcc-confirm-facts">
					<li>Duration: <%= @booking.duration_label %></li>
					<% names = Array(@booking.player_names).reject(&:blank?) %>
					<% if names.any? %>
						<li>Other players: <%= names.join(", ") %></li>
					<% end %>
					<% if @booking.is_unpaid? %>
						<li id="cancellation-note">Please note: Bookings cannot be canceled or refunded within 24 hours of your reserved court time.</li>
					<% end %>
				</ul>

				<% unless @booking.group_class %>
					<div id="itemLists" class="bbcc-confirm-addons">
						<%= render "item_lists" %>
					</div>
				<% end %>
			</article>

			<aside class="col-12 col-lg-4">
				<div class="bbcc-confirm-panel">
					<h2 class="bbcc-confirm-panel-title">Booking Details</h2>
					<%= render "shared/payment_countdown", record: @booking, noun: "booking",
					           expire_url: expire_booking_path(@booking.order_id) %>
					<div id="itemListsPayment">
						<%= render "item_lists_payment" %>
					</div>
				</div>
			</aside>
		</div>
	</div>
</section>

<%= render "home/social_media" %>

<% unless user_signed_in? %>
	<%= render "login_modal" %>
<% end %>

<% if user_signed_in? && @booking.is_unpaid? %>
	<%= render "disclaimer_modal" %>
<% end %>

<% if @booking.is_unpaid? %>
	<%= render "shared/payment_timer" %>
<% end %>
