<%= content_for :head do %>
	<%= stylesheet_link_tag 'quantity_input.css' %>
	<% if user_signed_in? && @booking.is_unpaid? %>
		<script type="text/javascript" src="<%= configatron.midtrans_js_file %>" data-client-key="<%= configatron.midtrans_client_key %>"></script>
	<% end %>
<% end %>

<!-- start post content section -->
<section>
    <div class="container">
        <div class="row justify-content-center">
            <article class="col-lg-8 right-sidebar md-margin-60px-bottom sm-margin-40px-bottom">
                <!-- start post item -->
                <div class="col-12 blog-post-content margin-60px-bottom sm-margin-30px-bottom text-center text-md-start">
                    <div class="blog-text border-all d-inline-block w-100">
                        <div class="content padding-25px-all">
                            <div class="text-medium margin-15px-bottom alt-font">
                              <span>Order ID: <%= @booking.order_id %></span>
                            </div>
                            <h5 class="text-black text-uppercase alt-font letter-spacing-6 font-weight-600 margin-15px-bottom d-block">Booking Confirmation</h5>
                            <div class="text-large text-black margin-25px-bottom font-weight-500">
                              <span><%= @booking.date.strftime('%A %b %d, %Y %I:%M %p') %></span>&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;<span><%= @booking.court.name_label %></span>
                            </div>
                            <p class="text-medium mb-2"><strong>Duration:</strong> <%= @booking.duration_label %></p>

                            <% if @booking.is_unpaid? %>
                              <div id="cancellation-note">
                                <p class="text-medium"><strong>Please note:</strong> Bookings cannot be canceled or refunded within 24 hours of your reserved court time.</p>
                              </div>
                            <% end %>
                        </div>
                        <% unless @booking.group_class %>
                        <div id="itemLists" class="row row-cols-1 m-0 border-top border-color-extra-light-gray">
                          <%= render "item_lists" %>
                        </div>
                        <% end %>
                    </div>
                </div>
                <!-- end post item -->
            </article>
            <aside class="col-lg-4">
                <div class="margin-45px-bottom sm-margin-25px-bottom border padding-25px-all">
                    <div class="text-extra-dark-gray margin-50px-bottom alt-font text-uppercase font-weight-600 text-medium aside-title"><span>Booking Details</span></div>
                    <% if @booking.is_unpaid? %>
                      <!-- Countdown Timer (client-side only, outside AJAX-replaced area) -->
                      <div id="countdown-timer" data-time-remaining="<%= @booking.time_remaining %>" data-expire-url="<%= expire_booking_path(@booking.order_id) %>" class="mb-3 p-3" style="background-color: #fff3cd; border: 2px solid #ffc107; border-radius: 8px;">
                        <div class="text-center">
                          <p class="mb-2" style="font-size: 13px; color: #856404; font-weight: 500;">Time Remaining to Complete Payment</p>
                          <div id="timer-display" style="font-size: 38px; font-weight: bold; color: #dc3545; font-family: monospace; letter-spacing: 2px;">--:--</div>
                          <p class="mb-0 mt-2" style="font-size: 11px; color: #856404;">Your booking will be automatically cancelled if payment is not completed</p>
                        </div>
                      </div>
                      <!-- Expired message (hidden, shown by JS when timer ends) -->
                      <div id="expired-message" style="display: none;">
                        <div class="mb-3 p-3" style="background-color: #f8d7da; color: #721c24; border: 2px solid #dc3545; border-radius: 8px;">
                          <div class="text-center">
                            <h6 style="color: #721c24; font-weight: bold; margin-bottom: 10px;">Payment Time Expired</h6>
                            <p class="mb-2" style="font-size: 13px;"><strong>The 10-minute payment window has ended.</strong></p>
                            <p class="mb-0" style="font-size: 12px;">This booking has been cancelled.</p>
                          </div>
                        </div>
                      </div>
                    <% elsif @booking.expired? %>
                      <!-- Expired Timer Box -->
                      <div class="mb-3 p-3" style="background-color: #f8d7da; color: #721c24; border: 2px solid #dc3545; border-radius: 8px;">
                        <div class="text-center">
                          <h6 style="color: #721c24; font-weight: bold; margin-bottom: 10px;">Payment Time Expired</h6>
                          <p class="mb-2" style="font-size: 13px;"><strong>The 10-minute payment window has ended.</strong></p>
                          <p class="mb-0" style="font-size: 12px;">This booking has been cancelled.</p>
                        </div>
                      </div>
                    <% end %>
                    <div id="itemListsPayment">
                      <%= render "item_lists_payment" %>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>
<!-- end blog content section -->

<% unless user_signed_in? %>
  <%= render "login_modal" %>
<% end %>

<% if user_signed_in? && @booking.is_unpaid? %>
  <%= render "disclaimer_modal" %>
<% end %>

<% if @booking.is_unpaid? %>
<style>
  #page-lock-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.7);
    z-index: 9999;
    display: none;
    justify-content: center;
    align-items: center;
  }

  #page-lock-message {
    background-color: white;
    padding: 40px;
    border: 1px solid var(--bbcc-line);
    border-radius: 0;
    text-align: center;
    max-width: 500px;
  }

  #page-lock-message h3 {
    color: #dc3545;
    margin-bottom: 20px;
    font-size: 24px;
  }

  #page-lock-message p {
    color: #333;
    margin-bottom: 20px;
    font-size: 16px;
  }

  .page-locked {
    pointer-events: none;
    opacity: 0.5;
  }
</style>

<div id="page-lock-overlay">
  <div id="page-lock-message">
    <h3>⏰ Payment Time Expired</h3>
    <p><strong>The 10-minute payment window has ended.</strong></p>
    <p>This booking has been cancelled and the court slot is now available for others.</p>
    <div class="spinner-border text-primary" role="status" style="margin: 20px 0;">
      <span class="visually-hidden">Loading...</span>
    </div>
    <p style="font-size: 14px; color: #666;">Refreshing page...</p>
  </div>
</div>

<script>
  (function() {
    function initTimer() {
      var timerEl = document.getElementById('countdown-timer');
      if (!timerEl) return;

      var secondsLeft = parseInt(timerEl.getAttribute('data-time-remaining'), 10);
      var expireUrl = timerEl.getAttribute('data-expire-url');
      var displayEl = document.getElementById('timer-display');
      var isExpired = false;

      function showExpiredState() {
        // Hide timer, show expired message
        timerEl.style.display = 'none';
        var expiredMsg = document.getElementById('expired-message');
        if (expiredMsg) expiredMsg.style.display = 'block';
        var cancelNote = document.getElementById('cancellation-note');
        if (cancelNote) cancelNote.style.display = 'none';

        // Hide payment buttons, show expired in sidebar
        var paymentActions = document.getElementById('payment-actions');
        if (paymentActions) paymentActions.style.display = 'none';
        var expiredActions = document.getElementById('expired-actions');
        if (expiredActions) expiredActions.style.display = 'block';

        // Update status badge
        var statusBadge = document.getElementById('payment-status-badge');
        if (statusBadge) {
          statusBadge.style.backgroundColor = '#f8d7da';
          statusBadge.style.borderColor = '#dc3545';
          statusBadge.querySelector('small').style.color = '#721c24';
          statusBadge.querySelector('small').textContent = 'STATUS: EXPIRED';
        }

        // Disable add-on controls
        var itemLists = document.getElementById('itemLists');
        if (itemLists) {
          itemLists.style.pointerEvents = 'none';
          itemLists.style.opacity = '0.5';
        }
      }

      function expireOnServer() {
        var csrfToken = document.querySelector('meta[name="csrf-token"]');
        fetch(expireUrl, {
          method: 'POST',
          headers: {
            'X-CSRF-Token': csrfToken ? csrfToken.content : '',
            'Content-Type': 'application/json'
          }
        }).catch(function() {});
      }

      function updateTimer() {
        var minutes = Math.floor(secondsLeft / 60);
        var seconds = secondsLeft % 60;

        displayEl.textContent = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');

        if (secondsLeft <= 60) {
          displayEl.style.color = '#dc3545';
          displayEl.style.animation = 'pulse 1s infinite';
        } else if (secondsLeft <= 180) {
          displayEl.style.color = '#fd7e14';
        } else {
          displayEl.style.color = '#ffc107';
        }

        if (secondsLeft <= 0 && !isExpired) {
          isExpired = true;
          clearInterval(timerInterval);
          expireOnServer();
          showExpiredState();
        }

        secondsLeft--;
      }

      updateTimer();
      var timerInterval = setInterval(updateTimer, 1000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTimer);
    } else {
      initTimer();
    }
  })();
</script>

<style>
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
</style>
<% end %>

<% unless user_signed_in? %>
<script>
  (function() {
    function initLoginForm() {
      var form = document.getElementById('ajax-login-form');
      if (!form) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var errorEl = document.getElementById('login-error');
        if (errorEl) {
          errorEl.style.display = 'none';
          errorEl.textContent = '';
        }

        // Get form data
        var formData = new FormData(form);
        var urlEncodedData = new URLSearchParams(formData).toString();

        // Make AJAX request
        fetch('<%= ajax_login_path %>', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: urlEncodedData
        })
        .then(function(response) {
          return response.json().then(function(data) {
            return { ok: response.ok, data: data };
          });
        })
        .then(function(result) {
          if (result.ok && result.data.success) {
            location.reload();
          } else {
            var msg = result.data.message || 'Invalid email or password.';
            if (errorEl) {
              errorEl.textContent = msg;
              errorEl.style.display = 'block';
            }
          }
        })
        .catch(function(error) {
          if (errorEl) {
            errorEl.textContent = 'An error occurred. Please try again.';
            errorEl.style.display = 'block';
          }
        });
      });
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLoginForm);
    } else {
      initLoginForm();
    }
  })();
</script>
<% end %>
