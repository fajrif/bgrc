<% status_class, status_text =
     if @booking.is_unpaid? then ["", "AWAITING PAYMENT"]
     elsif @booking.status == Booking::PAID then ["is-paid", "PAID ✓"]
     elsif @booking.expired? then ["is-expired", "EXPIRED"]
     else ["is-expired", "CANCELLED"] end %>
<div id="payment-status-badge" class="bbcc-status-bar <%= status_class %>">
  <small>STATUS: <%= status_text %></small>
</div>

<ul class="bbcc-confirm-lines">
  <li><span><%= @booking.get_court_type %></span><span><%= @booking.price_label %></span></li>
  <% if @booking.pax && !@booking.group_class %>
    <li><span>Pax</span><span><%= @booking.pax %></span></li>
  <% end %>
  <% if @booking.group_class %>
    <li><span>Class Name</span><span><%= @booking.group_class.name_with_pax(@booking.pax) %></span></li>
  <% end %>
  <% if @booking.coach %>
    <li><span>Coach (<%= @booking.coach.name %>)</span><span><%= @booking.price_coach_label %></span></li>
  <% end %>
  <% @booking.add_ons.each do |add_on| %>
    <li><span><%= add_on.item_with_quantity %></span><span><%= add_on.total_price_label %></span></li>
  <% end %>
  <li class="is-total"><span>Total</span><span><%= @booking.total_price_label %></span></li>
</ul>

<% if @booking.is_unpaid? %>
  <% if @available_credit %>
    <div class="bbcc-credit-note">
      <strong><%= @available_credit.sessions_remaining %> session credit(s) available</strong>
      for <%= @booking.group_class.name %>
      <small>Expires <%= @available_credit.expires_at.strftime('%d %b %Y') %></small>
    </div>
    <%= button_to "Use 1 Session Credit", pay_with_credit_booking_path(@booking.order_id),
          method: :post, class: "bbcc-btn bbcc-btn-block",
          data: { confirm: "Use 1 session credit for this booking?" } %>
    <p class="bbcc-confirm-or">— or pay with gateway below —</p>
  <% end %>
  <div id="payment-actions" class="bbcc-confirm-actions">
    <%= link_to "Cancel", booking_path(@booking.order_id), class: "bbcc-btn bbcc-btn-light", method: :delete %>
    <% if user_signed_in? %>
      <a href="#" class="bbcc-btn" data-bs-toggle="modal" data-bs-target="#disclaimerModal">Pay Now</a>
    <% else %>
      <a href="#" class="bbcc-btn" data-bs-toggle="modal" data-bs-target="#loginModal">Pay Now</a>
    <% end %>
  </div>
  <div id="expired-actions" class="bbcc-confirm-end" hidden>
    <p>The time limit for payment has expired.</p>
    <%= link_to "Search Again", search_path(sport_id: @booking.court.sport_id), class: "bbcc-btn bbcc-btn-light" %>
  </div>
<% elsif @booking.expired? %>
  <div class="bbcc-confirm-end">
    <p>The time limit for payment has expired.</p>
    <%= link_to "Search Again", search_path(sport_id: @booking.court.sport_id), class: "bbcc-btn bbcc-btn-light" %>
  </div>
<% elsif @booking.cancelled? %>
  <div class="bbcc-confirm-end">
    <p>This booking has been cancelled.</p>
    <%= link_to "Search Again", search_path(sport_id: @booking.court.sport_id), class: "bbcc-btn bbcc-btn-light" %>
  </div>
<% else %>
  <%# A paid booking is redirected to My Bookings by BookingsController#show, where the e-ticket
      and QR live. This branch is only reachable by someone who is not the owner. %>
  <div class="bbcc-confirm-end">
    <p>This booking is confirmed.</p>
    <%= link_to "View in My Bookings", users_bookings_path(booking: @booking.order_id), class: "bbcc-btn" %>
  </div>
<% end %>
