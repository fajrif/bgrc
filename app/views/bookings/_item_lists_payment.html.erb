<!-- Payment Status Badge -->
<% if @booking.is_unpaid? %>
  <div id="payment-status-badge" class="mb-3 p-2 text-center" style="background-color: #fff3cd; border-radius: 6px; border: 1px solid #ffc107;">
    <small style="color: #856404; font-weight: 600;">
      STATUS: AWAITING PAYMENT
    </small>
  </div>
<% elsif @booking.status == Booking::PAID %>
  <div class="mb-3 p-2 text-center" style="background-color: #d4edda; border-radius: 6px; border: 1px solid #28a745;">
    <small style="color: #155724; font-weight: 600;">STATUS: PAID ✓</small>
  </div>
<% elsif @booking.expired? %>
  <div class="mb-3 p-2 text-center" style="background-color: #f8d7da; border-radius: 6px; border: 1px solid #dc3545;">
    <small style="color: #721c24; font-weight: 600;">STATUS: EXPIRED</small>
  </div>
<% end %>

<ul class="list-style-6 margin-50px-bottom text-medium">
  <li><strong><%= @booking.get_court_type %></strong><span><%= @booking.price_label %></span></li>
  <% if @booking.pax && !@booking.group_class %>
  <li><strong>Pax</strong><span><%= @booking.pax %></span></li>
  <% end %>
  <% if @booking.group_class %>
  <li><strong>Class Name</strong><span class="text-small"><%= @booking.group_class.name_with_pax(@booking.pax) %></span></li>
  <% end %>
  <% if @booking.coach %>
    <li><strong>Coach (<%= @booking.coach.name %>)</strong><span><%= @booking.price_coach_label %></strong></li>
  <% end %>
  <% @booking.add_ons.each do |add_on| %>
    <li><strong><%= add_on.item_with_quantity %></strong><span><%= add_on.total_price_label %></span></li>
  <% end %>
  <li class="margin-30px-top font-weight-700"><strong>Total</strong><span><%= @booking.total_price_label %></strong></li>
</ul>
<div class="d-flex flex-wrap justify-content-center gap-4">
  <% if @booking.is_unpaid? %>
    <% if @available_credit %>
      <div class="alert alert-info mb-3">
        <strong><%= @available_credit.sessions_remaining %> session credit(s) available</strong>
        for <%= @booking.group_class.name %>
        <small class="text-muted d-block">Expires <%= @available_credit.expires_at.strftime('%d %b %Y') %></small>
      </div>
      <%= button_to "Use 1 Session Credit", pay_with_credit_booking_path(@booking.order_id),
            method: :post, class: "btn btn-success w-100 mb-2",
            data: { confirm: "Use 1 session credit for this booking?" } %>
      <p class="text-center text-muted small mb-3">— or pay with gateway below —</p>
    <% end %>
    <div id="payment-actions">
      <%= link_to "Cancel", booking_path(@booking.order_id), class: "btn btn-light-gray btn-small text-medium", method: :delete %>
      <% if user_signed_in? %>
        <a href="#" class="btn btn-dark-gray btn-medium text-medium" data-bs-toggle="modal" data-bs-target="#disclaimerModal">Pay</a>
      <% else %>
        <a href="#" class="btn btn-dark-gray btn-medium text-medium" data-bs-toggle="modal" data-bs-target="#loginModal">Pay</a>
      <% end %>
    </div>
    <div id="expired-actions" style="display: none;">
      <div class="text-center w-100">
        <p class="text-medium mb-2" style="color: #dc3545;"><strong>The time limit for payment has expired.</strong></p>
        <%= link_to "Search Again", search_path(sport_id: @booking.court.sport_id), class: "btn btn-light-gray btn-small text-medium" %>
      </div>
    </div>
  <% elsif @booking.expired? %>
    <div class="text-center w-100">
      <p class="text-medium mb-2" style="color: #dc3545;"><strong>The time limit for payment has expired.</strong></p>
      <%= link_to "Search Again", search_path(sport_id: @booking.court.sport_id), class: "btn btn-light-gray btn-small text-medium" %>
    </div>
  <% elsif @booking.cancelled? %>
    <div class="text-center w-100">
      <p class="text-medium mb-2" style="color: #6c757d;"><strong>This booking has been cancelled.</strong></p>
      <%= link_to "Search Again", search_path(sport_id: @booking.court.sport_id), class: "btn btn-light-gray btn-small text-medium" %>
    </div>
  <% else %>
    <%= link_to "View Details", "#modal-popup", class: "btn btn-light-gray btn-small text-medium modal-popup" %>
    <%= render "bookings/modal_details" %>
    <%= link_to "Invoice", invoice_booking_path(@booking.order_id), class: "btn btn-info btn-small text-medium" %>
  <% end %>
</div>
