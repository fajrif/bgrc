<% if @booking.within_payment_window? %>
  <p class="bbcc-confirm-addons-label">Add ons:</p>
  <ul class="bbcc-addon-list">
    <% Item.all.each do |item| %>
      <% add_on = @booking.add_ons.find_by(item_id: item.id) %>
      <li class="bbcc-addon-row">
        <label class="bbcc-check" for="item_<%= item.id %>">
          <%= check_box_tag "item_#{item.id}", item.id, add_on.present?, {
            onchange: "$(this).data('params', 'selected=' + this.checked)",
            data: { url: add_on_booking_url(@booking.order_id, item.id), remote: true, method: :patch }
          } %>
          <span class="bbcc-check-box" aria-hidden="true"></span>
          <span><%= item.name %> <small>(<%= item.price_label %>)</small></span>
        </label>
        <% if add_on %>
          <span class="bbcc-qty bbcc-qty-small">
            <%= link_to "−", remove_quantity_booking_path(@booking.order_id, add_on), class: "bbcc-qty-btn", method: :patch, remote: true, "aria-label": "Fewer #{item.name}" %>
            <span class="bbcc-qty-value"><%= add_on.quantity %></span>
            <%= link_to "+", add_quantity_booking_path(@booking.order_id, add_on), class: "bbcc-qty-btn", method: :patch, remote: true, "aria-label": "More #{item.name}" %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% elsif @booking.payment_window_expired? || @booking.expired? %>
  <ul class="bbcc-confirm-facts">
    <li>Booked by: <%= @booking.try(:user).try(:full_name) %></li>
    <li>Email: <%= @booking.try(:user).try(:email) %></li>
    <li>Phone: <%= @booking.try(:user).try(:phone) %></li>
    <li>Status Payment: EXPIRED</li>
  </ul>
<% elsif !@booking.is_unpaid? && @booking.user %>
  <ul class="bbcc-confirm-facts">
    <li>Booked by: <%= @booking.try(:user).try(:full_name) %></li>
    <li>Email: <%= @booking.try(:user).try(:email) %></li>
    <li>Phone: <%= @booking.try(:user).try(:phone) %></li>
    <li>Status Payment: PAID</li>
  </ul>
<% end %>
