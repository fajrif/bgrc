<%= render "shared/breadcrumb", crumbs: [{ label: "Class Credits", path: users_class_credits_path }, { label: @group_class.name }] %>

<!-- start book session -->
<section class="bbcc-section bbcc-hub">
  <div class="container-lg">
    <div class="bbcc-schedule-head">
      <div>
        <h1 class="bbcc-hub-heading bbcc-schedule-title">Book Session &mdash; <%= @group_class.name %></h1>
        <p class="bbcc-schedule-range">
          <%= @credit_purchase.sessions_remaining %> session(s) remaining &middot; Order <%= @credit_purchase.order_id %>
        </p>
      </div>
      <%= link_to "&larr; Back to Class Credits".html_safe, users_class_credits_path, class: "bbcc-link" %>
    </div>

    <% if ClassSessionClaim.courts_for(@group_class).exists? %>
      <%# Court, week calendar, coach and the claim (app/frontend/components/classes). FullCalendar v6 injects its own CSS. %>
      <%= vue_component "ClassSessionClaimApp", class_session_claim_props(@credit_purchase) do %>
        <p class="bbcc-booking-hint">Loading the booking calendar&hellip;</p>
      <% end %>
    <% else %>
      <div class="bbcc-table-empty">
        <p>No court is set up for this class yet.</p>
        <%= link_to "Contact Us", get_contact_path, class: "bbcc-btn" %>
      </div>
    <% end %>
  </div>
</section>
<!-- end book session -->
