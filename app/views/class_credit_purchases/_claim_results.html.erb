<div class="container">
  <div class="row align-items-start">
    <div class="col-lg-8 col-md-8 text-center text-md-start padding-three-lr">
      <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
          <h6 class="text-large text-black mb-2"><%= @court.name_label %></h6>
          <p class="text-medium text-black mb-0"><%= @displayDate %></p>
        </div>
        <div class="d-flex gap-2">
          <%= select_tag :court_type_id,
                options_from_collection_for_select(@court_types, "id", "name", @court_type.id),
                class: "form-select mb-0", include_blank: false,
                data: { remote: true, url: book_session_class_credit_purchase_path(@credit_purchase, date: @date), method: :get } %>
          <%= select_tag :court_id,
                options_from_collection_for_select(@courts, "id", "name", @court.id),
                class: "form-select mb-0", prompt: 'Select Court',
                data: { remote: true, url: book_session_class_credit_purchase_path(@credit_purchase, date: @date, court_type_id: @court_type.id), method: :get } %>
        </div>
      </div>

      <div class="pricing-area" id="schedule">
        <div class="d-flex flex-wrap gap-3 mb-3 small align-items-center">
          <div class="d-flex align-items-center gap-1">
            <span style="display:inline-block;width:14px;height:14px;background:#ECFEED;border:1.5px solid #5BF651;border-radius:2px;flex-shrink:0;"></span>
            <span class="text-muted">Your Selection</span>
          </div>
          <div class="d-flex align-items-center gap-1">
            <span style="display:inline-block;width:14px;height:14px;background:#FFEBF2;border:1.5px solid #FF85AF;border-radius:2px;flex-shrink:0;"></span>
            <span class="text-muted">Booked</span>
          </div>
          <div class="d-flex align-items-center gap-1">
            <span style="display:inline-block;width:14px;height:14px;background:rgba(108,117,125,1);border:1.5px solid rgba(84,91,98,1);border-radius:2px;flex-shrink:0;"></span>
            <span class="text-muted">Blocked Event</span>
          </div>
        </div>
        <div id="claim-calendar"></div>
      </div>
    </div>

    <div class="col-lg-4 col-md-4 text-center text-md-start padding-three-lr">
      <%= form_tag claim_session_class_credit_purchase_path(@credit_purchase), method: :post, id: "claim-form" do %>
        <div class="ms-4">
          <h6 class="text-large text-black mb-3">Your Booking Details</h6>
          <p class="text-muted small mt-2 mb-0">Click on a time slot to select your session.</p>

          <input type="hidden" name="court_id" id="claim-input-court-id" value="<%= @court.id %>">
          <input type="hidden" name="dates"    id="claim-input-date" value="">

          <table class="table table-borderless mb-3">
            <tr>
              <td class="text-muted ps-0" style="width:40%;">Group Class</td>
              <td><strong><%= @group_class.name %></strong></td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Court</td>
              <td id="claim-selected-court"><%= @court.name_label %></td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Date</td>
              <td id="claim-selected-date">—</td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Duration</td>
              <td><%= @group_class.duration_label %></td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Pax</td>
              <td><%= @group_class.min_pax %></td>
            </tr>
          </table>

          <label for="claim-input-coach-id" class="text-medium fw-bold mb-1 d-block">Select Coach</label>
          <%= select_tag :coach_id,
                options_from_collection_for_select(@coaches, "id", "name"),
                prompt: "Choose a coach", required: true,
                class: "form-select mb-3", id: "claim-input-coach-id" %>

          <button id="btnClaimSubmit" type="button" class="btn btn-dark w-100 text-uppercase letter-spacing-1 text-extra-small text-white disabled" disabled
                  data-bs-toggle="modal" data-bs-target="#claimDisclaimerModal">
            Submit
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render "claim_disclaimer_modal" %>
