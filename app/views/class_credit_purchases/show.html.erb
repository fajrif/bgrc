<% if @credit_purchase.is_unpaid? %>
  <%= content_for :head do %>
    <%= gateway_checkout_script_tag %>
  <% end %>
<% end %>

<section class="half-section top-space">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="border padding-40px-all text-center">
                    <h5 class="alt-font font-weight-600 text-uppercase mb-4">Session Credit Purchase</h5>

                    <% if @credit_purchase.paid? %>
                        <% if @credit_purchase.group_class.is_prescheduled? && @registration %>
                            <div class="alert alert-success">
                                You are registered for <strong><%= @registration.session_date.strftime('%A, %d %b %Y %H:%M') %></strong>
                                at <strong><%= @registration.court.name %></strong> (<%= @registration.pax %> pax).
                            </div>
                        <% elsif @credit_purchase.group_class.is_prescheduled? && (late = @credit_purchase.group_class_registrations.find_by(status: GroupClassRegistration::NEEDS_RESCHEDULE)) %>
                            <div class="alert alert-warning">
                                We received your payment after the payment window closed, and the session on
                                <strong><%= late.session_date.strftime('%A, %d %b %Y') %></strong> had filled up.
                                Our team will contact you to arrange another session at the same price.
                            </div>
                        <% elsif @credit_purchase.sessions_remaining > 0 %>
                            <div class="alert alert-success">
                                Your session credits are active. You have <%= @credit_purchase.sessions_remaining %> session(s) remaining.
                            </div>
                        <% else %>
                            <div class="alert alert-secondary">
                                You have used all your session credits.
                            </div>
                        <% end %>
                    <% end %>

                    <table class="table table-borderless text-start mb-4">
                        <tr>
                            <td class="text-muted">Order ID</td>
                            <td class="fw-semibold"><%= @credit_purchase.order_id %></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Class</td>
                            <td><%= @credit_purchase.group_class.name %></td>
                        </tr>
                        <% if @credit_purchase.group_class.is_prescheduled? && @registration %>
                        <tr>
                            <td class="text-muted">Session Date</td>
                            <td><%= @registration.session_date.strftime('%A, %d %b %Y %H:%M') %></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Court</td>
                            <td><%= @registration.court.name %></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Pax</td>
                            <td><%= @registration.pax %></td>
                        </tr>
                        <% else %>
                        <tr>
                            <td class="text-muted">Sessions Purchased</td>
                            <td><%= @credit_purchase.sessions_count %> session(s)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Sessions Remaining</td>
                            <td><%= @credit_purchase.sessions_remaining %></td>
                        </tr>
                        <% end %>
                        <tr>
                            <td class="text-muted">Total Price</td>
                            <td class="fw-semibold"><%= @credit_purchase.price_label %></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Status</td>
                            <td>
                                <% badge = if @credit_purchase.paid? then "bg-success" elsif @credit_purchase.is_unpaid? then "bg-warning" else "bg-secondary" end %>
                                <span class="badge <%= badge %>"><%= @credit_purchase.status_label %></span>
                            </td>
                        </tr>
                        <% if @credit_purchase.expires_at && !@credit_purchase.group_class.is_prescheduled? %>
                        <tr>
                            <td class="text-muted">Credits Valid Until</td>
                            <td class="text-muted small"><strong><%= @credit_purchase.expires_at.strftime('%d %b %Y') %></strong></td>
                        </tr>
                        <% end %>
                    </table>

                    <% if @credit_purchase.is_unpaid? %>
                        <%= payment_panel(@credit_purchase,
                                          cancel_path: (users_class_credit_path(id: @credit_purchase.id) if user_signed_in?),
                                          back_path: group_class_path(id: @credit_purchase.group_class_id),
                                          back_label: "Back to the Class") %>
                    <% elsif !@credit_purchase.paid? %>
                        <p class="text-medium mb-3"><strong>The time limit for payment has expired.</strong></p>
                        <%= link_to "Back to the Class", group_class_path(id: @credit_purchase.group_class_id), class: "btn btn-dark text-white w-100 mb-2" %>
                    <% elsif @credit_purchase.sessions_remaining > 0 && !@credit_purchase.group_class.is_prescheduled? %>
                        <%= link_to "Book a Session", book_session_class_credit_purchase_path(@credit_purchase),
                              class: "btn btn-dark text-white w-100 mb-2" %>
                    <% elsif @reschedulable_bookings.any? %>
                        <% @reschedulable_bookings.each do |booking| %>
                            <%= button_to "Reschedule — #{booking.date.strftime('%d %b %Y %H:%M')}",
                                  return_credit_users_booking_path(booking),
                                  method: :post,
                                  class: "btn btn-outline-warning w-100 mb-2",
                                  data: { confirm: "Cancel this session and return the credit? You can book a different date." } %>
                            <p class="text-extra-small text-muted mb-2">
                              Reschedule window until <%= (booking.created_at + 24.hours).strftime('%d %b %H:%M') %>
                            </p>
                        <% end %>
                    <% end %>

                    <% if @credit_purchase.paid? %>
                        <%= link_to "Back", users_class_credits_path, class: "btn btn-light mt-2 w-100" %>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</section>
