$("#claimResults").html("<%= escape_javascript(render('claim_results')) %>");
<%
  new_params = request.query_parameters.merge(court_type_id: params[:court_type_id], court_id: params[:court_id])
  query_string = new_params.to_query
%>
history.replaceState(null, "", "<%= request.path %>?<%== query_string %>");

var claimCalendar;

function createClaimEvent(arg, calendar) {
  var startDay = moment(arg.start);
  var endDay   = moment(arg.end);

  var event = calendar.getEventById('claim1');
  if (event) event.remove();

  calendar.addEvent({
    id: 'claim1',
    title: 'Your Selection',
    start: arg.start,
    end:   arg.end,
    textColor: '#097B0A',
    borderColor: '#5BF651',
    color: '#ECFEED'
  });

  var formatDates = startDay.format('DD/MM/YYYY HH:mm');
  $('#claim-input-date').val(formatDates);
  $('#claim-selected-date').text(startDay.format('ddd DD MMM YYYY · HH:mm'));
  $('#claim-selected-court').text('<%= j @court.name_label %>');
  $('#btnClaimSubmit').prop("disabled", false).removeClass("disabled");

  calendar.unselect();
}

function isClaimDuration(arg) {
  var diffHrs = (arg.end - arg.start) / (1000 * 60 * 60);
  return diffHrs === <%= @group_class.min_duration %>;
}

var calendarEl = document.getElementById('claim-calendar');

claimCalendar = new FullCalendar.Calendar(calendarEl, {
  headerToolbar: false,
  initialView: 'timeGridWeek',
  initialDate: '<%= @date %>',
  firstDay: moment('<%= @date %>').day(),
  navLinks: false,
  selectable: true,
  selectAllow: function(arg) { return isClaimDuration(arg); },
  validRange: {
    start: moment('<%= @date %>').format('YYYY-MM-DD'),
    end:   moment('<%= @date %>').add(7, 'days').format('YYYY-MM-DD')
  },
  eventLongPressDelay: 10,
  eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
  selectMirror: true,
  allDaySlot: false,
  selectOverlap: false,
  eventOverlap: false,
  slotDuration: '01:00',
  slotMinTime: '<%= @court.get_min_open_time %>',
  slotMaxTime: '<%= @court.get_max_open_time %>',
  select: function(arg) { createClaimEvent(arg, claimCalendar); },
  eventChange: function(changeInfo) {
    if (isClaimDuration(changeInfo.event) && changeInfo.event.title == changeInfo.oldEvent.title) {
      createClaimEvent(changeInfo.event, claimCalendar);
    } else {
      changeInfo.revert();
    }
  },
  eventClick: function(arg) {
    if (arg.event.id == 'claim1') {
      arg.event.remove();
      $('#btnClaimSubmit').prop("disabled", true).addClass("disabled");
      $('#claim-input-date').val('');
      $('#claim-selected-date').text('—');
    } else if (arg.event.extendedProps.signUpUrl) {
      arg.jsEvent.preventDefault();
      window.open(arg.event.extendedProps.signUpUrl, '_blank');
    } else if (arg.event.extendedProps.classUrl) {
      arg.jsEvent.preventDefault();
      window.location.href = arg.event.extendedProps.classUrl;
    }
  },
  editable: true,
  dayMaxEvents: false,
  eventBackgroundColor: '#FFEBF2',
  eventBorderColor: '#FF85AF',
  eventTextColor: '#FF85AF',
  selectConstraint: 'businessHours',
  eventConstraint: 'businessHours',
  businessHours: <%= @business_hours.html_safe %>,
  events: <%= @events.html_safe %>
});

claimCalendar.setOption('height', 'auto');
claimCalendar.render();
