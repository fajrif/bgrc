<%= form_tag search_url, { :id => "search_form", :method => :get } do %>
  <div class="row">
    <div class="col-lg-5 d-flex align-items-center">
      <%= text_field_tag :date, @selectedDate.try(:strftime, "%d/%m/%Y") || '', :placeholder => "Select Date", :class => "datecourtpicker form-control mb-0" %>
    </div>
    <div class="col-lg-5 d-flex align-items-center">
      <%= select_tag :court_type, options_for_select(options_select_court, @type), class: "form-select mb-0", prompt: 'Select Court', data: { remote: true, url: search_selection_path(sport_id: sport.id), method: :get } %>
    </div>
    <div class="col-lg-2 text-center">
      <%= hidden_field_tag 'sport_id', sport.id %>
      <%= hidden_field_tag :pax, @pax, id: "search_pax" %>
      <button type="submit" class="btn btn-light-gray text-small">Search</button>
    </div>
  </div>
  <div id="search_inner_section_<%= sport.name.downcase %>">
    <%= render "search/selection_panel" %>
  </div>
<% end %>
