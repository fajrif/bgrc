<!-- start banner section -->
<section class="wow animate__fadeIn cover-background background-position-top top-space overflow-visible" style="background-image:url('<%= image_url('banners/banner-sample.png') %>');">
    <div class="container position-relative">
      <div class="row justify-content-center align-items-center parallax-feature-box-bottom z-index-5 w-100 left-0 m-0">
          <div class="col-12 col-lg-7 text-center text-md-start box-shadow-light position-relative bg-white padding-three-all">
            <div class="row justify-content-center">
              <div class="col-12 text-center tab-style3" id="animated-tab1">
                <ul class="nav nav-tabs margin-30px-bottom text-uppercase alt-font text-small font-weight-600 justify-content-center flex-column flex-md-row">
                  <% Sport.all.each_with_index do |sport, index| %>
                    <% if @sport %>
                      <li class="nav-item"><a href="#tab3_sec<%= sport.id %>" data-bs-toggle="tab" class="nav-link text-medium-gray <%= 'active' if @sport.id == sport.id %>"><%= sport.name %></a></li>
                    <% else %>
                      <li class="nav-item"><a href="#tab3_sec<%= sport.id %>" data-bs-toggle="tab" class="nav-link text-medium-gray <%= 'active' if index == 0 %>"><%= sport.name %></a></li>
                    <% end %>
                  <% end %>
                </ul>
              </div>
            </div>
            <div class="tab-content">
              <% Sport.all.each_with_index do |sport, index| %>
                <% if @sport %>
                <div id="tab3_sec<%= sport.id %>" class="tab-pane fade in <%= 'active show' if @sport.id == sport.id %>">
                <% else %>
                <div id="tab3_sec<%= sport.id %>" class="tab-pane fade in <%= 'active show' if index == 0 %>">
                <% end %>
                  <%= render "search/search_form_#{sport.name.downcase}" %>
                </div>
              <% end %>
            </div>
          </div>
      </div>
    </div>
</section>
<!-- end banner section -->
