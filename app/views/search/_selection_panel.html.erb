<% if @type == "court_only" || @type == "0" || @type.blank? %>
<%# --- COURT ONLY: simple pax selector --- %>
<div class="row mt-2">
  <div class="col-lg-5 d-flex align-items-center">
    <%= select_tag :pax, options_for_select(options_select_pax_simple, @pax.try(:to_i)), :class => "form-select mb-0", :include_blank => false, id: "court_pax_select", data: { remote: true, url: search_selection_path(court_type: @type, sport_id: @sport&.id), method: :get } %>
  </div>
</div>

<% elsif @group_class&.is_prescheduled? %>
<%# --- PRESCHEDULED CLASS: session picker + pack selector --- %>
<%= render "search/prescheduled_class_panel" %>

<% elsif helpers.court_type_is_class?(@type) %>
<%# --- CLASS CATEGORY: show class name dropdown + pax --- %>
<div class="row mt-2">
  <div class="col-lg-5 d-flex align-items-center">
    <% group_classes_list = @groups_for_category || GroupClass.available.by_category(@type) %>
    <%= select_tag :group_class_id,
          options_from_collection_for_select(group_classes_list, "id", "name_label", @group_class.try(:id)),
          :class => "form-select mb-0",
          :prompt => 'Select Class',
          data: { remote: true, url: search_selection_path(court_type: @type, sport_id: @sport&.id), method: :get } %>
  </div>
  <div class="col-lg-5 d-flex align-items-center">
    <% if @group_class && @group_class.pax_managed? %>
      <%= select_tag :pax, options_for_select(options_select_pax(@group_class.min_pax, @group_class.max_pax, @group_class.has_additional_pax?), @pax), :class => "form-select mb-0", :include_blank => false, data: { remote: true, url: search_selection_path(court_type: @type, sport_id: @sport&.id, group_class_id: @group_class.id), method: :get } %>
    <% end %>
  </div>
</div>
<% if @type == "private_lesson" && @group_class %>
  <div class="row mt-2">
    <div class="col-lg-5 d-flex align-items-center">
      <%= select_tag :coach_id,
            options_from_collection_for_select(@coaches || [], "id", "name_with_price", params[:coach_id]),
            class: "form-select mb-0", include_blank: "Select Coach (optional)",
            id: "court_coach_select" %>
    </div>
  </div>
<% end %>

<% if @group_class && @group_class.pax_managed? %>
  <div class="row mt-2">
    <div class="col-lg-12 d-flex align-items-center">
      <div class="padding-10px-all">
        <p class="fs-6 line-height-normal font-weight-600 mb-1">Price: <%= @group_class.check_price(@pax) %></p>
        <% if @group_class.has_additional_pax? %>
          <p class="fs-6 line-height-normal mb-1"><strong>Additional Pax:</strong> <%= @group_class.price_pax_label %></p>
        <% end %>
        <i class="text-small">Maximum <%= @group_class.max_pax %> Pax for <%= @group_class.duration_label %></i><br/>
        <i class="text-small">** <%= @group_class.notes %></i>
      </div>
    </div>
  </div>
<% end %>

<% end %>
