<%= content_for :head do %>
	<%= stylesheet_link_tag "main.css" %>
<% end %>

<%= render "banner" %>
<div id="searchResults">
  <%= render "search_results" if @court %>
</div>
<%= render "info" %>

<%= content_for :tail do %>
	<%= javascript_include_tag "fullcalendar.js" %>
	<%= javascript_include_tag "moment-with-locales.min.js" %>
	<%= stylesheet_link_tag "fullcalendar-custom.css" %>
	<script>
	var calendar;
  document.addEventListener('DOMContentLoaded', function() {

    var calendarEl = document.getElementById('calendar');

    calendar = new FullCalendar.Calendar(calendarEl, {
      headerToolbar: false,
			initialView: 'timeGridWeek',
			initialDate: '<%= @date %>',
			firstDay: moment('<%= @date %>').day(),
      navLinks: false, // can click day/week names to navigate views
      selectable: true,
			selectAllow: function(arg) {
				return isCrossDay(arg) && arg.start >= new Date();
			},
			validRange: {
				start: moment('<%= @date %>').format('YYYY-MM-DD'),
				end: moment('<%= @date %>').add(7, 'days').format('YYYY-MM-DD')
			},
			eventLongPressDelay: 10,
			eventTimeFormat: {
				hour: '2-digit',
				minute: '2-digit',
				hour12: false
			},
      selectMirror: true,
      allDaySlot: false,
      selectOverlap: false,
      eventOverlap: false,
			slotDuration: '01:00',
			slotMinTime: '<%= @court.get_min_open_time %>',
      slotMaxTime: '<%= @court.get_max_open_time %>',
      select: function(arg) {
				createEvent(arg, calendar);
      },
      eventChange: function(changeInfo) {
				if(isCrossDay(changeInfo.event) && changeInfo.event.start >= new Date()) {
					if(changeInfo.event.title == changeInfo.oldEvent.title) {
						createEvent(changeInfo.event, calendar);
					}
				} else {
					changeInfo.revert();
				}
      },
      eventDidMount: function(arg) {
        if (arg.event.extendedProps.signUpUrl) {
          var hint = document.createElement('span');
          hint.className = 'fc-signup-hint';
          hint.textContent = 'Sign Up';
          arg.el.querySelector('.fc-event-title') && arg.el.querySelector('.fc-event-title').appendChild(hint);
        }
      },
      eventClick: function(arg) {
				if(arg.event.id == 'book1') {
					arg.event.remove();
					$('#btnSubmit').prop("disabled", true);
					$('#btnSubmit').addClass("disabled");
					$('#input-book').val('');
					$('#input-duration').val('');
          $('#calculate_table').html("<%= escape_javascript(render('calculate_info')) %>");
				} else if(arg.event.extendedProps.signUpUrl) {
          arg.jsEvent.preventDefault();
          window.open(arg.event.extendedProps.signUpUrl, '_blank');
        } else if(arg.event.extendedProps.classUrl) {
          arg.jsEvent.preventDefault();
          window.location.href = arg.event.extendedProps.classUrl;
        }
      },
      editable: true,
      dayMaxEvents: false, // allow "more" link when too many events
			eventBackgroundColor: '#FFEBF2',
			eventBorderColor: '#FF85AF',
			eventTextColor: '#FF85AF',
			selectConstraint: 'businessHours',
			eventConstraint: 'businessHours',
			businessHours: <%= @business_hours.html_safe %>,
      events: <%= @events.html_safe %>,
    });

		calendar.setOption('height', 'auto');
    calendar.render();
  });

	function createEvent(arg, calendar) {
			var startDay = moment(arg.start, "YYYY-MM-DD");
			var endDay = moment(arg.end, "YYYY-MM-DD");
			var duration = endDay.diff(startDay, 'hours');

			var event = calendar.getEventById('book1');
			if(event) {
				event.remove();
			}

			calendar.addEvent({
				id: 'book1',
				title: 'Check price',
				start: arg.start,
				end: arg.end,
				textColor: '#097B0A',
				borderColor: '#5BF651',
				color: '#ECFEED'
			});

			var formatDates = startDay.format('DD/MM/YYYY HH:mm');

			var coachId = $('#court_coach_select').length ? $('#court_coach_select').val() : "";
			$('#input-coach-id').val(coachId);

			$.ajax({
				type: "GET",
				url: "/courts/<%= @court.id %>/calculate_price",
        <%- if @group_class -%>
        data: {dates: formatDates, duration: duration, court_type: <%= blank_or_not(@type, 0) %>, group_class_id: <%= @group_class.try(:id) %>, pax: <%= @pax %>, coach_id: coachId },
        <%- else -%>
        data: {dates: formatDates, duration: duration, court_type: <%= blank_or_not(@type, 0) %>, pax: ($('#court_pax_select').length ? $('#court_pax_select').val() : ""), coach_id: coachId },
        <%- end -%>
				success: function(data, textStatus, jqXHR){
					// console.log(textStatus);
					$('#input-book').val(formatDates);
					$('#input-duration').val(duration);
				},
				error: function(jqXHR, textStatus, errorThrown){
					console.log(textStatus);
				}
			});

			calendar.unselect();
	}

	function isCrossDay(arg) {
    <%- if @group_class -%>
    var start = arg.start
    var end = arg.end
    var diffInMs = end - start
    var diffInHours = diffInMs / (1000 * 60 * 60)
    return diffInHours === <%= @group_class.min_duration %>
    <%- else -%>
		var startDay = moment(arg.start, "YYYY-MM-DD");
		var endDay = moment(arg.end, "YYYY-MM-DD");
		return startDay.diff(endDay, 'days') == 0;
    <%- end -%>
	}
	</script>
<% end if @court %>
