<%= content_for :head do %>
	<%# main.css is FullCalendar's core stylesheet %>
	<%= stylesheet_link_tag "main.css" %>
<% end %>

<%= render "shared/breadcrumb", crumbs: [{ label: "Book", path: book_path }, { label: "Racquet Sports" }] %>

<!-- start booking hub — racquet sports -->
<section class="bbcc-section bbcc-hub">
	<div class="container-lg">
		<%= render "shared/booking_hub_tabs", active: @sport.slug.to_sym %>

		<div id="searchResults">
			<%= render "search_results" %>
		</div>
	</div>
</section>
<!-- end booking hub -->

<%= render "info" %>
<%= content_for :tail do %>
	<%= javascript_include_tag "fullcalendar.js" %>
	<%= javascript_include_tag "moment-with-locales.min.js" %>
	<%= stylesheet_link_tag "fullcalendar-custom.css" %>
<% end %>
