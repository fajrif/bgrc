<%= content_for :head do %>
	<%# The add-on quantity steppers reuse the ERB stepper's styles; FullCalendar v6 injects its own CSS. %>
	<%= stylesheet_link_tag "quantity_input.css" %>
<% end %>

<%= render "shared/breadcrumb", crumbs: [{ label: "Book", path: book_path }, { label: "Racquet Sports" }] %>

<!-- start booking hub — racquet sports -->
<section class="bbcc-section bbcc-hub">
	<div class="container-lg">
		<%= render "shared/booking_hub_tabs", active: @sport.slug.to_sym %>

		<div id="searchResults">
			<% if @sport.courts.any? %>
				<%= vue_component "CourtBookingApp",
				                  court_booking_props(sport: @sport, court_types: @court_types, court_type: @court_type,
				                                      court: @court, date: @date) do %>
					<h1 class="bbcc-hub-heading bbcc-schedule-title"><%= @sport.name %></h1>
					<p class="bbcc-booking-hint">Loading the booking calendar&hellip;</p>
				<% end %>
			<% else %>
				<h1 class="bbcc-hub-heading bbcc-schedule-title"><%= @sport.name %></h1>
				<div class="bbcc-table-empty">
					<p>Sorry, there are no courts available for this category yet.</p>
					<%= link_to "Explore Club Life", club_life_path, class: "bbcc-btn" %>
				</div>
			<% end %>
		</div>
	</div>
</section>
<!-- end booking hub -->

<%= render "info" %>
