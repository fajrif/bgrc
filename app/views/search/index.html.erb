<%= content_for :head do %>
	<%# main.css is FullCalendar's core stylesheet %>
	<%= stylesheet_link_tag "main.css" %>
<% end %>

<% content_for :header_light, true %>

<!-- start booking hub — racquet sports -->
<section class="bbcc-section bbcc-hub">
	<div class="container-lg">
		<%= render "shared/booking_hub_tabs", active: @sport.slug.to_sym %>

		<div id="searchResults">
			<%= render "search_results" %>
		</div>
	</div>
</section>
<!-- end booking hub -->

<%= render "info" %>
<%= render "home/social_media" %>

<%= content_for :tail do %>
	<%= javascript_include_tag "fullcalendar.js" %>
	<%= javascript_include_tag "moment-with-locales.min.js" %>
	<%= stylesheet_link_tag "fullcalendar-custom.css" %>
	<script>
	var calendar;
  document.addEventListener('DOMContentLoaded', function() {

    var calendarEl = document.getElementById('calendar');

    calendar = new FullCalendar.Calendar(calendarEl, {
      headerToolbar: false,
			initialView: 'timeGridWeek',
			initialDate: '<%= @date %>',
			now: window.bbccClubNow(),
			firstDay: moment('<%= @date %>').day(),
      navLinks: false, // can click day/week names to navigate views
			validRange: {
				start: moment('<%= @date %>').format('YYYY-MM-DD'),
				end: moment('<%= @date %>').add(7, 'days').format('YYYY-MM-DD')
			},
			eventLongPressDelay: 10,
			dayHeaderFormat: { weekday: 'short', month: 'numeric', day: 'numeric' },
			slotLabelContent: function(arg) {
				return moment(arg.date).format('HH.mm');
			},
			eventTimeFormat: {
				hour: '2-digit',
				minute: '2-digit',
				hour12: false
			},
      allDaySlot: false,
      selectOverlap: false,
      eventOverlap: false,
			slotDuration: '01:00',
			slotMinTime: '<%= @court.get_min_open_time %>',
      slotMaxTime: '<%= @court.get_max_open_time %>',
      dateClick: function(arg) {
        bbccPickSlot(arg.date);
      },
      eventDidMount: function(arg) {
        decorateEvent(arg);
      },
      eventClick: function(arg) {
				if(arg.event.extendedProps.signUpUrl) {
          arg.jsEvent.preventDefault();
          window.open(arg.event.extendedProps.signUpUrl, '_blank');
        } else if(arg.event.extendedProps.classUrl) {
          arg.jsEvent.preventDefault();
          window.location.href = arg.event.extendedProps.classUrl;
        }
      },
      editable: false,
      dayMaxEvents: false, // allow "more" link when too many events
			<%# event colours come from the --fc-* custom properties on .bbcc-schedule,
			    so per-state classes can restyle them without fighting inline styles %>
			businessHours: <%= @business_hours.html_safe %>,
      events: <%= @events.html_safe %>,
    });

		calendar.setOption('height', 'auto');
    calendar.render();

    // shade every slot before the club's current time (see bbccClubNow), refreshed each minute
    function paintPastSlots() {
      var nowStr = window.bbccClubNow();
      calendar.getEvents().forEach(function (ev) { if (ev.extendedProps.pastSlots) ev.remove(); });
      if ('<%= @date %>' <= nowStr.slice(0, 10)) {
        calendar.addEvent({
          start: '<%= @date %>T00:00:00', end: nowStr, display: 'background',
          classNames: ['bbcc-past-slot'], extendedProps: { pastSlots: true }
        });
      }
    }
    paintPastSlots();
    clearInterval(window.bbccPastTimer);
    window.bbccPastTimer = setInterval(paintPastSlots, 60000);
    
  });

	// classes and open events are bookable elsewhere, so they get a sign-up affordance
	// the players select in the booking rail drives the "Pax" line of the price summary
	$(document).on('change', '#input-pax', function() { $('.js-pax-value').text(this.value); });

	function decorateEvent(arg) {
		if (!arg.event.extendedProps.signUpUrl && !arg.event.extendedProps.classUrl) return;
		var frame = arg.el.querySelector('.fc-event-main-frame');
		if (!frame) return;
		// a one-hour block is only 52px tall, so it drops the time line
		if ((arg.event.end - arg.event.start) / 3600000 < 2) {
			arg.el.classList.add('fc-event-compact');
		}
		var hint = document.createElement('span');
		hint.className = 'fc-signup-hint';
		hint.textContent = 'Sign up';
		frame.appendChild(hint);
	}

	<%= render "search/slot_picker" %>
	</script>
<% end if @court %>
