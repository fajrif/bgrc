<%
	# Sport is now picked from the Racquet Sports hub tab flyout (see
	# shared/_booking_hub_tabs), not from a select on this page, but this form
	# still needs to keep submitting the right sport as the visitor changes
	# date/court/court-type — see the hidden field and form action below.
	sport_form_path = { "tennis" => search_tennis_path, "padel" => search_padel_path,
	                     "pickleball" => search_pickleball_path }.fetch(@sport.slug, search_path)
%>
<!-- start court schedule -->
<%# the heading and filters sit in their own row so the booking rail lines up with
    the top of the grid, as in the mockup %>
<div class="row gx-4 gx-lg-5">
	<div class="col-12 col-lg-8">
		<div class="bbcc-schedule-head">
			<div>
				<h1 class="bbcc-hub-heading bbcc-schedule-title"><%= @sport.name %></h1>
				<p class="bbcc-schedule-range"><%= @displayDate %></p>
			</div>

			<form class="bbcc-schedule-filters" action="<%= sport_form_path %>" method="get" id="court-search-form">
				<input type="hidden" name="court_type_id" id="court-search-type" value="<%= @court_type&.id %>">
				<input type="hidden" name="court_id" id="court-search-court" value="<%= @court&.id %>">
				<%# defensive fallback: sport_form_path already carries the sport via its
				    own route default, but this keeps a date change on the right sport even
				    if @sport somehow doesn't map to one of the three clean routes above %>
				<input type="hidden" name="sport_id" value="<%= @sport.id %>">
				<div class="bbcc-schedule-control bbcc-schedule-control-date">
					<input type="text" name="date" id="court-date-input" aria-label="Date"
					       value="<%= Date.parse(@date).strftime('%d/%m/%Y') %>" placeholder="Select a date" readonly>
				</div>
			</form>
		</div>

		<% if @court %>
			<div class="bbcc-schedule-bar">
				<div class="bbcc-schedule-legend">
					<span><i class="bbcc-legend-swatch bbcc-legend-selection"></i>Your Selection</span>
					<span><i class="bbcc-legend-swatch bbcc-legend-booked"></i>Booked</span>
					<span><i class="bbcc-legend-swatch bbcc-legend-blocked"></i>Blocked Event</span>
				</div>
				<div class="bbcc-schedule-filters">
					<div class="bbcc-schedule-control">
						<%= select_tag :court_type_id, options_from_collection_for_select(@court_types, "id", "name", @court_type.id),
						               include_blank: false, aria: { label: "Court type" },
						               data: { remote: true, url: search_path(date: @date, sport_id: @sport.id, pax: @pax), method: :get } %>
					</div>
					<div class="bbcc-schedule-control">
						<%= select_tag :court_id, options_from_collection_for_select(@courts, "id", "name", @court.id),
						               prompt: "Select Court", aria: { label: "Court" },
						               data: { remote: true, url: search_path(date: @date, sport_id: @sport.id, pax: @pax, court_type_id: @court_type.id), method: :get } %>
					</div>
				</div>
			</div>
		<% end %>
	</div>
</div>

<div class="row g-4 g-lg-5">
	<div class="col-12 col-lg-8">
		<% if @court %>
			<div class="bbcc-schedule" id="schedule">
				<div id="calendar"></div>
			</div>
		<% else %>
			<div class="bbcc-table-empty">
				<p>Sorry, there are no courts available for this category yet.</p>
				<%= link_to "Explore Club Life", club_life_path, class: "bbcc-btn" %>
			</div>
		<% end %>
	</div>

	<div class="col-12 col-lg-4">
		<aside class="bbcc-booking-panel">
			<h2 class="bbcc-hub-heading">Your Booking Details</h2>

			<% if @court %>
				<%= simple_form_for(:booking, url: bookings_url, method: :post) do %>
					<input type="hidden" id="court_pax_select" value="4">
					<input id="date" type="hidden" value="<%= @date %>" name="date">
					<input id="court-id" type="hidden" value="<%= @court.id %>" name="court_id">
					<input id="input-book" type="hidden" value="" name="dates">
					<input id="input-duration" type="hidden" value="" name="duration">
					<input id="input-court-type" type="hidden" value="court_only" name="court_type">
					<input id="input-pax" type="hidden" value="<%= @pax %>" name="pax">

					<div id="calculate_table">
						<%= render "calculate_info" %>
					</div>

					<button id="btnSubmit" type="submit" class="bbcc-btn disabled" disabled>Submit</button>
				<% end %>
			<% else %>
				<p class="bbcc-booking-hint">Pick a sport with available courts to start a booking.</p>
			<% end %>

			<p class="bbcc-booking-note">
				Booking window: Online bookings are available up to 14 days in advance.
				Need a booking outside regular hours or beyond 14 days?
				<br>
				<a href="https://wa.me/<%= configatron.whatsapp_number.to_s.gsub(/\D/, '') %>" target="_blank" rel="noopener">Contact us via WhatsApp</a>.
			</p>
		</aside>
	</div>
</div>
<!-- end court schedule -->

<script>
(function() {
	// runs again on every AJAX re-render of this panel, since the controls are replaced
	function init() {
		var form  = document.getElementById('court-search-form');
		var sport = document.getElementById('court-search-sport');
		var date  = document.getElementById('court-date-input');
		if (!form) return;

		if (sport) {
			sport.addEventListener('change', function() {
				// courts belong to a sport, so a sport change can't keep the current court
				document.getElementById('court-search-type').value  = '';
				document.getElementById('court-search-court').value = '';
				form.submit();
			});
		}

		if (date && window.flatpickr) {
			flatpickr(date, {
				dateFormat: 'd/m/Y',
				minDate: 'today',
				maxDate: new Date(Date.now() + 14 * 24 * 60 * 60 * 1000),
				disableMobile: true,
				onChange: function() { form.submit(); }
			});
		}
	}

	// on a full page load this runs before application.js defines flatpickr
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
})();
</script>
