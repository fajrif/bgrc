<%
  share_url = get_blog_url(@article)
  share_text = @article.title
  meta_bits = [@article.published_date&.strftime('%d %b %Y'), @category&.name, "#{@article.reading_time_minutes} min read"].compact
%>
<% content_for :header_light, true %>
<!-- start article head -->
<section class="bbcc-intro-head">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-12 col-lg-4">
                <h1 class="bbcc-title-lg bbcc-intro-title"><%= @article.title %></h1>
                <p class="bbcc-article-meta-line"><%= meta_bits.join("  |  ") %></p>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-intro-desc"><%= simple_format(@article.short_description.to_s) %></div>
            </div>
        </div>
    </div>
</section>
<!-- end article head -->

<!-- start article content -->
<section class="bbcc-page-body bbcc-article">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4">
                <% if @article.image.attached? %>
                    <%= image_tag @article.image.variant(resize_to_fill: [800, 960]), alt: @article.title, class: "bbcc-article-photo" %>
                <% end %>
                <div class="bbcc-article-sidebar-block">
                    <h2 class="bbcc-title-sm">Written By</h2>
                    <div class="bbcc-article-author">
                        <span class="bbcc-article-avatar" aria-hidden="true"></span>
                        <span>
                            <span class="bbcc-article-author-name">Bali Beach Country Club</span>
                            <span class="bbcc-article-author-role">Club News &amp; Updates</span>
                        </span>
                    </div>
                    <p class="bbcc-article-bio">News, updates and stories from the team at Bali Beach Country Club.</p>
                </div>
                <div class="bbcc-article-sidebar-block">
                    <span class="bbcc-article-eyebrow">Share This Article</span>
                    <div class="bbcc-article-share">
                        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= ERB::Util.url_encode(share_url) %>" target="_blank" rel="noopener" aria-label="Share on Facebook">
                            <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
                        </a>
                        <a href="https://twitter.com/intent/tweet?url=<%= ERB::Util.url_encode(share_url) %>&text=<%= ERB::Util.url_encode(share_text) %>" target="_blank" rel="noopener" aria-label="Share on X">
                            <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= ERB::Util.url_encode(share_url) %>" target="_blank" rel="noopener" aria-label="Share on LinkedIn">
                            <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
                        </a>
                        <a href="https://wa.me/?text=<%= ERB::Util.url_encode("#{share_text} #{share_url}") %>" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
                            <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-prose bbcc-article-body"><%= raw @article.content %></div>
                <% if @article.file.attached? %>
                    <div class="margin-30px-top">
                        <%= render_link_download_file(@article, "bbcc-solid-btn") %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</section>
<!-- end article content -->

<%= render "home/blogs" %>

<!-- start book a court cta -->
<section class="bbcc-cta-band">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-5">
                <h2 class="bbcc-title-lg">Ready to Play? <br>Book Your Court Today</h2>
                <p>
                    Golf, tennis, padel and pickleball courts are ready whenever you are. Browse live
                    availability by sport, date and time, and reserve your spot in just a few taps.
                    Need a racquet, a golf cart or a coach for the session? Add those on at checkout too.
                </p>
                <%= link_to "Book Now", search_path, class: "bbcc-solid-btn" %>
            </div>
            <div class="col-12 col-lg-7">
                <%= image_tag "sports/tennis/gallery-2.png", alt: "", loading: "lazy" %>
            </div>
        </div>
    </div>
</section>
<!-- end book a court cta -->

<%= render "home/social_media" %>
