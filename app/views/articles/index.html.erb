<%= render "home/banner" %>
<section class="wow animate__fadeIn">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 text-center">
                <div class="position-relative overflow-hidden w-100">
                    <h5 class="alt-font font-weight-600 text-uppercase margin-50px-bottom">Blog</h5>
                </div>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 justify-content-start">
          <% @articles.each do |article| %>
            <!-- start blog item -->
            <div class="col-sm-9 margin-40px-bottom">
                <div class="overflow-hidden margin-30px-bottom">
                <%= link_to get_blog_path(article) do %>
                  <%= image_tag("https://placehold.co/750x500") %>
                <% end %>
                </div>
                <%= link_to article.title, get_blog_path(article), class: "alt-font margin-5px-bottom d-block text-extra-dark-gray font-weight-600 text-uppercase" %>
                <p class="w-95 xl-w-100"><%= article.short_description.truncate(150) %></p>
            </div>
            <!-- end blog item -->
          <% end %>
        </div>
        <%= paginate @articles, theme: :pofo %>
    </div>
</section>
