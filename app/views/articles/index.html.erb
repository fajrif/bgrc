<%
  is_first_page = params[:page].blank? || params[:page].to_i <= 1
  items = @articles.to_a
  featured = is_first_page ? items.first : nil
  rest = is_first_page ? items.drop(1) : items
  tabs = [{ label: "All", path: blogs_path, active: @category.nil? }] +
         @categories.map { |c| { label: c.name, path: blogs_path(category_id: c.id), active: @category == c } }
%>
<%= render "shared/page_intro", title: "BBCC Blogs", tabs: tabs,
    description: simple_format("Stories, tips and updates from Bali Beach Country Club \u2014 golf, racquet sports, wellness and everything happening on property.") %>

<!-- start blog index -->
<section class="bbcc-page-body bbcc-blog-index">
    <div class="container-lg">
        <% if items.any? %>
            <% if featured %>
                <article class="bbcc-featured-post">
                    <div class="bbcc-featured-post-copy">
                        <span class="bbcc-post-card-meta"><%= featured.published_date&.strftime('%d %b %Y') %><span>|</span><%= featured.category&.name %></span>
                        <h2 class="bbcc-title-md"><%= link_to featured.title, get_blog_path(featured) %></h2>
                        <p><%= featured.short_description.to_s.truncate(320) %></p>
                        <%= link_to "Discover more", get_blog_path(featured), class: "bbcc-text-link" %>
                    </div>
                    <%= link_to get_blog_path(featured), class: "bbcc-featured-post-image" do %>
                        <% if featured.image.attached? %>
                            <%= image_tag featured.image.variant(resize_to_fill: [1200, 800]), alt: featured.title %>
                        <% end %>
                    <% end %>
                </article>
            <% end %>

            <% if rest.any? %>
                <div class="bbcc-post-grid">
                    <% rest.each do |article| %>
                        <%= render "shared/post_card", path: get_blog_path(article), title: article.title, image: article.image,
                            meta: safe_join([article.published_date&.strftime('%d %b %Y'), tag.span("|"), article.category&.name]),
                            excerpt: article.short_description.to_s.truncate(120) %>
                    <% end %>
                </div>
            <% end %>

            <%= paginate @articles, theme: "bbcc" %>
        <% else %>
            <p class="bbcc-empty">No articles in this category yet.</p>
        <% end %>
    </div>
</section>
<!-- end blog index -->

<%= render "home/social_media" %>
