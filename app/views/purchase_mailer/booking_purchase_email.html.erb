<div marginwidth="0" marginheight="0" style="background-color:rgb(245,245,245)">
   <div style="margin:0px;padding:70px 0px;width:100%;background-color:rgb(245,245,245)">
      <table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%" style="border:0px none!important">
         <tbody>
            <tr>
               <td align="center" valign="top" style="border:0px none!important">
                  <table border="0" cellpadding="0" cellspacing="0" width="600" style="width:700px;font-family:Helvetica,Arial,sans-serif;border:0px none rgb(220,220,220)!important;border-radius:21px!important;background-color:rgb(255,255,255)">
                     <tbody style="font-family:Helvetica,Arial,sans-serif">
                        <tr style="font-family:Helvetica,Arial,sans-serif">
                           <td align="center" valign="top" style="font-family:Helvetica,Arial,sans-serif;border:0px none!important">
                              <table border="0" cellpadding="0" cellspacing="0" width="600" style="border-top-style:none;border-right-style:none;border-left-style:none;border-width:0px;font-weight:bold;line-height:100%;vertical-align:middle;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;width:700px;border-radius:21px 21px 0px 0px!important;background-color:rgb(255,255,255);color:rgb(255,255,255)">
                                 <tbody style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif">
                                    <tr style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif">
                                       <td style="display:block;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;border:0px none!important;padding:36px 48px 0 48px!important">
                                          <h1 style="font-family:Helvetica,Arial,sans-serif;font-size:36px;font-weight:300;line-height:150%;margin:0px;text-align:left;color:rgb(55,118,240)">Purchased Confirmation</h1>
                                       </td>
                                    </tr>
                                 </tbody>
                              </table>
                           </td>
                        </tr>
                        <tr style="font-family:Helvetica,Arial,sans-serif">
                           <td align="center" valign="top" style="font-family:Helvetica,Arial,sans-serif;border:0px none!important">
                              <table border="0" cellpadding="0" cellspacing="0" width="600" style="width:700px;font-family:Helvetica,Arial,sans-serif;border:0px none!important;background-color:rgb(255,255,255)">
                                 <tbody style="font-family:Helvetica,Arial,sans-serif">
                                    <tr style="font-family:Helvetica,Arial,sans-serif">
                                       <td valign="top" style="font-family:Helvetica,Arial,sans-serif;border:0px none!important;background-color:rgb(255,255,255)">
                                          <table border="0" cellpadding="20" cellspacing="0" width="100%" style="font-family:Helvetica,Arial,sans-serif;border:0px none!important;color:rgb(80,80,80)">
                                             <tbody style="font-family:Helvetica,Arial,sans-serif">
                                                <tr style="font-family:Helvetica,Arial,sans-serif;color:rgb(80,80,80)">
                                                   <td valign="top" style="padding:28px 48px;font-size:18px;font-family:Helvetica,Arial,sans-serif;border:0px none!important;background-color:rgb(255,255,255);color:rgb(80,80,80)">
                                                      <div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;line-height:150%;text-align:left;color:rgb(80,80,80)">
																												<p style="margin:0px 0px 16px;font-size:18px;font-family:Helvetica,Arial,sans-serif;color:rgb(80,80,80)">
																													Hi <%= @user.full_name %>! Thank you for recent transaction with us! We are delighted to confirm that your recent order on Bali Golf & Racket Club has been completed. Your order details are shown below for your reference:
                                                         </p>
																												 <h2 style="display:block;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;font-size:18px;font-weight:bold;line-height:130%;margin:16px 0px 8px;text-align:left;color:rgb(80,80,80)"><%= "Order ##{@booking.order_id} (#{@booking.created_at.strftime('%d/%m/%Y')})" %></h2>
                                                         <table cellspacing="0" cellpadding="6" style="width:100%;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;border-collapse:collapse;border:0px none rgb(229,229,229)!important;color:rgb(80,80,80)" border="1">
                                                            <thead style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif">
                                                               <tr style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;color:rgb(80,80,80)">
                                                                  <th scope="col" style="text-align:left;border:1px solid rgb(80,80,80);font-size:18px;padding:12px;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;color:rgb(80,80,80)">Booking</th>
                                                                  <th scope="col" style="text-align:left;border:1px solid rgb(80,80,80);font-size:18px;padding:12px;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;color:rgb(80,80,80)">Price</th>
                                                               </tr>
                                                            </thead>
                                                            <tbody style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif">
                                                               <tr style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;color:rgb(80,80,80)">
																																 <td style="text-align:left;vertical-align:middle;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;word-wrap:break-word;border:1px solid rgb(80,80,80);padding:12px;font-size:18px;background-color:rgb(255,255,255);color:rgb(80,80,80)">
																																	 <strong><%= @booking.court.name %></strong><br>
																																	 <small style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif">
                                                                     Booking ID: <%= @booking.order_id %><br/>
																																		 Booking Date: <%= @booking.date.strftime('%d/%m/%Y') %><br/>
                                                                     Booking Time: <%= @booking.date.strftime('%H:%M %p') %><br/>
                                                                     Duration: <%= @booking.duration_label %>
																																	 </small>
                                                                  </td>
																																	<td style="text-align:left;vertical-align:middle;font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif;border:1px solid rgb(80,80,80);padding:12px;font-size:18px;background-color:rgb(255,255,255);color:rgb(80,80,80)"><span style="font-family:&quot;Helvetica Neue&quot;,Helvetica,Roboto,Arial,sans-serif"><%= @booking.price_label %></span></td>
                                                               </tr>
                                                            </tbody>
                                                         </table>
                                                      </div>
                                                   </td>
                                                </tr>
                                             </tbody>
                                          </table>
                                       </td>
                                    </tr>
                                 </tbody>
                              </table>
                           </td>
                        </tr>
                        <tr style="font-family:Helvetica,Arial,sans-serif">
                           <td align="center" valign="top" style="font-family:Helvetica,Arial,sans-serif;border:0px none!important">
                              <table border="0" cellpadding="10" cellspacing="0" width="600" style="width:700px;font-family:Helvetica,Arial,sans-serif;border:0px none!important;border-radius:0px 0px 21px 21px!important;background-color:rgb(255,255,255)">
                                 <tbody style="font-family:Helvetica,Arial,sans-serif">
                                    <tr style="font-family:Helvetica,Arial,sans-serif">
                                       <td valign="top" style="padding:0px;font-family:Helvetica,Arial,sans-serif;border:0px none!important">
                                          <table border="0" cellpadding="10" cellspacing="0" width="100%" style="font-family:Helvetica,Arial,sans-serif;border:0px none!important">
                                             <tbody style="font-family:Helvetica,Arial,sans-serif">
                                                <tr style="font-family:Helvetica,Arial,sans-serif">
                                                   <td colspan="2" valign="middle" style="padding:0px 48px 48px;font-family:Arial;font-size:12px;line-height:125%;text-align:center;border:0px none!important;color:rgb(135,173,246)">
                                                     <p style="line-height:1.5;font-size:12px;font-family:Helvetica,Arial,sans-serif;color:rgb(198,198,198)">“Good things come to those who sweat”<br>if you have any queries, please get in touch with us through <a href="mailto:<%= configatron.info_email %>" style="font-weight:normal;text-decoration:underline;font-family:Helvetica,Arial,sans-serif;color:rgb(55,118,240)" target="_blank"><%= configatron.info_email %></a>
                                                      </p>
                                                   </td>
                                                </tr>
                                             </tbody>
                                          </table>
                                       </td>
                                    </tr>
                                 </tbody>
                              </table>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </td>
            </tr>
         </tbody>
      </table>
   </div>
</div>
