<section class="wow animate__fadeIn bg-light-grey padding-35px-tb page-title-small top-space">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 col-md-6 text-center text-md-start">
                <!-- start page title -->
                <h1 class="alt-font font-weight-600 mb-0 text-uppercase"><%= @promo.name %></h1>
                <!-- end page title -->
            </div>
            <div class="col-lg-4 col-md-6 breadcrumb alt-font text-small justify-content-center justify-content-md-end sm-margin-10px-top">
                <!-- breadcrumb -->
                <ul>
                  <li><a href="<%= root_url %>">Home</a></li>
                  <li><a href="<%= promos_url %>"><%= t('menu.promos') %></a></li>
                  <li class="text-dark-gray"><%= @promo.name %></li>
                </ul>
                <!-- end breadcrumb -->
            </div>
        </div>
    </div>
</section>
<!-- start story section -->
<section class="wow animate__fadeIn">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-lg-6 col-md-6 text-center text-md-start padding-three-lr wow animate__fadeInLeft" data-wow-delay="0.1s">
              <h5 class="alt-font text-extra-dark-gray mb-4"><%= @promo.name %></h5>
              <p><%= @promo.short_description %></p>
              <p><%= @promo.description %></p>
            </div>
        </div>
    </div>
</section>
<!-- end story section -->
