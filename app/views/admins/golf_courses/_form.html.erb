<div class="row">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <%= render "admins/shared/error_messages", target: golf_course, col: 'col-lg-12' %>

        <div class="mb-3">
          <%= f.label :name, "Course Name", class: "form-label" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :location, class: "form-label" %>
          <%= f.text_field :location, class: "form-control", placeholder: "e.g. Bali Beach Country Club, Tuban" %>
        </div>
        <div class="mb-3">
          <%= f.label :holes_available, "Available Holes (comma-separated)", class: "form-label" %>
          <%= f.text_field :holes_available, class: "form-control", placeholder: "9,18" %>
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <%= f.label :interval_minutes, "Tee Time Interval (minutes)", class: "form-label" %>
            <%= f.number_field :interval_minutes, class: "form-control", min: 5, max: 60 %>
          </div>
          <div class="col-md-6 mb-3">
            <%= f.label :max_players, "Max Players per Slot", class: "form-label" %>
            <%= f.number_field :max_players, class: "form-control", min: 1, max: 4 %>
          </div>
        </div>
        <div class="mb-3">
          <%= f.label :status, class: "form-label" %>
          <%= f.select :status, [["Available", 0], ["Unavailable", 1]], {}, class: "form-select" %>
        </div>
        <div class="mb-3">
          <%= f.label :image, class: "form-label" %>
          <%= f.file_field :image, class: "form-control" %>
        </div>
        <div class="d-flex gap-2">
          <%= f.submit class: "btn btn-primary" %>
          <%= link_to "Cancel", admins_golf_courses_path, class: "btn btn-secondary" %>
        </div>
      </div>
    </div>
  </div>
</div>
