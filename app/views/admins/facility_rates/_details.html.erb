<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @facility_rate.id %></td>
	</tr>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @facility_rate.name %></h5></td>
	</tr>
	<tr>
		<td><b>Time</b></td>
		<td><%= blank_or_not(@facility_rate.time) %></td>
	</tr>
	<tr>
		<td><b>Access</b></td>
		<td><%= blank_or_not(@facility_rate.access) %></td>
	</tr>
	<tr>
		<td><b>Price</b></td>
		<td><%= @facility_rate.price %></td>
	</tr>
	<tr>
		<td><b>Facility</b></td>
		<td><%= blank_or_not(@facility_rate.facility&.name) %></td>
	</tr>
	<tr>
		<td><b>Position</b></td>
		<td><%= @facility_rate.position %></td>
	</tr>
</table>
