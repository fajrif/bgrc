<% title_page("Edit Golf Rate") %>
<div class="row">
  <div class="col-lg-5">
    <div class="card">
      <div class="card-body">
        <%= form_for [:admins, @golf_course, @golf_rate] do |f| %>
          <div class="mb-3">
            <%= f.label :holes, class: "form-label" %>
            <%= f.select :holes, [["9 Holes", 9], ["18 Holes", 18]], {}, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :day_type, "Day Type", class: "form-label" %>
            <%= f.select :day_type, GolfRate.day_types.map { |k, _| [k.humanize, k] }, {}, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :price, "Price per Player (Rp.)", class: "form-label" %>
            <%= f.number_field :price, class: "form-control", min: 0 %>
          </div>
          <div class="mb-3">
            <%= f.label :label, "Label (optional)", class: "form-label" %>
            <%= f.text_field :label, class: "form-control" %>
          </div>
          <div class="d-flex gap-2">
            <%= f.submit "Update Rate", class: "btn btn-primary" %>
            <%= link_to "Cancel", admins_golf_course_path(@golf_course), class: "btn btn-secondary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
