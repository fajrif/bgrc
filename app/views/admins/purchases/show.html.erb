<div class="page-bar">
	<div class="page-title-breadcrumb">
		<div class=" pull-left">
			<div class="page-title">Purchase details</div>
		</div>
	</div>
</div>
<div class="row">
	<div class="col-md-12 col-sm-12">
		<div class="card card-box">
			<div class="card-body ">
				<div class="form-horizontal">
					<div class="form-body">
						<div class="form-group row">
							<label class="control-label col-md-3">ID</label>
							<div class="col-md-5">
								<%= @purchase.id %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Order ID</label>
							<div class="col-md-5">
								<strong><%= @purchase.order_id %></strong>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Gross Amount</label>
							<div class="col-md-5">
								<%= @purchase.price_label %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Token</label>
							<div class="col-md-5">
								<%= @purchase.token %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">User</label>
							<div class="col-md-5">
								<%= link_to @purchase.user.full_name, admins_user_path(@purchase.user) %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Type #</label>
							<div class="col-md-5">
								<%= @purchase.productable_type %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Product Name</label>
							<div class="col-md-5">
								<% if @purchase.productable.is_a? Product %>
									<%= link_to @purchase.productable.name_label, admins_product_path(@purchase.productable) %>
								<% elsif @purchase.productable.is_a? Booking %>
									<%= link_to "Booked - #{@purchase.productable.name}", admins_booking_path(@purchase.productable) %>
								<% end %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Status Code</label>
							<div class="col-md-5">
								<%= @purchase.status_code %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Status Message</label>
							<div class="col-md-5">
								<%= @purchase.status_message %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Transaction ID</label>
							<div class="col-md-5">
								<strong><%= @purchase.transaction_id %></strong>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Masked Card</label>
							<div class="col-md-5">
								<%= @purchase.masked_card %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Payment Type</label>
							<div class="col-md-5">
								<%= @purchase.payment_type %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Transaction Time</label>
							<div class="col-md-5">
								<%= @purchase.transaction_time %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Transaction Status</label>
							<div class="col-md-5">
								<%= @purchase.transaction_status %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Fraud Status</label>
							<div class="col-md-5">
								<%= @purchase.fraud_status %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Approval Code</label>
							<div class="col-md-5">
								<%= @purchase.approval_code %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Bank</label>
							<div class="col-md-5">
								<%= @purchase.bank %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Card Type</label>
							<div class="col-md-5">
								<%= @purchase.card_type %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Save Token ID</label>
							<div class="col-md-5">
								<%= @purchase.save_token_id %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Save Token ID Expired At</label>
							<div class="col-md-5">
								<%= @purchase.saved_token_id_expired_at %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Channel Response Code</label>
							<div class="col-md-5">
								<%= @purchase.channel_response_code %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Channel Response Message</label>
							<div class="col-md-5">
								<%= @purchase.channel_response_message %>
							</div>
						</div>
						<div class="form-group row">
							<label class="control-label col-md-3">Created At</label>
							<div class="col-md-5">
								<%= @purchase.created_at %>
							</div>
						</div>
						<div class="form-actions">
							<div class="row">
								<div class="offset-md-3 col-md-9">
									<%= link_to 'Destroy', admins_purchase_path(@purchase), :data => { :confirm => 'Are you sure?' }, :method => :delete, :class => 'btn btn-danger' %>
									<%= link_to 'Settlement', settlement_admins_purchase_path(@purchase), :data => { :confirm => 'Are you sure want to settle this transaction?' }, :method => :put, :class => 'btn btn-warning' unless @purchase.status_code == "200" %>
									<%= link_to 'View All', admins_purchases_path, :class => 'btn' %>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
