<%= simple_form_for @team_member, url: (@team_member.new_record? ? admins_team_members_path : admins_team_member_path(@team_member.id)), method: (@team_member.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :photo, as: :file, input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg" } %>
						<%= f.input :name, as: :string %>
						<%= f.input :role, as: :string, label: "Role / Title" %>
						<%= f.input :bio, as: :text %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @team_member.new_record? %>
							<%= link_to "Cancel", admins_team_member_path(@team_member.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_team_members_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @team_member, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.input :department, as: :select, collection: TeamMember::DEPARTMENTS.map { |d| [TeamMember.department_label(d), d] }, value_method: :last, label_method: :first %>
							<%= f.input :position, as: :integer, hint: "Lower numbers show first" %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
