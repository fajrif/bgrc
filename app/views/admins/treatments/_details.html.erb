<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @treatment.id %></td>
	</tr>
	<% if @treatment.image.attached? %>
	<tr>
		<td><b>Image</b></td>
		<td><%= image_tag @treatment.image.variant(resize_to_limit: [100,100]) %></td>
	</tr>
	<% end %>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @treatment.name %></h5></td>
	</tr>
	<tr>
		<td><b>Short Description</b></td>
		<td><%= @treatment.short_description %></td>
	</tr>
	<tr>
		<td><b>Duration</b></td>
		<td><%= blank_or_not(@treatment.duration) %></td>
	</tr>
	<tr>
		<td><b>Price</b></td>
		<td><%= blank_or_not(@treatment.price) %></td>
	</tr>
	<tr>
		<td><b>Facility</b></td>
		<td><%= blank_or_not(@treatment.facility&.name) %></td>
	</tr>
	<tr>
		<td><b>Position</b></td>
		<td><%= @treatment.position %></td>
	</tr>
</table>
