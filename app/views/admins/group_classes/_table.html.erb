<div class="table-card">
	<table class="table table-hover table-striped align-middle mb-0">
		<thead class="table-light">
			<tr>
				<th class="text-center">ID</th>
				<th>Name</th>
				<th>Category</th>
				<th>Sport</th>
				<th>Price</th>
				<th>Capacity</th>
				<th class="text-center">Prescheduled</th>
				<th class="text-center">Min.Duration</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			<% for gc in @group_classes %>
				<tr>
					<td class="text-center"><%= gc.id %></td>
					<td>
						<h5 class="fs-14 mb-1"><%= link_to gc.name, admins_group_class_path(gc), class: "text-body" %></h5>
					</td>
					<td><span class="badge bg-info-subtle text-info"><%= gc.category_label %></span></td>
					<td><%= gc.try(:sport).try(:name) || "—" %></td>
					<td>
						<h5 class="fs-14 mb-1"><%= gc.price_label %></h5>
						<span class="text-muted"><%= gc.price_pax_label %></span>
					</td>
					<td>
						<span class="text-muted">Min: <%= gc.min_pax %> / Max: <%= gc.max_pax %></span>
					</td>
					<td class="text-center">
						<% if gc.is_prescheduled? %>
							<span class="badge bg-success">Yes</span>
						<% else %>
							<span class="badge bg-secondary">No</span>
						<% end %>
					</td>
          <td class="text-center"><%= gc.duration_label %></td>
					<td>
						<div class="dropdown">
							<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="ri-more-fill"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end">
								<li>
									<%= link_to admins_group_class_path(gc), class: "dropdown-item" do %>
										<i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
									<% end %>
								</li>
								<li>
									<%= link_to edit_admins_group_class_path(gc), class: "dropdown-item edit-list" do %>
										<i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit
									<% end %>
								</li>
								<li class="dropdown-divider"></li>
								<li>
									<%= link_to admins_group_class_path(gc), :data => { :confirm => 'Are you sure?' }, :method => :delete, class: "dropdown-item remove-list" do %>
										<i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
									<% end %>
								</li>
							</ul>
						</div>
					</td>
				</tr>
			<% end %>
		</tbody>
	</table>
</div>
<!-- pagination -->
<%= paginate @group_classes %>
