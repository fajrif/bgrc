<% title_page(@current_sport ? "#{@current_sport.name} Group Classes" : "Group Classes", sport_slug: @current_sport&.slug) %>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
				<%= form_tag admins_group_classes_url, { :id => "index_search", :method => :get } do %>
					<div class="row g-3 align-items-center">
						<%= hidden_field_tag :sport_slug, params[:sport_slug] if params[:sport_slug].present? %>
						<div class="col-md-4">
							<div class="form-icon">
								<%= text_field_tag :search, params[:search], :class => "form-control form-control-icon", :placeholder => "Search name ..." %>
								<i class="ri-search-line"></i>
							</div>
						</div>
						<div class="col-md-4">
							<%= select_tag :category,
								options_for_select(GroupClass::CATEGORIES.map { |label, slug| [label, slug] }, params[:category]),
								class: "form-select", include_blank: "All Categories" %>
						</div>
						<div class="col-md-auto ms-auto">
							<div class="hstack gap-2">
								<%= submit_tag "Filter", class: "btn btn-soft-primary" %>
								<a class="btn btn-success add-btn" href="<%= new_admins_group_class_path(sport_slug: params[:sport_slug]) %>"><i class="ri-add-line align-bottom me-1"></i> Add Group Class</a>
							</div>
						</div>
					</div>
				<% end %>
			</div>
			<div id="index_table" class="card-body">
				<%= render 'table' %>
			</div>
		</div>
	</div>
</div>
