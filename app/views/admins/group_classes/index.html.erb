<% title_page("Group Classes") %>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
				<%= form_tag admins_group_classes_url, { :id => "index_search", :method => :get } do %>
					<div class="row g-3 align-items-center">
						<div class="col-md-3">
							<div class="form-icon">
								<%= text_field_tag :search, params[:search], :class => "form-control form-control-icon", :placeholder => "Search name ..." %>
								<i class="ri-search-line"></i>
							</div>
						</div>
						<div class="col-md-3">
							<%= select_tag :sport_id,
								options_from_collection_for_select(@sports, :id, :name, params[:sport_id]),
								class: "form-select", include_blank: "All Sports" %>
						</div>
						<div class="col-md-3">
							<%= select_tag :category,
								options_for_select(GroupClass::CATEGORIES.map { |label, slug| [label, slug] }, params[:category]),
								class: "form-select", include_blank: "All Categories" %>
						</div>
						<div class="col-md-auto ms-auto">
							<div class="hstack gap-2">
								<%= submit_tag "Filter", class: "btn btn-soft-primary" %>
								<a class="btn btn-success add-btn" href="<%= new_admins_group_class_path %>"><i class="ri-add-line align-bottom me-1"></i> Add Group Class</a>
							</div>
						</div>
					</div>
				<% end %>
			</div>
			<div id="index_table" class="card-body">
				<%= render 'table' %>
			</div>
		</div>
	</div>
</div>
