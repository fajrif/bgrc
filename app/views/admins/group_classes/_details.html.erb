<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @group_class.id %></td>
	</tr>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @group_class.name %></h5></td>
	</tr>
	<tr>
		<td><b>Min. Duration</b></td>
		<td><%= @group_class.duration_label %></td>
	</tr>
	<tr>
		<td><b>Price</b></td>
		<td><%= @group_class.price_label %></td>
	</tr>
	<tr>
		<td><b>Price Pax</b></td>
		<td><%= @group_class.price_pax_label %></td>
	</tr>
	<tr>
		<td><b>Min. Pax</b></td>
		<td><%= @group_class.min_pax %></td>
	</tr>
	<tr>
		<td><b>Max. Pax</b></td>
		<td><%= @group_class.max_pax %></td>
	</tr>
	<tr>
		<td><b>Status</b></td>
		<td><%= @group_class.status_label %></td>
	</tr>
	<tr>
		<td><b>Notes</b></td>
		<td><i><%= @group_class.notes %></i></td>
	</tr>
	<tr>
		<td><b>Description</b></td>
		<td><%= raw @group_class.description %></td>
	</tr>
</table>
