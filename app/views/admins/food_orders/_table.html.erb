<div class="table-card">
	<table class="table table-hover table-striped align-middle mb-0">
		<thead class="table-light">
			<tr>
				<th>Order ID</th>
				<th>Customer</th>
				<th>Items</th>
				<th>Total</th>
				<th>Payment</th>
				<th>Kitchen</th>
				<th>Placed</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			<% for food_order in @food_orders %>
				<% status_color = { FoodOrder::PAID => "success", FoodOrder::UNPAID => "warning", FoodOrder::EXPIRED => "danger", FoodOrder::CANCELLED => "danger" }[food_order.status] || "secondary" %>
				<tr>
					<td><%= link_to food_order.order_id, admins_food_order_path(food_order.id), class: "fw-semibold text-body" %></td>
					<td>
						<h5 class="fs-14 mb-1"><%= food_order.customer_name %></h5>
						<p class="text-muted mb-0"><%= food_order.customer_phone %></p>
					</td>
					<td><%= food_order.items_count %></td>
					<td><%= food_order.total_price_label %></td>
					<td>
						<span class="badge bg-<%= status_color %>-subtle text-<%= status_color %>"><%= food_order.status_label %></span>
						<% if food_order.cashier_order? %>
							<span class="badge bg-info-subtle text-info">Cashier</span>
						<% end %>
					</td>
					<td><%= food_order.paid? ? food_order.fulfillment_label : "&mdash;".html_safe %></td>
					<td><%= food_order.created_at.strftime("%d/%m/%Y %H:%M") %></td>
					<td>
						<div class="dropdown">
							<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="ri-more-fill"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end">
								<li>
									<%= link_to admins_food_order_path(food_order.id), class: "dropdown-item" do %>
										<i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
									<% end %>
								</li>
								<li class="dropdown-divider"></li>
								<li>
									<%= link_to admins_food_order_path(food_order.id), :data => { :confirm => 'Are you sure?' }, :method => :delete, class: "dropdown-item remove-list" do %>
										<i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
									<% end %>
								</li>
							</ul>
						</div>
					</td>
				</tr>
			<% end %>
		</tbody>
	</table>
</div>
<!-- pagination -->
<%= paginate @food_orders %>
