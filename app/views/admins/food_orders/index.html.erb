<% title_page("Grab & Go Orders") %>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
				<%= form_tag admins_food_orders_url, { :id => "index_search", :method => :get } do %>
					<div class="row g-4 align-items-center">
						<div class="col-md-4">
							<div class="form-icon">
								<%= text_field_tag :search, params[:search], :class => "form-control form-control-icon", :placeholder => "Search order ID, name or phone ..." %>
								<i class="ri-search-line"></i>
							</div>
						</div>
						<div class="col-md-3">
							<%= select_tag :status,
										options_for_select([["Unpaid", FoodOrder::UNPAID], ["Paid", FoodOrder::PAID], ["Expired", FoodOrder::EXPIRED], ["Cancelled", FoodOrder::CANCELLED]], params[:status]),
										include_blank: "All payment statuses", class: "form-select filter_select" %>
						</div>
						<div class="col-md-3">
							<%= select_tag :fulfillment_status,
										options_for_select(FoodOrder::FULFILLMENT_LABELS.map { |value, label| [label, value] }, params[:fulfillment_status]),
										include_blank: "All kitchen statuses", class: "form-select filter_select" %>
						</div>
					</div>
				<% end %>
			</div>
			<div id="index_table" class="card-body">
				<%= render 'table' %>
			</div>
		</div>
	</div>
	<!--end col-->
</div>
<!--end row-->
