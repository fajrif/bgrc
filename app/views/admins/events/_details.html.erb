<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @event.id %></td>
	</tr>
	<% if @event.image.attached? %>
	<tr>
		<td><b>Image</b></td>
		<td>
			<%= image_tag @event.image.variant(resize_to_limit: [100,100]) %>
			<%= link_to delete_attachment_image_admins_event_path(@event.id, @event.image.id), :class => "ms-2 btn btn-danger btn-sm", :data => { :confirm => 'Are You sure want to delete this image?' }, :method => :delete do %>
				<i class="ri-delete-bin-fill"></i>
			<% end %>
		</td>
	</tr>
	<% end %>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @event.name %></h5></td>
	</tr>
	<tr>
		<td><b>Short Description</b></td>
		<td><%= @event.short_description %></td>
	</tr>
	<tr>
		<td><b>Description</b></td>
		<td><%= @event.description %></td>
	</tr>
	<tr>
		<td><b>Sport</b></td>
    <td><%= @event.try(:sport).try(:name) %></td>
	</tr>
	<tr>
		<td><b>Start Date</b></td>
		<td><%= @event.start_date.strftime('%d/%m/%Y %H:%M') %></td>
	</tr>
	<tr>
		<td><b>End Date</b></td>
    <td><%= @event.end_date.strftime('%d/%m/%Y %H:%M') %></td>
	</tr>
	<tr>
		<td><b>Featured</b></td>
    <td><%= @event.is_featured? ? "Yes" : "No" %></td>
	</tr>
	<tr>
		<td><b>Capacity</b></td>
    <td><%= @event.capacity.to_i == 0 ? "Unlimited" : "#{@event.event_rsvps.count} / #{@event.capacity} registered" %></td>
	</tr>
</table>

<% if @event.event_rsvps.any? %>
<h6 class="mt-4 mb-2">RSVP Registrants (<%= @event.event_rsvps.count %>)</h6>
<table class="table table-sm table-bordered">
  <thead>
    <tr><th>#</th><th>Name</th><th>Email</th><th>Phone</th><th>Registered</th></tr>
  </thead>
  <tbody>
    <% @event.event_rsvps.order(created_at: :asc).each_with_index do |rsvp, i| %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= rsvp.name %></td>
        <td><%= rsvp.email %></td>
        <td><%= rsvp.phone.presence || "-" %></td>
        <td><%= rsvp.created_at.strftime('%d/%m/%Y %H:%M') %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% end %>
