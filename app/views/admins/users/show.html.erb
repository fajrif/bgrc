<% title_page("User Details") %>
<div class="row">
  <div class="col-md-12">
    <div class="card card-box">
      <div class="card-body">

        <!-- Tab Nav -->
        <ul class="nav nav-tabs mb-4" id="userTabs" role="tablist">
          <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-details">Details</button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-bookings">
              Bookings <span class="badge bg-secondary ms-1"><%= @bookings.size %></span>
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-credits">
              Class Credits <span class="badge bg-secondary ms-1"><%= @credit_purchases.size %></span>
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-payments">
              Payments <span class="badge bg-secondary ms-1"><%= @purchases.size %></span>
            </button>
          </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="userTabsContent">

          <!-- Details -->
          <div class="tab-pane fade show active" id="tab-details">
            <%= render "details" %>
          </div>

          <!-- Bookings -->
          <div class="tab-pane fade" id="tab-bookings">
            <% if @bookings.any? %>
              <table class="table table-striped table-sm">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Date</th>
                    <th>Court</th>
                    <th>Duration</th>
                    <th>Class</th>
                    <th>Status</th>
                    <th>Price</th>
                  </tr>
                </thead>
                <tbody>
                  <% @bookings.each do |b| %>
                    <tr>
                      <td><small><%= b.order_id %></small></td>
                      <td class="text-nowrap"><%= b.date.strftime('%d %b %Y %H:%M') %></td>
                      <td><%= b.court.try(:name_label) || '—' %></td>
                      <td><%= b.duration %> hr</td>
                      <td>
                        <% if b.group_class.present? %>
                          <%= b.group_class.name_with_pax(b.pax) %>
                        <% else %>
                          —
                        <% end %>
                      </td>
                      <td>
                        <% badge = case b.status
                                   when Booking::PAID      then "bg-success"
                                   when Booking::CANCELLED then "bg-danger"
                                   when Booking::EXPIRED   then "bg-secondary"
                                   else "bg-warning text-dark"
                                   end %>
                        <span class="badge <%= badge %>"><%= b.status_label %></span>
                      </td>
                      <td class="text-nowrap"><%= b.total_price_label %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <p class="text-muted">No bookings found.</p>
            <% end %>
          </div>

          <!-- Class Credits -->
          <div class="tab-pane fade" id="tab-credits">
            <% if @credit_purchases.any? %>
              <table class="table table-striped table-sm">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Class</th>
                    <th>Pax</th>
                    <th>Purchased</th>
                    <th>Sessions</th>
                    <th>Remaining</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @credit_purchases.each do |cp| %>
                    <tr>
                      <td><small><%= cp.order_id %></small></td>
                      <td><%= cp.group_class.try(:name) %></td>
                      <td class="text-center"><%= cp.pax %></td>
                      <td class="small text-muted text-nowrap"><%= cp.purchase_date.try(:strftime, '%d %b %Y') %></td>
                      <td class="text-center"><%= cp.sessions_used %> / <%= cp.sessions_count %></td>
                      <td class="text-center fw-semibold <%= cp.sessions_remaining > 0 ? 'text-success' : 'text-danger' %>">
                        <%= cp.sessions_remaining %>
                      </td>
                      <td class="small text-muted text-nowrap"><%= cp.expires_at.try(:strftime, '%d %b %Y') || '—' %></td>
                      <td>
                        <% if cp.paid? %>
                          <span class="badge bg-success">Paid</span>
                        <% else %>
                          <span class="badge bg-warning text-dark">Pending</span>
                        <% end %>
                      </td>
                      <td>
                        <% if cp.paid? && cp.sessions_remaining > 0 && !cp.group_class.is_prescheduled? %>
                          <button type="button" class="btn btn-outline-primary btn-sm"
                                  data-bs-toggle="modal" data-bs-target="#bookModal<%= cp.id %>">
                            Book on Behalf
                          </button>
                        <% else %>
                          —
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <p class="text-muted">No class credit purchases found.</p>
            <% end %>

            <%# Book-on-Behalf modals — one per eligible credit purchase %>
            <% @credit_purchases.each do |cp| %>
              <% next unless cp.paid? && cp.sessions_remaining > 0 && !cp.group_class.is_prescheduled? %>
              <% sport_courts = cp.group_class.sport ? Court.joins(:sport).where(sport: cp.group_class.sport) : Court.all %>
              <% coaches = Coach.all %>
              <div class="modal fade" id="bookModal<%= cp.id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Book on Behalf — <%= cp.group_class.name %></h5>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <%= form_tag book_on_behalf_admins_class_credit_purchase_path(cp), method: :post do %>
                      <div class="modal-body">
                        <p class="text-muted small mb-3">
                          Creating a booking for <strong><%= @user.full_name %></strong> using credit
                          <strong><%= cp.order_id %></strong>
                          (<%= cp.sessions_remaining %> session(s) remaining).
                        </p>
                        <div class="mb-3">
                          <%= label_tag :date, "Date", class: "form-label fw-semibold" %>
                          <%= date_field_tag :date, Date.tomorrow.strftime("%Y-%m-%d"),
                                class: "form-control", min: Date.today.strftime("%Y-%m-%d"), required: true %>
                        </div>
                        <div class="mb-3">
                          <%= label_tag :time, "Start Time", class: "form-label fw-semibold" %>
                          <%= select_tag :time,
                                options_for_select((6..21).map { |h| ["#{h.to_s.rjust(2,'0')}:00", "#{h.to_s.rjust(2,'0')}:00"] }, "08:00"),
                                class: "form-select", required: true %>
                        </div>
                        <div class="mb-3">
                          <%= label_tag :court_id, "Court", class: "form-label fw-semibold" %>
                          <%= select_tag :court_id,
                                options_for_select(sport_courts.map { |c| [c.name_label, c.id] }),
                                class: "form-select", required: true %>
                        </div>
                        <div class="mb-3">
                          <%= label_tag :coach_id, "Coach", class: "form-label fw-semibold" %>
                          <%= select_tag :coach_id,
                                options_for_select([["— No Coach —", ""]] + coaches.map { |c| [c.name, c.id] }),
                                class: "form-select" %>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Confirm Booking</button>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Payments -->
          <div class="tab-pane fade" id="tab-payments">
            <% if @purchases.any? %>
              <table class="table table-striped table-sm">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @purchases.each do |p| %>
                    <tr>
                      <td><small><%= p.order_id %></small></td>
                      <td><%= p.productable_type.to_s.humanize %></td>
                      <td class="small text-muted text-nowrap"><%= p.created_at.strftime('%d %b %Y %H:%M') %></td>
                      <td class="text-nowrap"><%= p.price_label %></td>
                      <td>
                        <% if p.transaction_status == "settlement" || p.status_code.in?(["200","201"]) %>
                          <span class="badge bg-success">Paid</span>
                        <% elsif p.transaction_status.blank? %>
                          <span class="badge bg-warning text-dark">Pending</span>
                        <% else %>
                          <span class="badge bg-secondary"><%= p.transaction_status.humanize %></span>
                        <% end %>
                      </td>
                      <td>
                        <%= link_to "View", admins_purchase_path(p), class: "btn btn-outline-secondary btn-sm" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% else %>
              <p class="text-muted">No payments found.</p>
            <% end %>
          </div>

        </div><!-- /tab-content -->

        <div class="form-actions mt-4">
          <%= link_to 'Edit', edit_admins_user_path(@user.id), class: 'btn btn-secondary' %>
          <%= link_to 'Destroy', admins_user_path(@user.id), confirm: 'Are you sure?', method: :delete, class: 'btn btn-danger' %>
          <%= link_to 'View All', admins_users_path, class: 'btn btn-light' %>
        </div>

      </div>
    </div>
  </div>
</div>
