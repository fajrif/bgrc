<%# Create-a-walk-in-customer form inside the user picker modal. Re-rendered in
    place by create.js.erb when validation fails, so it must carry its own errors. %>
<%= form_for user, :url => admins_users_path, :method => :post, :remote => true,
		:html => { :id => "user-picker-form" } do |f| %>

	<% if user.errors.any? %>
		<div class="alert alert-danger">
			<ul class="mb-0 ps-3">
				<% user.errors.full_messages.each do |msg| %>
					<li><%= msg %></li>
				<% end %>
			</ul>
		</div>
	<% end %>

	<div class="mb-3">
		<label class="form-label">Full Name <span class="text-danger">*</span></label>
		<%= f.text_field :full_name, :class => "form-control", :placeholder => "e.g. Made Wirawan" %>
	</div>

	<div class="mb-3">
		<label class="form-label">Email <span class="text-danger">*</span></label>
		<%= f.email_field :email, :class => "form-control", :placeholder => "name@example.com" %>
	</div>

	<div class="mb-3">
		<label class="form-label">Phone <span class="text-danger">*</span></label>
		<%= f.telephone_field :phone, :class => "form-control", :placeholder => "e.g. 081234567890" %>
	</div>

	<p class="text-muted small">
		<i class="ri-mail-send-line align-bottom me-1"></i>
		A verification email will be sent so the customer can set their own password.
	</p>

	<div class="d-flex justify-content-end gap-2">
		<button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
		<%= f.submit "Create & Select", :class => "btn btn-success" %>
	</div>
<% end %>
