<div class="form-horizontal">
	<div class="form-body">
		<div class="form-group row">
			<label class="control-label col-md-3">ID</label>
			<div class="col-md-5">
				<%= @user.id %>
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Email</label>
			<div class="col-md-5">
				<%= @user.email %>
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Password</label>
			<div class="col-md-5">
				*****
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Full name</label>
			<div class="col-md-5">
				<%= @user.full_name %>
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Phone</label>
			<div class="col-md-5">
				<%= @user.phone %>
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Place / Date of Birth</label>
			<div class="col-md-5">
				<%= "#{ @user.pob } / #{ @user.dob.strftime('%Y-%m-%d') }" unless @user.dob.blank? %>
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Gender</label>
			<div class="col-md-5">
				<%= @user.gender_label %>
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Address</label>
			<div class="col-md-5">
				<%= @user.address.complete if @user.address %>
			</div>
		</div>
		<div class="form-group row">
			<label class="control-label col-md-3">Register at</label>
			<div class="col-md-5">
				<%= @user.created_at.strftime('%d-%m-%Y %H:%M %p') %>
			</div>
		</div>
	</div>
</div>
