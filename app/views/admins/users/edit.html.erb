<div class="page-bar">
	<div class="page-title-breadcrumb">
		<div class=" pull-left">
			<div class="page-title">Edit User</div>
		</div>
	</div>
</div>
<div class="row">
	<div class="col-md-12 col-sm-12">
		<div class="card card-box">
			<div class="card-body ">
				<%= simple_form_for [:admins, @user], :html => { :class => 'form-horizontal' } do |f| %>
					<%= f.error_notification %>
					<div class="form-body">
						<%= f.input :email %>
						<%= f.input :password %>
						<%= f.input :password_confirmation %>
						<%= f.input :full_name %>
						<%= f.input :gender, as: :select, collection: [['1', 'Male'], ['0', 'Female']], label_method: :second, value_method: :first %>
						<div class="form-actions">
							<div class="row">
								<div class="offset-md-3 col-md-9">
									<%= f.button :submit, 'Save', :class => 'btn btn-primary' %>
									<%= link_to "Cancel", admins_user_path(@user), :class => 'btn' %>
								</div>
							</div>
						</div>
					</div>
				<% end %>
			</div>
		</div>
	</div>
</div>
