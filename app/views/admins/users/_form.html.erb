<%= simple_form_for @user, url: (@user.new_record? ? admins_users_path : admins_user_path(@user.id)), method: (@user.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :full_name %>
						<%= f.input :email %>
						<%= f.input :phone %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @user.new_record? %>
							<%= link_to "Cancel", admins_user_path(@user.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_users_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @user, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.input :dob, as: :string, input_html: { class: "datepicker", value: get_input_date_value(f.object.dob) } %>
              <%= f.input :gender, as: :select, collection: [['1', 'Male'], ['0', 'Female']], label_method: :second, value_method: :first %>
              <%= f.input :nationality, as: :select, collection: options_for_nationalities, prompt: "Choose your Nationality" %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
