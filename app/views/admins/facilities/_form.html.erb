<%= simple_form_for @facility, url: (@facility.new_record? ? admins_facilities_path : admins_facility_path(@facility.id)), method: (@facility.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :image, as: :file, input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :banner, as: :file, hint: "Used as the hero photo on this section's own page.", input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :middle_banner, as: :file, hint: "Container-width photo shown between the intro and the pricing row.", input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :images, as: :file, label: "Image Gallery", input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp", multiple: true } %>
						<%= f.input :name, as: :string %>
						<%= f.input :short_description, as: :text %>
						<%= f.input :description, as: :text %>
						<%= f.input :facilities_intro, as: :text, label: "Facilities intro", input_html: { rows: 3 },
												hint: "Paragraph under the \"BBCC … Facilities\" heading." %>
						<%= f.input :treatments_title, as: :string, label: "Treatments heading", placeholder: "Treatment",
												hint: "Heading over the treatment cards — e.g. \"Services\". Defaults to \"Treatment\"." %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @facility.new_record? %>
							<%= link_to "Cancel", admins_facility_path(@facility.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_facilities_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @facility, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Club Life</h5>
						</div>
						<div class="card-body">
							<%= f.input :club_life, as: :boolean, label: "Club Life section", hint: "Tick for the five top-level sections (Golf, Racquet Sports, ...)." %>
							<%= f.input :parent_id, as: :select, label: "Parent section",
													collection: Facility.club_life_roots.where.not(id: @facility.id).map { |s| [s.name, s.id] },
													include_blank: "— none —" %>
							<%= f.association :sport, as: :select, include_blank: "— none —",
													hint: "Links this page to a sport for its gallery and group classes." %>
							<%= f.input :position, as: :integer %>
							<%= f.input :show_pricing, as: :boolean, label: "Show pricing section", hint: "Untick to hide the pricing row on this page without deleting the rates." %>
							<%= f.input :show_specialists, as: :boolean, label: "Show specialists section", hint: "Spa + Wellness pages only — the shared Our Specialists row." %>
							<%= f.input :cta_label, as: :string, label: "Button label", placeholder: "Book Now" %>
							<%= f.input :cta_url, as: :string, label: "Button link", placeholder: "/golf" %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
