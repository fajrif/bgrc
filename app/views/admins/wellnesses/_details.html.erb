<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @wellness.id %></td>
	</tr>
	<% if @wellness.image.attached? %>
	<tr>
		<td><b>Image</b></td>
		<td>
			<%= image_tag @wellness.image.variant(resize_to_limit: [100,100]) %>
			<%= link_to delete_attachment_image_admins_wellness_path(@wellness.id, @wellness.image.id), :class => "ms-2 btn btn-danger btn-sm", :data => { :confirm => 'Are You sure want to delete this image?' }, :method => :delete do %>
				<i class="ri-delete-bin-fill"></i>
			<% end %>
		</td>
	</tr>
	<% end %>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @wellness.name %></h5></td>
	</tr>
	<tr>
		<td><b>Short Description</b></td>
		<td><%= @wellness.short_description %></td>
	</tr>
	<tr>
		<td><b>Description</b></td>
		<td><%= @wellness.description %></td>
	</tr>
</table>
