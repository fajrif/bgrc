<div class="table-card">
	<table class="table table-hover table-striped align-middle mb-0">
		<thead class="table-light">
			<tr>
				<th class="text-center">ID</th>
				<th>Title</th>
				<th>Description</th>
				<th>Facility</th>
				<th>Position</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			<% for facility_benefit in @facility_benefits %>
				<tr>
					<td class="text-center"><%= facility_benefit.id %></td>
					<td>
						<h5 class="fs-14 mb-1"><%= link_to facility_benefit.title, admins_facility_benefit_path(facility_benefit.id), class: "text-body" %></h5>
					</td>
					<td><%= facility_benefit.description.to_s.truncate(80) %></td>
					<td><%= blank_or_not(facility_benefit.facility&.name) %></td>
					<td><%= facility_benefit.position %></td>
					<td>
						<div class="dropdown">
							<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="ri-more-fill"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end">
								<li>
									<%= link_to admins_facility_benefit_path(facility_benefit.id), class: "dropdown-item" do %>
										<i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
									<% end %>
								</li>
								<li>
									<%= link_to edit_admins_facility_benefit_path(facility_benefit.id), class: "dropdown-item edit-list" do %>
										<i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit
									<% end %>
								</li>
								<li class="dropdown-divider"></li>
								<li>
									<%= link_to admins_facility_benefit_path(facility_benefit.id), :data => { :confirm => 'Are you sure?' }, :method => :delete, class: "dropdown-item remove-list" do %>
										<i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
									<% end %>
								</li>
							</ul>
						</div>
					</td>
				</tr>
			<% end %>
		</tbody>
	</table>
</div>
<!-- pagination -->
<%= paginate @facility_benefits %>
