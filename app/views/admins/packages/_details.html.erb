<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @package.id %></td>
	</tr>
	<% if @package.image.attached? %>
	<tr>
		<td><b>Image</b></td>
		<td>
			<%= image_tag @package.image.variant(resize_to_limit: [100,100]) %>
			<%= link_to delete_attachment_image_admins_package_path(@package.id, @package.image.id), :class => "ms-2 btn btn-danger btn-sm", :data => { :confirm => 'Are You sure want to delete this image?' }, :method => :delete do %>
				<i class="ri-delete-bin-fill"></i>
			<% end %>
		</td>
	</tr>
	<% end %>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @package.name %></h5></td>
	</tr>
	<tr>
		<td><b>Short Description</b></td>
		<td><%= @package.short_description %></td>
	</tr>
	<tr>
		<td><b>Description</b></td>
		<td><%= @package.description %></td>
	</tr>
	<tr>
		<td><b>Sport</b></td>
    <td><%= @package.try(:sport).try(:name) %></td>
	</tr>
	<tr>
		<td><b>Start Date</b></td>
		<td><%= @package.start_date.strftime('%d/%m/%Y %H:%M') %></td>
	</tr>
	<tr>
		<td><b>End Date</b></td>
    <td><%= @package.end_date.strftime('%d/%m/%Y %H:%M') %></td>
	</tr>
</table>
