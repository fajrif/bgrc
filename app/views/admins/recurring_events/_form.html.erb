<%= form_for(@recurring_event, url: @recurring_event.new_record? ? admins_recurring_events_url : admins_recurring_event_url(@recurring_event), html: { method: @recurring_event.new_record? ? :post : :put, multipart: true }) do |f| %>
  <div class="mb-3">
    <%= f.label :title, "Title", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "e.g. Ladies Party Event" %>
    <% if @recurring_event.errors[:title].present? %>
      <div class="text-danger"><%= @recurring_event.errors[:title].join(", ") %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :image, "Event Image", class: "form-label" %>
    <% if @recurring_event.image.attached? %>
      <div class="mb-2">
        <%= image_tag @recurring_event.image.variant(resize_to_fill: [400, 200]), class: "img-thumbnail" %>
      </div>
    <% end %>
    <%= f.file_field :image, class: "form-control", accept: "image/gif,image/png,image/jpg,image/jpeg,image/webp" %>
  </div>

  <div class="mb-3">
    <%= f.label :short_description, "Short Description", class: "form-label" %>
    <%= f.text_area :short_description, class: "form-control", rows: 3, placeholder: "Brief summary shown on listings" %>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description", class: "form-label" %>
    <%= f.text_area :description, class: "form-control quill_container", rows: 6 %>
  </div>

  <div class="card bg-light mb-3">
    <div class="card-body">
      <p class="fw-semibold mb-2">Schedule Type</p>
      <div class="form-check mb-2">
        <input type="radio" name="schedule_type" id="sched_recurring" value="recurring" class="form-check-input"
               <%= @recurring_event.specific_date.blank? ? 'checked' : '' %>>
        <label for="sched_recurring" class="form-check-label">Recurring (every week on a specific day)</label>
      </div>
      <div class="form-check mb-3">
        <input type="radio" name="schedule_type" id="sched_one_time" value="one_time" class="form-check-input"
               <%= @recurring_event.specific_date.present? ? 'checked' : '' %>>
        <label for="sched_one_time" class="form-check-label">One-time (specific date)</label>
      </div>

      <div id="recurring_fields" <%= @recurring_event.specific_date.present? ? 'style="display:none;"' : '' %>>
        <%= f.label :day_of_week, "Day of Week", class: "form-label" %>
        <%= f.select :day_of_week, RecurringEvent.days_for_select, { include_blank: "Select Day" }, class: "form-select mb-0" %>
        <% if @recurring_event.errors[:day_of_week].present? %>
          <div class="text-danger"><%= @recurring_event.errors[:day_of_week].join(", ") %></div>
        <% end %>
      </div>

      <div id="one_time_fields" <%= @recurring_event.specific_date.blank? ? 'style="display:none;"' : '' %>>
        <div class="row">
          <div class="col-md-6 mb-2">
            <%= f.label :specific_date, "Start Date", class: "form-label" %>
            <%= f.date_field :specific_date, class: "form-control" %>
          </div>
          <div class="col-md-6 mb-2">
            <%= f.label :end_date, "End Date", class: "form-label" %>
            <%= f.date_field :end_date, class: "form-control" %>
            <div class="form-text">Leave blank for a single-day event.</div>
            <% if @recurring_event.errors[:end_date].present? %>
              <div class="text-danger"><%= @recurring_event.errors[:end_date].join(", ") %></div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_time, "Start Time", class: "form-label" %>
      <%= f.text_field :start_time, class: "form-control", placeholder: "HH:MM (e.g. 10:00)" %>
      <% if @recurring_event.errors[:start_time].present? %>
        <div class="text-danger"><%= @recurring_event.errors[:start_time].join(", ") %></div>
      <% end %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :end_time, "End Time", class: "form-label" %>
      <%= f.text_field :end_time, class: "form-control", placeholder: "HH:MM (e.g. 12:00)" %>
      <% if @recurring_event.errors[:end_time].present? %>
        <div class="text-danger"><%= @recurring_event.errors[:end_time].join(", ") %></div>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :capacity, "Capacity (0 = unlimited)", class: "form-label" %>
    <%= f.number_field :capacity, class: "form-control", min: 0, value: @recurring_event.capacity || 0 %>
  </div>

  <div class="mb-3">
    <div class="form-check form-switch">
      <%= f.check_box :active, class: "form-check-input", role: "switch", id: "recurring_event_active" %>
      <%= f.label :active, "Active (visible on public site)", class: "form-check-label", for: "recurring_event_active" %>
    </div>
  </div>

  <div class="mb-3">
    <div class="form-check form-switch">
      <%= f.check_box :hide, class: "form-check-input", role: "switch", id: "recurring_event_hide" %>
      <%= f.label :hide, "Hide (block slot silently — no title or sign-up link shown on calendar)", class: "form-check-label", for: "recurring_event_hide" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :court_ids, "Courts", class: "form-label" %>
    <div class="border rounded p-3">
      <% courts_by_sport = Court.includes(:sport).all.group_by(&:sport) %>
      <div class="row g-3">
        <% courts_by_sport.each do |sport, courts| %>
          <div class="col-md-4">
            <p class="fw-semibold mb-2 text-secondary small text-uppercase"><%= sport&.name %></p>
            <% courts.each do |court| %>
              <div class="form-check">
                <%= check_box_tag "recurring_event[court_ids][]", court.id,
                      @recurring_event.court_ids.include?(court.id),
                      id: "court_#{court.id}", class: "form-check-input" %>
                <%= label_tag "court_#{court.id}", court.name_label, class: "form-check-label" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
      <input type="hidden" name="recurring_event[court_ids][]" value="">
    </div>
    <% if @recurring_event.errors[:courts].present? %>
      <div class="text-danger"><%= @recurring_event.errors[:courts].join(", ") %></div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to 'Cancel', admins_recurring_events_path, class: "btn btn-light" %>
  </div>
<% end %>

<!-- Overlap confirmation modal -->
<div class="modal fade" id="overlapModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title text-warning">Scheduling Conflict Detected</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small mb-2">The following events overlap with the time range you entered:</p>
        <table class="table table-sm table-bordered mb-0" id="overlap-table">
          <thead><tr><th>Type</th><th>Name</th><th>Day</th><th>Time</th></tr></thead>
          <tbody id="overlap-rows"></tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="btn-save-anyway" class="btn btn-warning">Save Anyway</button>
      </div>
    </div>
  </div>
</div>

<%= content_for :tail do %>
  <script src="https://cdn.quilljs.com/1.1.9/quill.js"></script>
  <link href="https://cdn.quilljs.com/1.1.9/quill.snow.css" rel="stylesheet">
<% end %>

<script>
  document.querySelectorAll('input[name="schedule_type"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      document.getElementById('recurring_fields').style.display = this.value === 'recurring' ? '' : 'none';
      document.getElementById('one_time_fields').style.display  = this.value === 'one_time'  ? '' : 'none';
    });
  });

  (function() {
    var overlapConfirmed = false;
    var theForm = document.querySelector('form');

    theForm.addEventListener('submit', function(e) {
      if (overlapConfirmed) return;
      e.preventDefault();

      var courtIds = Array.from(document.querySelectorAll('input[name="recurring_event[court_ids][]"]:checked'))
                          .map(function(el) { return el.value; });
      var schedType = document.querySelector('input[name="schedule_type"]:checked');
      if (!schedType) { theForm.submit(); return; }

      var params = new URLSearchParams();
      courtIds.forEach(function(id) { params.append('court_ids[]', id); });
      params.append('start_time', document.querySelector('[name="recurring_event[start_time]"]').value);
      params.append('end_time',   document.querySelector('[name="recurring_event[end_time]"]').value);
      params.append('exclude_id', '<%= @recurring_event.id.to_s %>');

      if (schedType.value === 'one_time') {
        params.append('specific_date', document.querySelector('[name="recurring_event[specific_date]"]').value);
        var endDateEl = document.querySelector('[name="recurring_event[end_date]"]');
        if (endDateEl && endDateEl.value) params.append('end_date', endDateEl.value);
      } else {
        var dowEl = document.querySelector('[name="recurring_event[day_of_week]"]');
        if (dowEl) params.append('day_of_week', dowEl.value);
      }

      fetch('<%= check_overlaps_admins_recurring_events_path %>?' + params.toString())
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.overlaps && data.overlaps.length > 0) {
            var tbody = document.getElementById('overlap-rows');
            tbody.innerHTML = '';
            data.overlaps.forEach(function(o) {
              tbody.insertAdjacentHTML('beforeend',
                '<tr><td>' + o.type + '</td><td>' + o.name + '</td><td>' + o.day + '</td><td>' + o.time + '</td></tr>');
            });
            new bootstrap.Modal(document.getElementById('overlapModal')).show();
          } else {
            overlapConfirmed = true;
            theForm.submit();
          }
        });
    });

    document.getElementById('btn-save-anyway').addEventListener('click', function() {
      overlapConfirmed = true;
      bootstrap.Modal.getInstance(document.getElementById('overlapModal')).hide();
      theForm.submit();
    });
  })();
</script>
