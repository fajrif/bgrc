<%= form_for(@recurring_event, url: @recurring_event.new_record? ? admins_recurring_events_url : admins_recurring_event_url(@recurring_event), html: { method: @recurring_event.new_record? ? :post : :put, multipart: true }) do |f| %>
  <div class="mb-3">
    <%= f.label :court_id, "Court", class: "form-label" %>
    <%= f.collection_select :court_id, Court.all, :id, :name_label, { include_blank: "Select Court" }, class: "form-select" %>
    <% if @recurring_event.errors[:court_id].present? %>
      <div class="text-danger"><%= @recurring_event.errors[:court_id].join(", ") %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :title, "Title", class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "e.g. Ladies Party Event" %>
    <% if @recurring_event.errors[:title].present? %>
      <div class="text-danger"><%= @recurring_event.errors[:title].join(", ") %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :image, "Event Image", class: "form-label" %>
    <% if @recurring_event.image.attached? %>
      <div class="mb-2">
        <%= image_tag @recurring_event.image.variant(resize_to_fill: [400, 200]), class: "img-thumbnail" %>
      </div>
    <% end %>
    <%= f.file_field :image, class: "form-control", accept: "image/gif,image/png,image/jpg,image/jpeg,image/webp" %>
  </div>

  <div class="mb-3">
    <%= f.label :short_description, "Short Description", class: "form-label" %>
    <%= f.text_area :short_description, class: "form-control", rows: 3, placeholder: "Brief summary shown on listings" %>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description", class: "form-label" %>
    <%= f.text_area :description, class: "form-control quill_container", rows: 6 %>
  </div>

  <div class="card bg-light mb-3">
    <div class="card-body">
      <p class="fw-semibold mb-2">Schedule Type</p>
      <div class="form-check mb-2">
        <input type="radio" name="schedule_type" id="sched_recurring" value="recurring" class="form-check-input"
               <%= @recurring_event.specific_date.blank? ? 'checked' : '' %>>
        <label for="sched_recurring" class="form-check-label">Recurring (every week on a specific day)</label>
      </div>
      <div class="form-check mb-3">
        <input type="radio" name="schedule_type" id="sched_one_time" value="one_time" class="form-check-input"
               <%= @recurring_event.specific_date.present? ? 'checked' : '' %>>
        <label for="sched_one_time" class="form-check-label">One-time (specific date)</label>
      </div>

      <div id="recurring_fields" <%= @recurring_event.specific_date.present? ? 'style="display:none;"' : '' %>>
        <%= f.label :day_of_week, "Day of Week", class: "form-label" %>
        <%= f.select :day_of_week, RecurringEvent.days_for_select, { include_blank: "Select Day" }, class: "form-select mb-0" %>
        <% if @recurring_event.errors[:day_of_week].present? %>
          <div class="text-danger"><%= @recurring_event.errors[:day_of_week].join(", ") %></div>
        <% end %>
      </div>

      <div id="one_time_fields" <%= @recurring_event.specific_date.blank? ? 'style="display:none;"' : '' %>>
        <%= f.label :specific_date, "Event Date", class: "form-label" %>
        <%= f.date_field :specific_date, class: "form-control" %>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_time, "Start Time", class: "form-label" %>
      <%= f.text_field :start_time, class: "form-control", placeholder: "HH:MM (e.g. 10:00)" %>
      <% if @recurring_event.errors[:start_time].present? %>
        <div class="text-danger"><%= @recurring_event.errors[:start_time].join(", ") %></div>
      <% end %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :end_time, "End Time", class: "form-label" %>
      <%= f.text_field :end_time, class: "form-control", placeholder: "HH:MM (e.g. 12:00)" %>
      <% if @recurring_event.errors[:end_time].present? %>
        <div class="text-danger"><%= @recurring_event.errors[:end_time].join(", ") %></div>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :capacity, "Capacity (0 = unlimited)", class: "form-label" %>
    <%= f.number_field :capacity, class: "form-control", min: 0, value: @recurring_event.capacity || 0 %>
  </div>

  <div class="mb-3">
    <div class="form-check form-switch">
      <%= f.check_box :active, class: "form-check-input", role: "switch", id: "recurring_event_active" %>
      <%= f.label :active, "Active (visible on public site)", class: "form-check-label", for: "recurring_event_active" %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit "Save", class: "btn btn-primary" %>
    <%= link_to 'Cancel', admins_recurring_events_path, class: "btn btn-light" %>
  </div>
<% end %>

<%= content_for :tail do %>
  <script src="https://cdn.quilljs.com/1.1.9/quill.js"></script>
  <link href="https://cdn.quilljs.com/1.1.9/quill.snow.css" rel="stylesheet">
<% end %>

<script>
  document.querySelectorAll('input[name="schedule_type"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      document.getElementById('recurring_fields').style.display = this.value === 'recurring' ? '' : 'none';
      document.getElementById('one_time_fields').style.display  = this.value === 'one_time'  ? '' : 'none';
    });
  });
</script>