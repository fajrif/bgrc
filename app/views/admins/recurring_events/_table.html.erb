<div class="table-responsive">
  <table class="table table-hover">
    <thead>
      <tr>
        <th>Court</th>
        <th>Title</th>
        <th>Day</th>
        <th>Time</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @recurring_events.each do |re| %>
        <tr>
          <td><%= re.court.name_label %></td>
          <td><%= re.title %></td>
          <td><%= re.day_name %></td>
          <td><%= re.start_time %> - <%= re.end_time %></td>
          <td>
            <div class="hstack gap-2">
              <%= link_to 'Edit', edit_admins_recurring_event_path(re), class: "btn btn-sm btn-primary" %>
              <%= link_to 'Delete', admins_recurring_event_path(re), class: "btn btn-sm btn-danger", confirm: 'Are you sure?', method: :delete %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @recurring_events.empty? %>
        <tr>
          <td colspan="5" class="text-center text-muted">No recurring events found</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>