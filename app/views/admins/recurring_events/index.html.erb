<% title_page("Recurring Events") %>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
				<%= form_tag admins_recurring_events_url, { :id => "index_search", :method => :get } do %>
					<div class="row g-4 align-items-center">
						<div class="col-md-4">
							<div class="form-icon">
								<%= select_tag :court_id, options_from_collection_for_select(Court.all, "id", "name_label", params[:court_id]), include_blank: "All Courts", class: "form-control form-control-icon" %>
							</div>
						</div>
						<div class="col-sm-auto ms-auto">
							<div class="hstack gap-2">
								<a class="btn btn-success add-btn" href="<%= new_admins_recurring_event_path %>"><i class="ri-add-line align-bottom me-1"></i> Add Recurring Event</a>
							</div>
						</div>
					</div>
				<% end %>
			</div>
			<div id="index_table" class="card-body">
				<%= render 'table' %>
			</div>
		</div>
	</div>
	<!--end col-->
</div>
<!--end row-->