<% title_page(@current_sport ? "#{@current_sport.name} Bookings" : "Bookings", sport_slug: @current_sport&.slug) %>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
				<%= form_tag admins_bookings_url, { :id => "index_search", :method => :get } do %>
					<div class="row g-4 align-items-center">
						<%= hidden_field_tag :sport_slug, params[:sport_slug] if params[:sport_slug].present? %>
						<div class="col-md-4">
							<div class="form-icon">
								<%= text_field_tag :search, params[:search], :class => "form-control form-control-icon", :placeholder => "Search Order ID ..." %>
								<i class="ri-search-line"></i>
							</div>
						</div>
						<div class="col-sm-auto ms-auto">
							<div class="hstack gap-2">
								<%= link_to cashier_booking_admins_bookings_path(sport_slug: params[:sport_slug]), class: "btn btn-success add-btn" do %>
									<i class="ri-cash-line align-bottom me-1"></i> Cashier Booking
								<% end %>
								<div class="dropdown">
									<a href="#" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
										<i class="ri-file-excel-line align-bottom me-1"></i> Export Data
									</a>
									<div class="dropdown-menu" style="">
										<a id="btn-export-page" class="dropdown-item" href="#">Current Page</a>
										<a class="dropdown-item" href="<%= export_all_admins_bookings_path(format: :xls) %>">All Pages</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				<% end %>
			</div>
			<div id="index_table" class="card-body">
				<%= render 'table' %>
			</div>
		</div>
	</div>
	<!--end col-->
</div>
<!--end row-->
