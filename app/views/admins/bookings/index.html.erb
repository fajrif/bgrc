<%= content_for :head do %>
	<%= stylesheet_link_tag "fullcalendar/core/main.min.css" %>
	<%= stylesheet_link_tag "fullcalendar/daygrid/main.min.css" %>
	<%= stylesheet_link_tag "fullcalendar/timegrid/main.min.css" %>
	<%= stylesheet_link_tag "fullcalendar.css" %>
	<style>
		select.form-control {
			width: auto;
			display: inline;
		}
	</style>
<% end %>

<div class="page-bar">
	<div class="page-title-breadcrumb">
		<div class=" pull-left">
			<div class="page-title">Bookings</div>
		</div>
	</div>
</div>
<div class="row">
	<div class="col-md-12 col-sm-12">
		<div class="card card-box">
			<div class="card-body ">
				<div class="row">
					<div class="col-md-7 col-sm-7 col-7">
						<%= form_tag admins_bookings_url, { :method => :get } do %>
							<%= select_tag :court_id, options_from_collection_for_select(@courts, 'id', 'name', @court.id), class: "form-control" %>
							<%= select_tag :month, options_for_select((1..12).map {|m| [Date::MONTHNAMES[m], m]}, @month), class: "form-control" %>
							<%= select_tag :year, options_for_select((Date.today.year-5..Date.today.year+1).to_a.reverse, @year), class: "form-control" %>
							<%= submit_tag "Search", class: "btn btn-warning" %>
						<% end %>
					</div>
					<div class="col-md-5 col-sm-5 col-5">
						<div class="btn-group" style="float:right;">
							<a href="<%= new_admins_booking_path %>" class="btn btn-info">
								Create New <i class="fa fa-plus"></i>
							</a>
							<a href="<%= admins_bookings_path(format: :xls, court_id: params[:court_id], month: params[:month], year: params[:year]) %>" class="btn btn-success">
								Export All <i class="fa fa-book"></i>
							</a>
						</div>
					</div>
				</div>
				<div style="margin-top:20px;">
					<div id="calendar" class="has-toolbar"></div>
				</div>
			</div>
		</div>
	</div>
</div>
<div class="row">
	<div class="col-md-12 col-sm-12">
		<div class="card card-box">
			<div class="card-body">
				<div class="table-wrap" style="margin-top:20px;">
					<div id="index_table" class="table-responsive">
						<%= render 'table' %>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<%= content_for :tail do %>
	<%= javascript_include_tag "fullcalendar/core/main.min.js" %>
	<%= javascript_include_tag "fullcalendar/interaction/main.min.js" %>
	<%= javascript_include_tag "fullcalendar/daygrid/main.min.js" %>
	<%= javascript_include_tag "fullcalendar/timegrid/main.min.js" %>
	<script>
		let calendar;
		let date_picker;

		var date = new Date();
		var day = date.getDate();
		var month = date.getMonth();
		var year = date.getFullYear();

		$(document).ready(function () {
			initCalendar();
		});

		function initCalendar() {
			var calendarEl = $("#calendar").get(0);
			calendar = new FullCalendar.Calendar(calendarEl, {
				plugins: ["interaction", "dayGrid", "timeGrid"],
				header: {
					left: "",
					center: "title",
					right: "dayGridMonth,timeGridWeek,timeGridDay"
				},
				defaultDate: '<%= "#{@year}-#{@month.to_s.rjust(2, '0')}-01" %>',
				editable: false,
				droppable: false,
				navLinks: true,
				eventLimit: true,
				weekNumberCalculation: "ISO",
				displayEventEnd: true,
				lazyFetching: true,
				selectable: true,
				views: {
					dayGridMonth: {
						eventLimit: 4,
					}
				},
				events: <%= @events.html_safe %>,
				eventClick: function (info) {
					var eventObj = info.event;
					window.open(eventObj.url);
					info.jsEvent.preventDefault();
				}
			});
			calendar.render();
		}
	</script>
<% end %>
