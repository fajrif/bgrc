<% title_page("Bookings Calendar") %>
<div class="row">
    <div class="col-12">
        <div class="row">
            <div class="col-xl-3">
                <div class="card card-h-100">
                    <div class="card-body">
                        <a href="<%= cashier_booking_admins_bookings_path %>" class="btn btn-primary w-100"><i class="mdi mdi-plus"></i> Create New Booking</a>
                        <div>
                            <br/>
                            <p class="text-muted">Search by Court and Dates</p>
                            <%= form_tag calendar_admins_bookings_url, { :method => :get } do %>
                              <div class="form-search">
                                <%= select_tag :court_id, options_from_collection_for_select(@courts, 'id', 'name_label', @court.id), class: "form-select mb-2" %>
                                <%= select_tag :month, options_for_select((1..12).map {|m| [Date::MONTHNAMES[m], m]}, @month), class: "form-select mb-2" %>
                                <%= select_tag :year, options_for_select((Date.today.year-5..Date.today.year+1).to_a.reverse, @year), class: "form-select mb-2" %>
                                <div class="text-center">
                                  <%= submit_tag "Search", class: "btn btn-soft-primary" %>
                                </div>
                              </div>
                            <% end %>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title mb-3">Color Legend</h6>
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-success me-2">&nbsp;&nbsp;&nbsp;</span>
                            <span class="small">Booked &amp; Paid</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-warning me-2">&nbsp;&nbsp;&nbsp;</span>
                            <span class="small">Awaiting Payment</span>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-danger me-2">&nbsp;&nbsp;&nbsp;</span>
                            <span class="small">Blocked / Recurring Event</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="badge bg-secondary me-2">&nbsp;&nbsp;&nbsp;</span>
                            <span class="small">Cancelled / Expired</span>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-body bg-info-subtle">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i data-feather="calendar" class="text-info icon-dual-info"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h6 class="fs-15">Booking Calendar Tips</h6>
                                <p class="text-muted mb-0">Click on an empty slot to create a cashier booking. Drag an existing booking to reschedule it.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div> <!-- end col-->

            <div class="col-xl-9">
                <div class="card card-h-100">
                    <div class="card-body">
                        <div id="reschedule-toast" class="alert alert-danger d-none mb-2" role="alert"></div>
                        <div id="calendar"></div>
                    </div>
                </div>
            </div><!-- end col -->
        </div>
        <!--end row-->

        <div style='clear:both'></div>
    </div>
</div> <!-- end row-->
<%= content_for :tail do %>
	<%= javascript_include_tag 'admin/fullcalendar/index.global.min.js' %>
	<%= javascript_include_tag 'admin/calendar.init.js' %>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
        var defaultEvents = <%= @events.html_safe %>;
        var courtId = <%= @court.id %>;
        var cashierBookingUrl = "<%= cashier_booking_admins_bookings_path %>";

        var calendarEl = document.getElementById('calendar');

        function getInitialView() {
            if (window.innerWidth >= 768 && window.innerWidth < 1200) {
                return 'timeGridWeek';
            } else if (window.innerWidth <= 768) {
                return 'listMonth';
            } else {
                return 'dayGridMonth';
            }
        }

        var calendar = new FullCalendar.Calendar(calendarEl, {
            timeZone: 'local',
            editable: true,
            droppable: true,
            selectable: true,
            navLinks: true,
            initialView: getInitialView(),
            themeSystem: 'bootstrap',
            headerToolbar: {
                left: 'title',
                right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
            },
            windowResize: function (view) {
                var newView = getInitialView();
                calendar.changeView(newView);
            },
            events: defaultEvents,

            select: function(info) {
                var start = info.startStr.replace('T', ' ').substring(0, 16);
                var url = cashierBookingUrl + "?date=" + encodeURIComponent(start) + "&court_id=" + courtId;
                window.location.href = url;
            },

            eventDrop: function(info) {
                rescheduleBooking(info.event, info.revert);
            },

            eventResize: function(info) {
                rescheduleBooking(info.event, info.revert);
            },
        });

        calendar.render();

        function rescheduleBooking(event, revert) {
            if (!event.id) { revert(); return; }
            fetch("/admins/bookings/" + event.id + "/reschedule", {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json",
                    "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
                },
                body: JSON.stringify({ start: event.startStr, end: event.endStr })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.error) {
                    document.getElementById('reschedule-toast').textContent = data.error;
                    document.getElementById('reschedule-toast').classList.remove('d-none');
                    setTimeout(function() {
                        document.getElementById('reschedule-toast').classList.add('d-none');
                    }, 4000);
                    revert();
                }
            })
            .catch(function() { revert(); });
        }
    });
  </script>

  <style>
    .form-search .choices {
      margin-bottom: 18px;
    }
    .fc-bg-event.bg-danger { opacity: 0.25; }
  </style>
<% end %>
