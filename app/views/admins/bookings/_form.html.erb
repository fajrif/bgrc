<%= simple_form_for @booking, url: (@booking.new_record? ? admins_bookings_path : admins_booking_path(@booking.id)), method: (@booking.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.association :user, as: :select %>
						<%= f.association :court, as: :select %>
            <div class="row">
              <div class="col-md-6">
                <%= f.input :date, as: :string, label: "Start Date", input_html: { class: "datetimepicker", value: get_input_date_value(f.object.date) } %>
              </div>
              <div class="col-md-6">
                <%= f.input :end_date, as: :string, input_html: { class: "datetimepicker", value: get_input_date_value(f.object.end_date) } %>
              </div>
            </div>
            <div class="row mb-2">
              <div class="col-md-6">
                <%= f.input :court_type, as: :select, collection: options_select_court %>
              </div>
              <div class="col-md-6">
                <%= f.input :class_type, as: :select, collection: options_select_class %>
              </div>
            </div>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @booking.new_record? %>
							<%= link_to "Cancel", admins_booking_path(@booking.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_bookings_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @booking, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Payment Status</h5>
						</div>
						<div class="card-body">
              <% unless @booking.purchase %>
                <%= f.input :status, as: :select, collection: [[0, 'Unpaid'], [1, 'Paid']], value_method: :first, label_method: :last %>
              <% else %>
                <div class="mb-3">
                  <label class="form-label select optional">Purchase ID</label>
                  <div>
                    <%= @booking.try(:purchase).try(:transaction_id) %>
                  </div>
                </div>
                <div class="mb-3">
                  <label class="form-label select optional">Status</label>
                  <div>
                    <span class="<%= @booking.is_unpaid? ? 'text-danger' : 'text-success' %>"><%= @booking.status_label %></span>
                  </div>
                </div>
              <% end %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
