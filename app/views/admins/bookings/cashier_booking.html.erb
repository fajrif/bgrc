<% title_page(@current_sport ? "Cashier Booking — #{@current_sport.name}" : "Cashier Booking", sport_slug: @current_sport&.slug) %>
<div class="row">
  <div class="col-md-8 col-lg-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0"><%= @current_sport ? "#{@current_sport.name} Cashier Booking" : "Cashier Booking" %></h5>
        <small class="text-muted">Booking will be immediately marked as Paid.</small>
      </div>
      <div class="card-body">
        <%= form_for @booking, url: create_cashier_booking_admins_bookings_path, method: :post do |f| %>
          <%= f.hidden_field :court_type, value: 0 %>
          <%= hidden_field_tag :sport_slug, params[:sport_slug] if params[:sport_slug].present? %>

          <div class="mb-3">
            <label class="form-label">Court</label>
            <%= f.collection_select :court_id, @courts, :id, :name_label, { include_blank: "Select Court" }, class: "form-select", id: "cashier_court_id" %>
          </div>

          <div class="mb-3">
            <label class="form-label">User</label>
            <%= f.collection_select :user_id, @users, :id, :name_with_email, { include_blank: "Select User" }, class: "form-select" %>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Start Date & Time</label>
              <%= f.text_field :date, class: "form-control datetimepicker", placeholder: "Select date and time", id: "cashier_date", value: get_input_date_value(f.object.date) %>
            </div>
            <div class="col-md-6">
              <label class="form-label">Duration (hours)</label>
              <%= f.number_field :duration, class: "form-control", value: 1, min: 1, max: 6, id: "cashier_duration" %>
            </div>
          </div>

          <div id="slot-conflict-alert" class="alert alert-warning d-none mb-3">
            <strong>&#9888; Double Booking Warning</strong>
            <div id="slot-conflict-details" class="mt-1 small"></div>
          </div>

          <div class="mb-3">
            <label class="form-label">Pax (number of people)</label>
            <%= f.number_field :pax, class: "form-control", value: 1, min: 1, max: 8 %>
          </div>

          <div class="d-flex gap-2">
            <%= f.submit "Create Booking & Payment", class: "btn btn-success", id: "cashier-submit-btn" %>
            <%= link_to "Cancel", admins_bookings_path(sport_slug: params[:sport_slug]), class: "btn btn-light" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%= content_for :tail do %>
<script>
  jQuery(document).ready(function($){
    $(".datetimepicker").flatpickr({"altInput":true, "altFormat": "d/m/Y H:i", "enableTime": true, "minuteIncrement": 15, "disableMobile":true, "dateFormat":"d/m/Y H:i"});

    function checkSlotAvailability() {
      var courtId  = $("#cashier_court_id").val();
      var dateVal  = $("#cashier_date").val();
      var duration = $("#cashier_duration").val();
      if (!courtId || !dateVal || !duration) return;

      $.ajax({
        url: "<%= check_slot_admins_bookings_path %>",
        data: { court_id: courtId, date: dateVal, duration: duration },
        success: function(data) {
          if (!data.available && data.conflicts.length > 0) {
            var html = data.conflicts.map(function(c) {
              return c.user_name + " &mdash; " + c.order_id + " (" + c.start + ", " + c.duration + "h)";
            }).join("<br>");
            $("#slot-conflict-details").html(html);
            $("#slot-conflict-alert").removeClass("d-none");
            $("#cashier-submit-btn").removeClass("btn-success").addClass("btn-warning");
          } else {
            $("#slot-conflict-alert").addClass("d-none");
            $("#cashier-submit-btn").removeClass("btn-warning").addClass("btn-success");
          }
        }
      });
    }

    $("#cashier_court_id, #cashier_duration").on("change", checkSlotAvailability);
    $("#cashier_date").on("change", function() { setTimeout(checkSlotAvailability, 100); });
  });
</script>
<% end %>