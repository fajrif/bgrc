<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @menu.id %></td>
	</tr>
	<% if @menu.image.attached? %>
	<tr>
		<td><b>Image</b></td>
		<td>
			<%= image_tag @menu.image.variant(resize_to_limit: [100,100]) %>
		</td>
	</tr>
	<% end %>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @menu.name %></h5></td>
	</tr>
	<tr>
		<td><b>Short Description</b></td>
		<td><%= @menu.short_description %></td>
	</tr>
	<tr>
		<td><b>Restaurant</b></td>
		<td><%= blank_or_not(@menu.restaurant&.name) %></td>
	</tr>
	<tr>
		<td><b>Position</b></td>
		<td><%= @menu.position %></td>
	</tr>
</table>
