<%= simple_form_for @menu, url: (@menu.new_record? ? admins_menus_path : admins_menu_path(@menu.id)), method: (@menu.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :image, as: :file, input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :name, as: :string %>
						<%= f.input :short_description, as: :text, input_html: { rows: 4 } %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @menu.new_record? %>
							<%= link_to "Cancel", admins_menu_path(@menu.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_menus_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @menu, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.association :restaurant, include_blank: "— none —" %>
							<%= f.input :position, as: :integer %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
