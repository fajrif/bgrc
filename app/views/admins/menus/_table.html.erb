<div class="table-card">
	<table class="table table-hover table-striped align-middle mb-0">
		<thead class="table-light">
			<tr>
				<th class="text-center">ID</th>
				<th>Photo</th>
				<th>Name</th>
				<th>Restaurant</th>
				<th>Category</th>
				<th>Price</th>
				<th>Stock</th>
				<th>Position</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			<% for menu in @menus %>
				<tr>
					<td class="text-center"><%= menu.id %></td>
					<td><%= image_tag menu.image.variant(resize_to_limit: [100,100]) if menu.image.attached? %></td>
					<td>
						<h5 class="fs-14 mb-1"><%= link_to menu.name, admins_menu_path(menu.id), class: "text-body" %></h5>
						<p class="text-muted mb-0"><%= menu.short_description.to_s.truncate(60) %></p>
					</td>
					<td><%= blank_or_not(menu.restaurant&.name) %></td>
					<td><%= blank_or_not(menu.menu_category&.name) %></td>
					<td>
						<%= menu.price_label %>
						<% if menu.discounted? %>
							<br/><del class="text-muted fs-12"><%= menu.original_price_label %></del>
						<% end %>
					</td>
					<td>
						<% if menu.orderable? %>
							<span class="badge <%= menu.available? ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger" %>"><%= menu.stock_label %></span>
						<% else %>
							<span class="badge bg-secondary-subtle text-secondary">Not orderable</span>
						<% end %>
					</td>
					<td><%= menu.position %></td>
					<td>
						<div class="dropdown">
							<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="ri-more-fill"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end">
								<li>
									<%= link_to admins_menu_path(menu.id), class: "dropdown-item" do %>
										<i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
									<% end %>
								</li>
								<li>
									<%= link_to edit_admins_menu_path(menu.id), class: "dropdown-item edit-list" do %>
										<i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit
									<% end %>
								</li>
								<li class="dropdown-divider"></li>
								<li>
									<%= link_to admins_menu_path(menu.id), :data => { :confirm => 'Are you sure?' }, :method => :delete, class: "dropdown-item remove-list" do %>
										<i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
									<% end %>
								</li>
							</ul>
						</div>
					</td>
				</tr>
			<% end %>
		</tbody>
	</table>
</div>
<!-- pagination -->
<%= paginate @menus %>
