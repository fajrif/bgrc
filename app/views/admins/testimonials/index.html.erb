<% title_page("Testimonials") %>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
				<%= form_tag admins_testimonials_url, { :id => "index_search", :method => :get } do %>
					<div class="row g-4 align-items-center">
						<div class="col-sm-auto ms-auto">
							<div class="hstack gap-2">
								<a class="btn btn-success add-btn" href="<%= new_admins_testimonial_path %>"><i class="ri-add-line align-bottom me-1"></i> Add testimonial</a>
							</div>
						</div>
					</div>
				<% end %>
			</div>
			<div id="index_table" class="card-body">
				<%= render 'table' %>
			</div>
		</div>
	</div>
	<!--end col-->
</div>
<!--end row-->
