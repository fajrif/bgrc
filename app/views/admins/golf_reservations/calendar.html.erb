<% title_page("Golf Reservations Calendar") %>
<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header">
        <div class="d-flex align-items-center gap-3">
          <%= link_to "< Prev", calendar_admins_golf_reservations_path(month: @month.to_i == 1 ? 12 : @month.to_i - 1, year: @month.to_i == 1 ? @year.to_i - 1 : @year), class: "btn btn-sm btn-secondary" %>
          <strong><%= Date::MONTHNAMES[@month.to_i] %> <%= @year %></strong>
          <%= link_to "Next >", calendar_admins_golf_reservations_path(month: @month.to_i == 12 ? 1 : @month.to_i + 1, year: @month.to_i == 12 ? @year.to_i + 1 : @year), class: "btn btn-sm btn-secondary" %>
        </div>
      </div>
      <div class="card-body">
        <div id="golf-calendar"></div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  if (typeof FullCalendar === 'undefined') return;
  var calendarEl = document.getElementById('golf-calendar');
  var calendar = new FullCalendar.Calendar(calendarEl, {
    initialView: 'dayGridMonth',
    initialDate: '<%= "#{@year}-#{@month.to_s.rjust(2, '0')}-01" %>',
    events: <%= @events.html_safe %>,
    eventClick: function(info) {
      if (info.event.url) { window.location.href = info.event.url; info.jsEvent.preventDefault(); }
    }
  });
  calendar.render();
});
</script>
