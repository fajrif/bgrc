<% title_page("Promo Details") %>
<div class="row">
	<div class="col-md-12 col-sm-12">
		<div class="card card-box">
			<div class="card-body">
        <div>
          <%= render "details" %>
        </div>
				<div class="form-actions">
					<%= link_to 'Edit', edit_admins_promo_path(@promo.id), :class => 'btn btn-secondary' %>
					<%= link_to 'Destroy', admins_promo_path(@promo.id), :confirm => 'Are you sure?', :method => :delete, :class => 'btn btn-danger' %>
					<%= link_to 'View All', admins_promos_path, :class => 'btn btn-light' %>
				</div>
			</div>
		</div>
	</div>
</div>
