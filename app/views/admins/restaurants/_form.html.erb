<%= simple_form_for @restaurant, url: (@restaurant.new_record? ? admins_restaurants_path : admins_restaurant_path(@restaurant.id)), method: (@restaurant.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :banner, as: :file, label: "Banner (page hero)", input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :banner_description, as: :text, label: "Banner Description", hint: "Shown under the title on the hero banner", input_html: { rows: 2 } %>
						<%= f.input :middle_banner, as: :file, label: "Middle Banner", input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :image, as: :file, label: "Image (shown beside the description)", input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp" } %>
						<%= f.input :images, as: :file, label: "Image Gallery", input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp", multiple: true } %>
						<%= f.input :name, as: :string %>
						<%= f.input :short_description, as: :text, hint: "Used on the Dining index and homepage hover cards" %>
						<%= f.input :description, as: :text, hint: "The intro lead paragraph shown at the top of the page" %>
						<%= f.input :description1, as: :text, label: "Description (two-column text section)", hint: "Split into two paragraphs with a blank line between them", input_html: { rows: 4 } %>
						<%= f.input :description2, as: :text, label: "Description (paired with the image)", input_html: { rows: 4 } %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @restaurant.new_record? %>
							<%= link_to "Cancel", admins_restaurant_path(@restaurant.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_restaurants_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @restaurant, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.input :position, as: :integer %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
