<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @adult_social.id %></td>
	</tr>
	<tr>
		<td><b>Title</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @adult_social.title %></h5></td>
	</tr>
	<tr>
		<td><b>Short Description</b></td>
		<td><%= @adult_social.short_description %></td>
	</tr>
	<tr>
		<td><b>Description</b></td>
		<td><%= @adult_social.description %></td>
	</tr>
	<tr>
		<td><b>Sport</b></td>
    <td><%= @adult_social.try(:sport).try(:name) %></td>
	</tr>
	<tr>
		<td><b>Start Date</b></td>
		<td><%= @adult_social.start_date.strftime('%d/%m/%Y %H:%M') %></td>
	</tr>
	<tr>
		<td><b>Duration</b></td>
    <td><%= @adult_social.duration %></td>
	</tr>
	<tr>
		<td><b>Price</b></td>
    <td><%= @adult_social.price_label %></td>
	</tr>
	<tr>
		<td><b>Size</b></td>
    <td><%= @adult_social.size %></td>
	</tr>
	<tr>
		<td><b>Gender</b></td>
    <td><%= @adult_social.gender_label %></td>
	</tr>
	<tr>
		<td><b>Invitation Only</b></td>
    <td><%= @adult_social.is_invitation_only? ? 'Yes' : 'No' %></td>
	</tr>
</table>
