<%= simple_form_for @adult_social, url: (@adult_social.new_record? ? admins_adult_socials_path : admins_adult_social_path(@adult_social.id)), method: (@adult_social.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :title, as: :string %>
						<%= f.input :short_description, as: :text %>
						<%= f.input :description, as: :text %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @adult_social.new_record? %>
							<%= link_to "Cancel", admins_adult_social_path(@adult_social.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_adult_socials_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @adult_social, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
							<%= f.association :sport, as: :select %>
							<%= f.input :start_date, as: :string, input_html: { class: "datetimepicker", value: get_input_date_value(f.object.start_date) } %>
              <%= f.input :price %>
              <%= f.input :duration %>
              <%= f.input :size %>
              <%= f.input :gender, as: :select, collection: [[0, 'All'], [1, 'Male'], [2, 'Female']], label_method: :second, value_method: :first %>
              <%= f.input :invitation_only, as: :select, collection: [[0, 'No'], [1, 'Yes']], label_method: :second, value_method: :first %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
