<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @amenity.id %></td>
	</tr>
	<% if @amenity.image.attached? %>
	<tr>
		<td><b>Image</b></td>
		<td>
			<%= image_tag @amenity.image.variant(resize_to_limit: [100,100]) %>
		</td>
	</tr>
	<% end %>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @amenity.name %></h5></td>
	</tr>
	<tr>
		<td><b>Short Description</b></td>
		<td><%= @amenity.short_description %></td>
	</tr>
	<tr>
		<td><b>Facility</b></td>
		<td><%= blank_or_not(@amenity.facility&.name) %></td>
	</tr>
	<tr>
		<td><b>Position</b></td>
		<td><%= @amenity.position %></td>
	</tr>
</table>
