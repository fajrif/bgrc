<div class="table-responsive">
  <table class="table table-hover align-middle">
    <thead>
      <tr>
        <th>#</th>
        <th>Event</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>Gender</th>
        <th>Registered</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @event_rsvps.each do |rsvp| %>
        <tr>
          <td><%= rsvp.id %></td>
          <td>
            <% if rsvp.recurring_event %>
              <%= link_to rsvp.recurring_event.title, admins_recurring_event_path(rsvp.recurring_event), class: "text-body fw-semibold" %>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <td><%= rsvp.full_name %></td>
          <td><%= rsvp.email %></td>
          <td><%= rsvp.phone.presence || "—" %></td>
          <td><%= rsvp.gender.presence || "—" %></td>
          <td class="text-muted text-small"><%= rsvp.created_at.strftime("%d %b %Y") %></td>
          <td>
            <div class="hstack gap-2">
              <%= link_to "View", admins_event_rsvp_path(rsvp), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Delete", admins_event_rsvp_path(rsvp), method: :delete, confirm: "Delete this RSVP?", class: "btn btn-sm btn-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @event_rsvps.empty? %>
        <tr>
          <td colspan="8" class="text-center text-muted py-4">No RSVPs found.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= paginate @event_rsvps %>
