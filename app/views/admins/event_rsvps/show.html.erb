<% title_page("RSVP Details") %>
<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <table class="table table-hover">
          <tr>
            <td style="width:35%;"><b>Event</b></td>
            <td>
              <% if @event_rsvp.recurring_event %>
                <%= link_to @event_rsvp.recurring_event.title, admins_recurring_event_path(@event_rsvp.recurring_event) %>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
          </tr>
          <tr>
            <td><b>Full Name</b></td>
            <td><%= @event_rsvp.full_name %></td>
          </tr>
          <tr>
            <td><b>Email</b></td>
            <td><%= @event_rsvp.email %></td>
          </tr>
          <tr>
            <td><b>Phone</b></td>
            <td><%= @event_rsvp.phone.presence || "—" %></td>
          </tr>
          <tr>
            <td><b>Date of Birth</b></td>
            <td><%= @event_rsvp.dob&.strftime("%d %b %Y") || "—" %></td>
          </tr>
          <tr>
            <td><b>Gender</b></td>
            <td><%= @event_rsvp.gender.presence || "—" %></td>
          </tr>
          <tr>
            <td><b>Address</b></td>
            <td><%= @event_rsvp.address.presence || "—" %></td>
          </tr>
          <tr>
            <td><b>Registered At</b></td>
            <td><%= @event_rsvp.created_at.strftime("%d %b %Y %H:%M") %></td>
          </tr>
        </table>
        <div class="form-actions">
          <%= link_to "Delete", admins_event_rsvp_path(@event_rsvp), method: :delete, confirm: "Delete this RSVP?", class: "btn btn-danger" %>
          <%= link_to "Back to List", admins_event_rsvps_path, class: "btn btn-light" %>
        </div>
      </div>
    </div>
  </div>
</div>
