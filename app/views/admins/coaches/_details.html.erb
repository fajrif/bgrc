<table class="table table-hover">
	<tr>
		<td style="width:15%;"><b>ID</b></td>
		<td><%= @coach.id %></td>
	</tr>
	<% if @coach.photo.attached? %>
	<tr>
		<td><b>photo</b></td>
		<td>
			<%= image_tag @coach.photo.variant(resize_to_limit: [100,100]) %>
		</td>
	</tr>
	<% end %>
	<tr>
		<td><b>Name</b></td>
		<td><h5 class="fs-14 mb-0 text-body"><%= @coach.name %></h5></td>
	</tr>
	<tr>
		<td><b>Email</b></td>
		<td><%= @coach.email %></td>
	</tr>
	<tr>
		<td><b>Phone</b></td>
		<td><%= @coach.phone %></td>
	</tr>
	<tr>
		<td><b>Gender</b></td>
    <td><%= @coach.gender_label %></td>
	</tr>
	<tr>
		<td><b>Level</b></td>
    <% level_color = { Coach::BEGINNER => "success", Coach::INTERMEDIATE => "info", Coach::PRO => "warning" }[@coach.level] %>
    <td><span class="badge bg-<%= level_color %>-subtle text-<%= level_color %>"><%= @coach.level_label %></span></td>
	</tr>
	<tr>
		<td><b>Price</b></td>
    <td><%= @coach.price_label %></td>
	</tr>
</table>
