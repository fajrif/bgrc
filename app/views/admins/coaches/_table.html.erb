<div class="table-card">
	<table class="table table-hover table-striped align-middle mb-0">
		<thead class="table-light">
			<tr>
				<th class="text-center">ID</th>
				<th>Photo</th>
				<th>Name</th>
				<th>Sport</th>
				<th>Contact</th>
				<th>Price</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			<% for coach in @coaches %>
				<tr>
					<td class="text-center"><%= coach.id %></td>
					<td><%= image_tag coach.photo.variant(resize_to_limit: [100,100]) if coach.photo.attached? %></td>
					<td>
						<h5 class="fs-14 mb-1"><%= link_to coach.name, admins_coach_path(coach.id), class: "text-body" %></h5>
						<p class="text-muted mb-0"><%= coach.role %></p>
					</td>
					<td><%= blank_or_not(coach.sport&.name) %></td>
					<td>
            <p class="text-muted mb-0">Email : <%= coach.email %></p>
						<p class="text-muted mb-0">Phone : <%= coach.phone %></p>
					</td>
					<td>
            <%= coach.price_label %>
					</td>
					<td>
						<div class="dropdown">
							<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="ri-more-fill"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end">
								<li>
									<%= link_to admins_coach_path(coach.id), class: "dropdown-item" do %>
										<i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
									<% end %>
								</li>
								<li>
									<%= link_to edit_admins_coach_path(coach.id), class: "dropdown-item edit-list" do %>
										<i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit
									<% end %>
								</li>
								<li class="dropdown-divider"></li>
								<li>
									<%= link_to admins_coach_path(coach.id), :data => { :confirm => 'Are you sure?' }, :method => :delete, class: "dropdown-item remove-list" do %>
										<i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
									<% end %>
								</li>
							</ul>
						</div>
					</td>
				</tr>
			<% end %>
		</tbody>
	</table>
</div>
<!-- pagination -->
<%= paginate @coaches %>
