<div class="table-card">
  <table class="table table-hover table-striped align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th>Day</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Price</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="costs" >
      <% @costs.each do |cost| %>
        <%= render 'cost', cost: cost %>
      <% end %>
    </tbody>
  </table>
</div>
