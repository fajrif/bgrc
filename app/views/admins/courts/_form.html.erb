<%= simple_form_for @court, url: (@court.new_record? ? admins_courts_path : admins_court_path(@court.id)), method: (@court.new_record? ? :post : :put) do |f| %>
	<div class="row">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<%= f.error_notification %>
					<fieldset>
						<%= f.input :images, as: :file, input_html: { class: "mb-3", accept: "image/gif, image/png, image/jpg, image/jpeg, image/webp", multiple: true } %>
						<%= f.input :name, as: :string %>
            <%= f.input :info, as: :text %>
            <%= f.input :instructions, as: :text %>
            <%= f.input :description, as: :text, input_html: { rows: "20" } %>
            <%= f.input :location, as: :string %>
            <%= f.input :address, as: :text %>
					</fieldset>
					<%= f.error :base %>
					<div class="form-actions">
						<%= f.button :submit, :class => 'btn btn-secondary' %>
						<% unless @court.new_record? %>
							<%= link_to "Cancel", admins_court_path(@court.id), :class => 'btn btn-light' %>
						<% else %>
							<%= link_to "Cancel", admins_courts_path, :class => 'btn btn-light' %>
						<% end %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="row">
				<%= render "admins/shared/error_messages", :target => @court, col: 'col-lg-12' %>
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<h5 class="card-title mb-0">Settings</h5>
						</div>
						<div class="card-body">
              <%= f.association :sport, as: :select %>
              <%= f.input :price %>
              <%= f.input :min_duration %>
              <%= f.input :status, as: :select, collection: [[0, 'Available'], [1, 'Not Available']], label_method: :second, value_method: :first, include_blank: false %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<% end %>
