<tr id="business_hour_<%= business_hour.id %>">
	<td><strong><%= business_hour.day_name %></strong></td>
	<td><%= business_hour.open %></td>
	<td><%= business_hour.close %></td>
	<td>
    <div class="dropdown">
      <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="ri-more-fill"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <%= link_to edit_admins_court_business_hour_path(business_hour.court.id, business_hour), :class => "dropdown-item edit-list", :id => "btn_edit_#{business_hour.id}", :remote => true do %>
            <i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit
          <% end %>
        </li>
        <li class="dropdown-divider"></li>
        <li>
          <%= link_to admins_court_business_hour_path(business_hour.court.id, business_hour), class: "dropdown-item remove-list", :data => { :confirm => 'Are you sure?' }, :method => :delete, :remote => true do %>
            <i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
          <% end %>
        </li>
      </ul>
    </div>
	</td>
</tr>
