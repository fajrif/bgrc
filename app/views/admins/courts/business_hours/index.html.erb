<% title_page("business hours - #{@court.name_label}") %>
<div class="row">
	<div class="col-lg-12">
		<div class="card">
			<div class="card-header border-0">
					<div class="row g-4 align-items-center">
						<div class="col-sm-auto ms-auto">
							<div class="hstack gap-2">
                <%= link_to new_admins_court_business_hour_path(@court.id), class: "btn btn-success add-btn #{'disabled' unless @business_hours.size < 7}", :id => "btn_create", :remote => true do %>
                  <i class="ri-add-line align-bottom me-1"></i> Add New
                <% end %>
                <%= link_to 'Back', admins_court_path(@court), class: 'btn btn-secondary' %>
							</div>
						</div>
					</div>
			</div>
      <div id="new-form-placeholder"></div>
			<div id="index_table" class="card-body">
				<%= render 'table' %>
			</div>
		</div>
	</div>
	<!--end col-->
</div>
<!--end row-->
