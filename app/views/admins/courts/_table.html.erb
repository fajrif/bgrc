<div class="table-card">
  <table class="table table-hover table-striped align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th class="text-center">ID</th>
        <th>Name</th>
        <th>Sport</th>
        <th>Type</th>
        <th>Location</th>
        <th>Price</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for court in @courts %>
        <tr>
					<td class="text-center"><%= court.id %></td>
          <td><strong><%= link_to court.name, admins_court_path(court) %></strong></td>
          <td><%= court.sport&.name %></td>
          <td><%= court.court_type&.name %></td>
          <td><%= court.location %></td>
          <td><%= court.price_label %></td>
          <td>
						<div class="dropdown">
							<button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="ri-more-fill"></i>
							</button>
							<ul class="dropdown-menu dropdown-menu-end">
								<li>
									<%= link_to admins_court_path(court.id), class: "dropdown-item" do %>
										<i class="ri-eye-fill align-bottom me-2 text-muted"></i> View
									<% end %>
								</li>
								<li>
									<%= link_to edit_admins_court_path(court.id), class: "dropdown-item edit-list" do %>
										<i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit
									<% end %>
								</li>
								<li class="dropdown-divider"></li>
								<li>
									<%= link_to admins_court_path(court.id), :data => { :confirm => 'Are you sure?' }, :method => :delete, class: "dropdown-item remove-list" do %>
										<i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i> Delete
									<% end %>
								</li>
							</ul>
						</div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= paginate @courts %>
