<%= render "home/banner" %>
<!-- start story section -->
<section class="pb-0 wow animate__fadeIn">
    <div class="container">
        <div class="row align-items-start mb-4">
            <div class="col-12 col-lg-10 col-md-10 text-center text-md-start padding-three-lr wow animate__fadeInLeft" data-wow-delay="0.1s">
              <h5 class="alt-font text-extra-dark-gray mb-4">BBCC <%= @sport.name.upcase %> COURSE</h5>
              <p><%= @sport.short_description %></p>
            </div>
        </div>
    </div>
</section>
<!-- end story section -->

<% if @group_classes.any? %>
<section class="pt-5 pb-5">
  <div class="container">
    <div class="row mb-4">
      <div class="col-12 text-center">
        <h5 class="alt-font text-extra-dark-gray"><%= @sport.name %> Classes</h5>
      </div>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @group_classes.each do |gc| %>
        <div class="col">
          <div class="card h-100 border-1">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-secondary text-uppercase letter-spacing-1" style="font-size:0.65rem;"><%= gc.category_label %></span>
              </div>
              <h6 class="alt-font text-extra-dark-gray mb-2"><%= gc.name %></h6>
              <p class="text-medium text-small mb-3">
                <strong>Duration:</strong> <%= gc.duration_label %> &nbsp;&middot;&nbsp;
                <strong>Pax:</strong> <%= gc.min_pax == gc.max_pax ? "#{gc.min_pax} pax" : "#{gc.min_pax}–#{gc.max_pax} pax" %>
              </p>
              <p class="font-weight-600 mb-1">
                From <%= gc.check_price(gc.min_pax) %>
                <% if gc.has_additional_pax? %>
                  <span class="text-small text-medium">(+<%= gc.price_pax_label %>)</span>
                <% end %>
              </p>
              <% if gc.notes.present? %>
                <p class="text-small text-medium-gray mb-3"><%= gc.notes %></p>
              <% end %>
            </div>
            <div class="card-footer bg-white border-0 p-4 pt-0">
              <%= link_to "View &amp; Register".html_safe, group_class_path(gc), class: "btn btn-dark btn-small w-100 text-uppercase letter-spacing-1 text-extra-small text-white" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<%= render "gallery" unless @sport.images.empty? %>
