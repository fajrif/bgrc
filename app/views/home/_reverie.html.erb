<%
  treatments = [
    ["Deep Tissue Massage", "Firm pressure that releases deep muscle tension."],
    ["Hot Stone Massage", "Heated stones melt away stress and stiffness."],
    ["Body Wrap", "A nourishing wrap that leaves skin soft and renewed."],
    ["Aromatherapy", "Essential oils chosen to calm the mind and body."]
  ]
%>
<!-- start reverie spa -->
<section class="bbcc-reverie">
    <div class="bbcc-reverie-banner" style="background-image:url('<%= image_url('new-design/spa/banner.png') %>');">
        <div class="container-lg">
            <div class="bbcc-reverie-copy">
                <h2 class="bbcc-title-lg">Reverie Spa</h2>
                <p>Unwind with restorative treatments, led by skilled therapists in a space made for calm.</p>
                <%= link_to "Discover more", (@spa_facility ? club_life_page_path(@spa_facility) : club_life_path), class: "bbcc-text-link" %>
            </div>
        </div>
    </div>
    <div class="container-lg bbcc-reverie-body">
        <div class="row g-4">
            <div class="col-12 col-lg-3">
                <h3 class="bbcc-title-md">Treatments &amp; Services</h3>
                <p>Discover the signature treatments that make Reverie Spa a place to restore.</p>
                <%= link_to "Discover more", (@spa_facility ? club_life_page_path(@spa_facility) : club_life_path), class: "bbcc-text-link" %>
            </div>
            <div class="col-12 col-lg-9 bbcc-bleed-right">
                <div class="bbcc-swiper bbcc-slider" data-slides="1.3,2.3,3.2,3.3">
                    <div class="swiper-wrapper">
                        <% treatments.each_with_index do |(name, text), i| %>
                            <div class="swiper-slide">
                                <article class="bbcc-treatment-tile" style="background-image:url('<%= image_url("new-design/spa/img-#{i + 1}.png") %>');">
                                    <div class="bbcc-treatment-tile-text">
                                        <h4><%= name %></h4>
                                        <p><%= text %></p>
                                    </div>
                                </article>
                            </div>
                        <% end %>
                    </div>
                    <%= render "shared/slider_controls" %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end reverie spa -->
