<section class="wow animate__fadeIn">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 text-center text-md-start padding-eight-lr lg-padding-six-lr md-padding-15px-lr wow animate__fadeInLeft">
                <h5 class="alt-font text-extra-dark-gray text-uppercase">Highlight Events</h5>
                <h6 class="alt-font text-extra-dark-gray text-uppercase"><%= @event.name %></h6>
                <p><%= @event.short_description.truncate(300) %></p>
                <a href="<%= events_path %>" class="btn btn-light-gray btn-medium text-medium margin-5px-top">See All Events</a>
            </div>
            <div class="col-lg-6 col-md-6 text-center md-margin-30px-bottom wow animate__fadeInRight" data-wow-delay="0.2s">
                <%= image_tag("https://placehold.co/600x400", class: "border-radius-6 w-100") %>
            </div>
        </div>
    </div>
</section>
