<%
  initial_count = 6
  tabs = [{ label: "ALL", path: our_team_path, active: @section == "all" }] +
         TeamMember::DEPARTMENTS.map { |key| { label: TeamMember.department_label(key), path: our_team_path(department: key), active: @section == key } }
%>
<%= render "shared/page_intro", title: "BBCC Team", tabs: tabs,
    description: simple_format("From the clubhouse kitchen to the practice courts, the people of Bali Beach Country Club are what turn a visit into a membership.") %>

<!-- start our team -->
<section class="bbcc-page-body bbcc-team-page">
    <div class="container-lg">
        <% if @team_members.present? %>
            <div class="bbcc-team-grid">
                <% @team_members.each_with_index do |member, index| %>
                    <article class="bbcc-team-card<%= " bbcc-team-card-hidden" if index >= initial_count %>">
                        <span class="bbcc-team-card-image">
                            <% if member.photo.attached? %>
                                <%= image_tag member.photo.variant(resize_to_fill: [600, 720]), alt: member.name, loading: "lazy" %>
                            <% end %>
                        </span>
                        <span class="bbcc-team-card-meta"><%= member.department_label %> | <%= member.role %></span>
                        <h2 class="bbcc-team-card-name"><%= member.name %></h2>
                        <p class="bbcc-team-card-bio"><%= member.bio %></p>
                    </article>
                <% end %>
            </div>
            <% if @team_members.size > initial_count %>
                <div class="bbcc-view-more-wrap">
                    <button type="button" class="bbcc-solid-btn bbcc-view-more" data-target=".bbcc-team-card-hidden">View More</button>
                </div>
            <% end %>
        <% else %>
            <p class="bbcc-empty">No team members in this department yet.</p>
        <% end %>
    </div>
</section>
<!-- end our team -->

<%= render "home/blogs" %>
<%= render "home/social_media" %>
