<!-- start highlights / special events -->
<% highlights = Highlight.published.limit(8) %>
<% if highlights.any? %>
<section class="bbcc-section bbcc-highlights" id="highlights">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-section-title">Highlights</h2>
        </div>
    </div>
    <div class="container-lg">
        <div class="swiper bbcc-swiper bbcc-highlights-swiper">
            <div class="swiper-wrapper">
                <% highlights.each do |highlight| %>
                    <div class="swiper-slide">
                        <%= link_to highlight_path(highlight), class: "bbcc-highlight",
                                    style: ("background-image:url('#{url_for(highlight.image)}');" if highlight.image.attached?) do %>
                            <span class="bbcc-highlight-shade"></span>
                            <span class="bbcc-highlight-title"><%= highlight.title %></span>
                        <% end %>
                    </div>
                <% end %>
            </div>
            <div class="bbcc-swiper-controls">
                <button type="button" class="bbcc-swiper-prev" aria-label="Previous"><i class="fa-solid fa-angle-left"></i></button>
                <div class="bbcc-swiper-pagination"></div>
                <button type="button" class="bbcc-swiper-next" aria-label="Next"><i class="fa-solid fa-angle-right"></i></button>
            </div>
        </div>
    </div>
</section>
<% end %>
<!-- end highlights / special events -->
