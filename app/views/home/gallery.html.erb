<%
  gallery_labels = {
    "golf" => "Golf", "tennis" => "Tennis", "padel" => "Padel", "pickleball" => "Pickleball",
    "fitness" => "Fitness", "spa" => "Spa", "dining" => "Dining", "events" => "Events", "club_life" => "Club Life"
  }
  initial_count = 12
%>
<%
  tabs = [{ label: "All", path: gallery_path, active: @section == "all" }] +
         gallery_labels.map { |key, label| { label: label, path: gallery_path(category: key), active: @section == key } }
%>
<%= render "shared/page_intro", title: "BBCC Gallery", tabs: tabs,
    description: simple_format("Moments from across the club \u2014 the courts, the greens, the studio, the table and the beach.") %>

<!-- start gallery -->
<section class="bbcc-page-body bbcc-gallery-page">
    <div class="container-lg">
        <% if @items.present? %>
            <div class="bbcc-masonry">
                <% @items.each_with_index do |image, index| %>
                    <span class="bbcc-masonry-item<%= " bbcc-masonry-item-hidden" if index >= initial_count %>">
                        <%= image_tag image.variant(resize_to_limit: [700, 700]) %>
                    </span>
                <% end %>
            </div>
            <% if @items.size > initial_count %>
                <div class="bbcc-view-more-wrap">
                    <button type="button" class="bbcc-solid-btn bbcc-view-more" data-target=".bbcc-masonry-item-hidden">View More</button>
                </div>
            <% end %>
        <% else %>
            <p class="bbcc-faq-empty">No photos in this category yet.</p>
        <% end %>
    </div>
</section>
<!-- end gallery -->

<%= render "home/blogs" %>
