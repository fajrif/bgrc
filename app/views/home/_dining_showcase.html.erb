<%
  find = ->(name) { @restaurants.find { |r| r.en_name.to_s.casecmp?(name) } }
  path_for = ->(name) { (r = find.call(name)) ? dining_restaurant_path(r) : dining_path }
  # Designed cards (photo + wordmark + line of copy) for the venues that have artwork;
  # any other venue, Grab & Go included, falls back to its own admin photo and text.
  designed = {
    "mezzaluna" => { name: "Mezzaluna", logo: "mezzaluna", image: "dining-banner.png", text: "Italian classics and wood-fired favourites." },
    "kasumi"    => { name: "Kasumi Izakaya", logo: "kasumi", image: "img-kasumi.png", text: "Japanese small plates and sake in a relaxed izakaya." },
    "corsa"     => { name: "Corsa Bar & Grill", logo: "corsa", image: "img-corsa.png", text: "Grill classics and cocktails with a motorsport soul." }
  }
  # Tavara is the big banner above; every other venue goes in the slider
  venues = @restaurants.reject { |r| r.en_name.to_s.casecmp?("Tavara") }
%>
<!-- start dining & entertainment -->
<section class="bbcc-section bbcc-dining-showcase">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Dining &amp; Entertainment</h2>
        <%= link_to path_for.call("Tavara"), class: "bbcc-dining-hero", style: "background-image:url('#{image_url('new-design/dining/tavara-banner.png')}');" do %>
            <%= image_tag "new-design/dining/logo-tavara.png", alt: "Tavara", class: "bbcc-dining-hero-logo" %>
            <span class="bbcc-dining-hero-text">
                <span>Flavours of the Indian subcontinent, plated with a modern hand.</span>
                <span class="bbcc-text-link bbcc-text-link-light">Discover more</span>
            </span>
        <% end %>
        <div class="bbcc-swiper bbcc-slider bbcc-dining-slider" data-slides="1.15,2,3,3">
            <div class="swiper-wrapper">
                <% venues.each do |restaurant| %>
                    <% art = designed[restaurant.en_name.to_s.downcase] %>
                    <% photo = art ? image_url("new-design/dining/#{art[:image]}") : (restaurant.image.attached? ? url_for(restaurant.image) : image_url("images/image-4.png")) %>
                    <% title = art ? art[:name] : restaurant.name %>
                    <div class="swiper-slide">
                        <%= link_to dining_restaurant_path(restaurant), class: "bbcc-dining-card" do %>
                            <span class="bbcc-dining-card-image" style="background-image:url('<%= photo %>');">
                                <%# other venues' own photos already carry their branding %>
                                <% if art %>
                                    <%= image_tag "new-design/dining/logo-#{art[:logo]}.png", alt: title, class: "bbcc-dining-card-logo" %>
                                <% end %>
                            </span>
                            <h3 class="bbcc-title-sm"><%= title %></h3>
                            <p><%= art ? art[:text] : restaurant.short_description.to_s.truncate(110) %></p>
                            <span class="bbcc-text-link">Discover more</span>
                        <% end %>
                    </div>
                <% end %>
            </div>
            <%= render "shared/slider_controls" %>
        </div>
    </div>
</section>
<!-- end dining & entertainment -->
