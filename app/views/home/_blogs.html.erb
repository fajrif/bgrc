<%# Latest News & Events — shared by the homepage and the inner pages that set @articles %>
<% if @articles.present? %>
<!-- start news & events -->
<section class="bbcc-section bbcc-section-alt bbcc-news">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Latest News &amp; Events</h2>
        <div class="bbcc-swiper bbcc-slider" data-slides="1.15,2,3,3">
            <div class="swiper-wrapper">
                <% @articles.each do |article| %>
                    <div class="swiper-slide">
                        <article class="bbcc-news-card">
                            <%= link_to get_blog_path(article), class: "bbcc-news-card-image" do %>
                                <% if article.image.attached? %>
                                    <%= image_tag article.image.variant(resize_to_fill: [750, 750]), alt: article.title, loading: "lazy" %>
                                <% else %>
                                    <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-4.png') %>');"></span>
                                <% end %>
                            <% end %>
                            <time class="bbcc-news-card-date"><%= article.published_date&.strftime('%Y.%m.%d') %></time>
                            <h3 class="bbcc-news-card-title"><%= link_to article.title, get_blog_path(article) %></h3>
                            <p><%= article.short_description.to_s.truncate(140) %></p>
                            <%= link_to "Learn more", get_blog_path(article), class: "bbcc-text-link" %>
                        </article>
                    </div>
                <% end %>
            </div>
            <%= render "shared/slider_controls" %>
        </div>
    </div>
</section>
<!-- end news & events -->
<% end %>
