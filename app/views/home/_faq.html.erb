<!-- start faq -->
<section class="bbcc-section bbcc-faq">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-section-title">FAQ</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                <div class="bbcc-accordion">
                    <% @faqs.each do |faq| %>
                        <details class="bbcc-accordion-item">
                            <summary><%= faq.title %><span class="bbcc-accordion-icon"></span></summary>
                            <div class="bbcc-accordion-body"><%= raw faq.description %></div>
                        </details>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end faq -->
