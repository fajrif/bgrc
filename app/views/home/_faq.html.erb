<!-- start faq -->
<section class="bbcc-section bbcc-section-alt bbcc-faq">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-5">
                <h2 class="bbcc-title-lg">Frequently Asked<br>Questions</h2>
            </div>
            <div class="col-12 col-lg-7">
                <div class="bbcc-accordion">
                    <% @faqs.each_with_index do |faq, i| %>
                        <details class="bbcc-accordion-item"<%= " open" if i.zero? %>>
                            <summary><%= faq.title %><span class="bbcc-accordion-icon"></span></summary>
                            <div class="bbcc-accordion-body"><%= raw faq.description %></div>
                        </details>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end faq -->
