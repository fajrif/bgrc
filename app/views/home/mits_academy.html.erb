<%= render "shared/page_intro", title: "BBCC MITS Academy",
    description: safe_join([
      content_tag(:p, "MITS Academy leads coaching across tennis, padel and pickleball at Bali Beach Country Club, bringing structured pathways for junior development through to high-performance training."),
      content_tag(:p, "Every program is built around international coaching standards and the courts here are designed to match \u2014 giving players a genuine step up, whichever sport brings them to the club.")
    ]) %>

<!-- start mits academy full banner -->
<div class="bbcc-fullbanner bbcc-fullbanner-tall" style="background-image:url('<%= image_url('banners/banner-padel.png') %>');" role="img" aria-label="MITS Academy players on court"></div>
<!-- end mits academy full banner -->

<!-- start mits academy about -->
<section class="bbcc-section bbcc-mits-intro">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-8 offset-lg-4 bbcc-intro-desc">
                <p>Our coaching programs are designed for every level &mdash; from first-time players finding the fundamentals to competitive athletes sharpening an edge. Sessions run on purpose-built courts with certified coaches, in small groups or one-to-one.</p>
                <p>Beyond Bali, MITS Academy runs coaching programs and player pathways in Australia, so members and guests training here can tap into a wider network of coaching expertise and playing opportunities.</p>
            </div>
        </div>
    </div>
</section>
<!-- end mits academy about -->

<% if @coaches.present? %>
<!-- start coaches -->
<section class="bbcc-section bbcc-vision-tan bbcc-mits-coaches">
    <div class="bbcc-socials-inner">
        <div class="bbcc-socials-text">
            <h2 class="bbcc-title-lg">Coaches</h2>
            <p>Certified MITS Academy coaches across tennis, padel and pickleball, ready to help you build the fundamentals or sharpen a competitive edge.</p>
        </div>
        <div class="bbcc-socials-slider">
            <div class="bbcc-swiper bbcc-slider" data-slides="1.3,2.2,3.2,3.2">
                <div class="swiper-wrapper">
                    <% @coaches.each do |coach| %>
                        <div class="swiper-slide">
                            <div class="bbcc-coach-tile">
                                <% if coach.photo.attached? %>
                                    <%= image_tag coach.photo.variant(resize_to_fill: [560, 640]), alt: coach.name, loading: "lazy" %>
                                <% end %>
                                <span class="bbcc-coach-tile-shade"></span>
                                <span class="bbcc-coach-tile-body">
                                    <span class="bbcc-coach-tile-name"><%= coach.name %></span>
                                    <span class="bbcc-coach-tile-role"><%= coach.level_label %></span>
                                </span>
                            </div>
                        </div>
                    <% end %>
                </div>
                <%= render "shared/slider_controls" %>
            </div>
        </div>
    </div>
</section>
<!-- end coaches -->
<% end %>

<!-- start mits academy split -->
<section class="bbcc-section bbcc-mits-split">
    <div class="container-lg">
        <div class="row g-0 bbcc-mits-split-row">
            <div class="col-12 col-lg-6">
                <div class="bbcc-mits-split-image" style="background-image:url('<%= image_url('sports/tennis/gallery-3.png') %>');"></div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="bbcc-mits-split-body">
                    <p>
                        Beyond Bali, MITS Academy runs coaching programs and player pathways in Australia
                        &mdash; from grassroots clinics to elite performance training.
                    </p>
                    <p>
                        Members and guests training here can tap into that wider network of coaching
                        expertise and playing opportunities.
                    </p>
                    <a href="https://wearemits.com" target="_blank" rel="noopener" class="bbcc-btn text-center">Visit MITS Australia</a>
                </div>
            </div>
        </div>
        <div class="row g-0 bbcc-mits-split-row">
            <div class="col-12 col-lg-6">
                <div class="bbcc-mits-contact">
                    <h3 class="bbcc-vision-label">Contact Info</h3>
                    <div class="bbcc-info-item margin-15px-bottom">
                        <span class="bbcc-info-icon"><i class="icon-map" aria-hidden="true"></i></span>
                        <div class="bbcc-info-body"><%= raw(configatron.location_address) %></div>
                    </div>
                    <div class="bbcc-info-item margin-15px-bottom">
                        <span class="bbcc-info-icon"><i class="icon-phone" aria-hidden="true"></i></span>
                        <div class="bbcc-info-body"><p><%= configatron.company_phone1 %></p></div>
                    </div>
                    <div class="bbcc-info-item margin-20px-bottom">
                        <span class="bbcc-info-icon"><i class="icon-envelope" aria-hidden="true"></i></span>
                        <div class="bbcc-info-body"><p><%= configatron.admin_email %></p></div>
                    </div>
                    <div class="bbcc-mits-contact-actions">
                        <a href="https://wa.me/<%= configatron.whatsapp_number.to_s.gsub(/\D/, '') %>?text=<%= url_encode("Hi, I'd like to ask about MITS Academy coaching programs at Bali Beach Country Club.") %>" target="_blank" rel="noopener" class="bbcc-btn">WhatsApp Us</a>
                        <a href="mailto:<%= configatron.admin_email %>" class="bbcc-btn">Email Us</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="bbcc-mits-split-image" style="background-image:url('<%= image_url('sports/tennis/gallery-4.png') %>');"></div>
            </div>
        </div>
    </div>
</section>
<!-- end mits academy split -->

<%= render "home/blogs" %>
<%= render "home/social_media" %>
