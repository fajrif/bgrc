<!-- start club life slider: every Club Life section, in admin order -->
<% sections = Facility.club_life_roots.includes(image_attachment: :blob).to_a %>
<% if sections.any? %>
<section class="bbcc-golf-gym">
    <div class="container-lg">
        <div class="bbcc-swiper bbcc-slider bbcc-golf-gym-slider" data-slides="1.1,2,2,2">
            <div class="swiper-wrapper">
                <% sections.each do |section| %>
                    <% photo = section.image.attached? ? url_for(section.image) : (club_life_fallback_banner(section) || image_url("images/image-4.png")) %>
                    <div class="swiper-slide">
                        <%= link_to club_life_page_path(section), class: "bbcc-feature-card" do %>
                            <%= image_tag photo, alt: section.name, loading: "lazy" %>
                            <h3 class="bbcc-feature-title"><%= section.name %></h3>
                            <p><%= section.short_description.to_s.truncate(120) %></p>
                            <span class="bbcc-text-link">Discover more</span>
                        <% end %>
                    </div>
                <% end %>
            </div>
            <%= render "shared/slider_controls" %>
        </div>
    </div>
</section>
<% end %>
<!-- end club life slider -->
