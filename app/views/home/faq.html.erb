<%= render "shared/page_hero", banner: @banner, crumbs: [{ label: "FAQ" }] %>

<!-- start faq -->
<section class="bbcc-section bbcc-faq-page">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-3">
                <nav class="bbcc-faq-nav" aria-label="FAQ categories">
                    <% Question::SECTIONS.each do |key| %>
                        <%= link_to Question.section_label(key), faq_path(section: key),
                            class: ["bbcc-faq-nav-link", ("active" if key == @section)] %>
                    <% end %>
                </nav>
            </div>
            <div class="col-12 col-lg-9">
                <% if @faqs.any? %>
                    <div class="bbcc-faq-list">
                        <% @faqs.each do |faq| %>
                            <details class="bbcc-faq-item">
                                <summary>
                                    <span><%= faq.title %></span>
                                    <i class="fa-solid fa-chevron-right bbcc-faq-item-icon" aria-hidden="true"></i>
                                </summary>
                                <div class="bbcc-faq-item-body"><%= raw faq.description %></div>
                            </details>
                        <% end %>
                    </div>
                <% else %>
                    <p class="bbcc-faq-empty">
                        No questions in this category yet. Have one? <%= link_to "Contact us", get_contact_path, class: "bbcc-link" %>.
                    </p>
                <% end %>
            </div>
        </div>
    </div>
</section>
<!-- end faq -->
