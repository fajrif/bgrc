<% content_for :header_light, true %>
<!-- start legal -->
<section class="bbcc-page-body bbcc-legal-page">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4">
                <%= render "shared/legal_nav", active: :terms %>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-prose bbcc-legal-content">
                    <p>Welcome to the Bali Beach Country Club Terms &amp; Conditions page. By booking or using this website, you agree to be bound by the terms below &mdash; the same policies you confirm when completing a booking payment. If you do not agree with these terms, please do not use the Site.</p>
                    <% if @snippets.present? %>
                        <% @snippets.each_with_index do |snippet, index| %>
                            <div class="bbcc-legal-section">
                                <h2><%= index + 1 %>. <%= snippet.title %></h2>
                                <%= raw snippet.content %>
                            </div>
                        <% end %>
                    <% else %>
                        <p class="bbcc-faq-empty">Content coming soon.</p>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end legal -->
<%= render "home/social_media" %>
