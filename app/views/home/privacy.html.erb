<%= render "shared/page_hero", banner: @banner, crumbs: [{ label: "Privacy Policy" }] %>

<!-- start privacy policy -->
<section class="bbcc-section bbcc-legal-page">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-3">
                <%= render "shared/legal_nav", active: :privacy %>
            </div>
            <div class="col-12 col-lg-9">
                <p class="bbcc-lead">
                    This Privacy Policy explains how Bali Beach Country Club collects, uses and protects
                    your personal information when you use this website, create an account, or make a
                    booking with us.
                </p>
                <% if @snippet %>
                    <div class="bbcc-article-body bbcc-legal-content"><%= raw @snippet.content %></div>
                <% else %>
                    <p class="bbcc-faq-empty">Content coming soon.</p>
                <% end %>
            </div>
        </div>
    </div>
</section>
<!-- end privacy policy -->
