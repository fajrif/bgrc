<% content_for :header_light, true %>
<!-- start legal -->
<section class="bbcc-page-body bbcc-legal-page">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4">
                <%= render "shared/legal_nav", active: :privacy %>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-prose bbcc-legal-content">
                    <p>This Privacy Policy explains how Bali Beach Country Club collects, uses and protects your personal information when you use this website, create an account, or make a booking with us.</p>
                    <% if @snippet %>
                        <%= raw @snippet.content %>
                    <% else %>
                        <p class="bbcc-faq-empty">Content coming soon.</p>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end legal -->
<%= render "home/social_media" %>
