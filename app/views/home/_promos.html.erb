<section class="wow animate__fadeIn">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 text-center">
                <div class="position-relative overflow-hidden w-100">
                    <h5 class="alt-font font-weight-600 text-uppercase margin-50px-bottom">Promo</h5>
                </div>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 justify-content-center align-items-center">
          <% @promos.each do |promo| %>
            <!-- start features box item -->
            <div class="col-sm-8 md-margin-30px-bottom wow animate__fadeInUp">
                <div class="text-white">
                    <%= link_to promo_path(promo) do %>
                      <%= image_tag promo.image.variant(resize_to_fill: [750,500]) %>
                    <% end %>
                    <div class="padding-25px-all bg-medium-grey">
                      <span class="font-weight-600 d-block alt-font text-uppercase margin-10px-bottom"><%= promo.name %></span>
                      <hr/>
                      <span class="font-weight-500 d-block alt-font margin-10px-bottom text-uppercase"><%= promo.sport.name %></span>
                      <p><%= promo.short_description.truncate(150) %></p>
                      <p class="text-medium">Valid: <%= promo.valid_date %></p>
                      <%= link_to "Read More", promo_path(promo), class: "btn btn-medium btn-light-gray w-100" %>
                    </div>
                </div>
            </div>
            <!-- end features box item -->
          <% end %>
        </div>
    </div>
</section>
