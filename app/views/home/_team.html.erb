<!-- start our team -->
<section class="bbcc-section bbcc-team">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start margin-30px-bottom">
            <div class="col-12 col-lg-4">
                <h2 class="bbcc-section-title">Our Team</h2>
            </div>
            <div class="col-12 col-lg-8">
                <p class="bbcc-lead mb-0">
                    From the clubhouse kitchen to the practice courts, the people of Bali Beach Country
                    Club are what turn a visit into a membership. Meet the teams behind your experience.
                </p>
            </div>
        </div>
        <div class="row g-3 g-lg-4 margin-30px-bottom">
            <div class="col-12 col-lg-4">
                <div class="bbcc-tile bbcc-tile-lg" style="background-image:url('<%= image_url('facilities/restaurant.png') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body">
                        <span class="bbcc-tile-label">F&amp;B Team</span>
                        <span class="bbcc-tile-desc">Keeping the clubhouse, poolside bar and event spaces running &mdash; from casual lunches to full wedding receptions.</span>
                    </span>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="bbcc-tile bbcc-tile-lg" style="background-image:url('<%= image_url('coaches/danny-sousa.jpg') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body">
                        <span class="bbcc-tile-label">Sports Coaches &amp; Trainers</span>
                        <span class="bbcc-tile-desc">Certified coaches across golf, tennis, padel and pickleball, delivered in partnership with MITS Academy.</span>
                    </span>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="bbcc-tile bbcc-tile-lg" style="background-image:url('<%= image_url('facilities/yoga.png') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body">
                        <span class="bbcc-tile-label">Wellness Specialists</span>
                        <span class="bbcc-tile-desc">Yoga, pilates and recovery specialists on hand to help members train smarter and recover well.</span>
                    </span>
                </div>
            </div>
        </div>
        <div class="text-center">
            <%= link_to "View All Team", our_team_path, class: "bbcc-btn" %>
        </div>
    </div>
</section>
<!-- end our team -->
