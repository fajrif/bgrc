<%
  teams = [
    { label: "F&B Team", image: "new-design/photos/about/team-1.jpg", dept: "fnb",
      desc: "Keeping the clubhouse, poolside bar and event spaces running \u2014 from casual lunches to full wedding receptions." },
    { label: "Sports Coaches & Trainers", image: "new-design/photos/about/team-2.jpg", dept: "sports",
      desc: "Certified coaches across golf, tennis, padel and pickleball, delivered in partnership with MITS Academy." },
    { label: "Wellness Specialists", image: "new-design/photos/about/team-3.jpg", dept: "specialists",
      desc: "Yoga, pilates and recovery specialists on hand to help members train smarter and recover well." }
  ]
%>
<!-- start our team -->
<section class="bbcc-section bbcc-team">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start bbcc-team-head">
            <div class="col-12 col-lg-4">
                <h2 class="bbcc-title-lg">Our Team</h2>
            </div>
            <div class="col-12 col-lg-8">
                <p>
                    From the clubhouse kitchen to the practice courts, the people of Bali Beach Country
                    Club are what turn a visit into a membership. Meet the teams behind your experience.
                </p>
                <%= link_to "Discover more", our_team_path, class: "bbcc-text-link" %>
            </div>
        </div>
        <div class="bbcc-swiper bbcc-slider" data-slides="1.15,2,3,3">
            <div class="swiper-wrapper">
                <% teams.each do |team| %>
                    <div class="swiper-slide">
                        <article class="bbcc-news-card">
                            <%= link_to our_team_path(department: team[:dept]), class: "bbcc-news-card-image" do %>
                                <%= image_tag team[:image], alt: team[:label], loading: "lazy" %>
                            <% end %>
                            <h3 class="bbcc-news-card-title"><%= link_to team[:label], our_team_path(department: team[:dept]) %></h3>
                            <p><%= team[:desc] %></p>
                            <%= link_to "Discover more", our_team_path(department: team[:dept]), class: "bbcc-text-link" %>
                        </article>
                    </div>
                <% end %>
            </div>
            <%= render "shared/slider_controls" %>
        </div>
    </div>
</section>
<!-- end our team -->
