<!-- start events (types) -->
<section class="bbcc-section bbcc-events">
    <div class="container-lg">
        <div class="bbcc-section-head">
            <h2 class="bbcc-section-title">Events</h2>
        </div>
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-6 order-lg-2">
                <div class="bbcc-events-image" style="background-image:url('<%= image_url('banners/banner-events.png') %>');"></div>
            </div>
            <div class="col-12 col-lg-6 order-lg-1">
                <div class="bbcc-accordion">
                    <% EventType.ordered.each_with_index do |event_type, index| %>
                        <details class="bbcc-accordion-item" <%= "open" if index.zero? %>>
                            <summary><%= event_type.name %><span class="bbcc-accordion-icon"></span></summary>
                            <div class="bbcc-accordion-body">
                                <p><%= event_type.short_description %></p>
                                <%= link_to "Learn More", event_type_path(event_type), class: "bbcc-btn" %>
                            </div>
                        </details>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end events (types) -->
