<!-- start events (types) -->
<section class="bbcc-section bbcc-events">
    <div class="container-lg">
        <div class="bbcc-section-head">
            <h2 class="bbcc-section-title">Events</h2>
        </div>
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-6 order-lg-2">
                <div class="bbcc-events-image" style="background-image:url('<%= image_url('banners/banner-events.png') %>');"></div>
            </div>
            <div class="col-12 col-lg-6 order-lg-1">
                <div class="bbcc-accordion">
                    <details class="bbcc-accordion-item" open>
                        <summary>Weddings<span class="bbcc-accordion-icon"></span></summary>
                        <div class="bbcc-accordion-body">
                            <p>Say "I do" against a backdrop of manicured greens and ocean breeze. Our team
                            crafts bespoke wedding experiences from intimate ceremonies to grand receptions.</p>
                            <a href="<%= get_contact_path %>" class="bbcc-link">Enquire now &rarr;</a>
                        </div>
                    </details>
                    <details class="bbcc-accordion-item">
                        <summary>Corporate Events<span class="bbcc-accordion-icon"></span></summary>
                        <div class="bbcc-accordion-body">
                            <p>Impress clients and reward teams with golf days, tournaments, conferences and
                            team-building sessions supported by full-service catering and event planning.</p>
                            <a href="<%= get_contact_path %>" class="bbcc-link">Enquire now &rarr;</a>
                        </div>
                    </details>
                    <details class="bbcc-accordion-item">
                        <summary>Private Celebrations<span class="bbcc-accordion-icon"></span></summary>
                        <div class="bbcc-accordion-body">
                            <p>Birthdays, anniversaries and milestone gatherings &mdash; celebrate in style with
                            flexible venues, curated menus and a setting your guests will never forget.</p>
                            <a href="<%= get_contact_path %>" class="bbcc-link">Enquire now &rarr;</a>
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end events (types) -->
