<!-- start who we are -->
<section class="bbcc-section bbcc-about-intro">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-6">
                <h2 class="bbcc-title-lg">Who we are</h2>
                <p>
                    Bali Beach Country Club is Nusa Dua&rsquo;s home for golf, racquet sports, wellness and
                    hospitality &mdash; built for members and guests who expect the very best.
                </p>
                <p>
                    Since opening, our championship course and full-service clubhouse have welcomed
                    players of every level, from first-timers finding their swing to seasoned members
                    chasing a personal best.
                </p>
            </div>
            <div class="col-12 col-lg-6">
                <%= image_tag "about1.png", class: "bbcc-about-image", alt: "", loading: "lazy" %>
            </div>
        </div>
        <div class="row g-4 g-lg-5 align-items-center bbcc-about-row">
            <div class="col-12 col-lg-6">
                <%= image_tag "about2.png", class: "bbcc-about-image", alt: "", loading: "lazy" %>
            </div>
            <div class="col-12 col-lg-6">
                <p>
                    Off the fairway, our tennis, padel and pickleball courts bring the same standard of
                    care to racquet sports. Purpose-built surfaces, certified coaching and a packed
                    calendar of clinics and socials keep the club buzzing well beyond the 18th hole.
                </p>
            </div>
        </div>
    </div>
</section>
<!-- end who we are -->
