<%
  gallery_images = %w[
    new-design/photos/about/gallery-1.jpg new-design/photos/about/gallery-2.jpg new-design/photos/about/gallery-3.jpg
    new-design/photos/about/gallery-4.jpg new-design/photos/about/gallery-5.jpg new-design/photos/about/gallery-6.jpg
  ]
%>
<!-- start gallery -->
<section class="bbcc-section bbcc-gallery">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Gallery</h2>
        <div class="bbcc-square-grid">
            <% gallery_images.each do |img| %>
                <%= image_tag img, alt: "", loading: "lazy" %>
            <% end %>
        </div>
        <div class="bbcc-view-more-wrap">
            <%= link_to "View More", gallery_path, class: "bbcc-solid-btn" %>
        </div>
    </div>
</section>
<!-- end gallery -->
