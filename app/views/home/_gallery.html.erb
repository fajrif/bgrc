<%
  gallery_images = %w[
    sports/pickleball/gallery-2.png sports/padel/gallery-2.png sports/tennis/gallery-2.png
    sports/padel/gallery-3.png sports/padel/gallery-6.png sports/padel/gallery-4.png
  ]
%>
<!-- start gallery -->
<section class="bbcc-section bbcc-gallery">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Gallery</h2>
        <div class="bbcc-square-grid">
            <% gallery_images.each do |img| %>
                <%= image_tag img, alt: "", loading: "lazy" %>
            <% end %>
        </div>
        <div class="bbcc-view-more-wrap">
            <%= link_to "View More", gallery_path, class: "bbcc-solid-btn" %>
        </div>
    </div>
</section>
<!-- end gallery -->
