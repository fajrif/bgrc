<!-- start gallery -->
<section class="bbcc-section bbcc-gallery">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-section-title">Gallery</h2>
        </div>
        <div class="bbcc-gallery-top">
            <span class="bbcc-gallery-item">
                <%= image_tag "sports/pickleball/gallery-2.png", alt: "Pickleball at Bali Beach Country Club" %>
            </span>
            <span class="bbcc-gallery-item bbcc-gallery-item-wide">
                <%= image_tag "sports/padel/gallery-2.png", alt: "Padel courts at Bali Beach Country Club" %>
            </span>
        </div>
        <div class="bbcc-gallery-bottom">
            <span class="bbcc-gallery-item">
                <%= image_tag "sports/padel/gallery-3.png", alt: "Padel court" %>
            </span>
            <span class="bbcc-gallery-item">
                <%= image_tag "sports/padel/gallery-6.png", alt: "Courtside" %>
            </span>
            <span class="bbcc-gallery-item">
                <%= image_tag "sports/padel/gallery-4.png", alt: "Padel racket on court" %>
            </span>
        </div>
        <div class="text-center">
            <%= link_to "View More", gallery_path, class: "bbcc-btn" %>
        </div>
    </div>
</section>
<!-- end gallery -->
