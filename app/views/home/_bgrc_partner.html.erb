<!-- start bbcc partner -->
<section class="bbcc-section bbcc-partner">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start margin-30px-bottom">
            <div class="col-12 col-lg-8">
                <h2 class="bbcc-section-title">BBCC Partner</h2>
                <p class="bbcc-lead mb-0">
                    We work with best-in-class partners to raise the level of play across every sport
                    at the club.
                </p>
            </div>
        </div>
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-4 text-center text-lg-start">
                <%= image_tag "mits-logo.png", class: "mb-4", style: "width:150px;" %>
            </div>
            <div class="col-12 col-lg-8">
                <h3 class="bbcc-partner-name">MITS Academy</h3>
                <p>
                    MITS Academy leads coaching across tennis, padel and pickleball at Bali Beach
                    Country Club, bringing structured pathways for junior development through to
                    high-performance training.
                </p>
                <p>
                    Every program is built around international coaching standards and the courts here
                    are designed to match &mdash; giving players a genuine step up, whichever sport
                    brings them to the club.
                </p>
                <%= link_to "Learn More", mits_academy_path, class: "bbcc-btn" %>
            </div>
        </div>
    </div>
</section>
<!-- end bbcc partner -->
