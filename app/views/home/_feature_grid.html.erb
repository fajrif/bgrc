<!-- start feature grid -->
<%
  # The five Club Life sections, in admin-controlled order: two wide tiles then three small.
  sections = Facility.club_life_roots.to_a
  wide, small = sections.first(2), sections.drop(2)
  wide_cols = ["col-12 col-lg-7", "col-12 col-lg-5"]
%>
<% if sections.any? %>
<section class="bbcc-section bbcc-features">
    <div class="container-lg">
        <div class="row g-3 g-lg-4">
            <% wide.each_with_index do |section, index| %>
                <div class="<%= wide_cols[index] %>">
                    <%= link_to club_life_page_path(section), class: "bbcc-tile bbcc-tile-lg",
                                style: ("background-image:url('#{url_for(section.image)}');" if section.image.attached?) do %>
                        <span class="bbcc-tile-shade"></span>
                        <span class="bbcc-tile-body">
                            <span class="bbcc-tile-label"><%= section.name %></span>
                            <span class="bbcc-tile-desc"><%= section.short_description.to_s.truncate(150) %></span>
                        </span>
                    <% end %>
                </div>
            <% end %>
            <% small.each do |section| %>
                <div class="col-12 col-md-4">
                    <%= link_to club_life_page_path(section), class: "bbcc-tile bbcc-tile-sm",
                                style: ("background-image:url('#{url_for(section.image)}');" if section.image.attached?) do %>
                        <span class="bbcc-tile-shade"></span>
                        <span class="bbcc-tile-body">
                            <span class="bbcc-tile-label"><%= section.name %></span>
                            <span class="bbcc-tile-desc"><%= section.short_description.to_s.truncate(90) %></span>
                        </span>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</section>
<% end %>
<!-- end feature grid -->
