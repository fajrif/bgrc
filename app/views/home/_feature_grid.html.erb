<!-- start feature grid -->
<section class="bbcc-section bbcc-features">
    <div class="container-lg">
        <div class="row g-3 g-lg-4">
            <!-- Golf (large) -->
            <div class="col-12 col-lg-7">
                <a href="<%= golf_path %>" class="bbcc-tile bbcc-tile-lg" style="background-image:url('<%= image_url('banners/banner-golf.png') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body">
                        <span class="bbcc-tile-label">Golf</span>
                    </span>
                </a>
            </div>
            <!-- Racquet Sports (with text) -->
            <div class="col-12 col-lg-5">
                <a href="<%= facilities_path %>" class="bbcc-tile bbcc-tile-lg" style="background-image:url('<%= image_url('banners/banner-tennis.png') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body">
                        <span class="bbcc-tile-label">Racquet Sports</span>
                        <span class="bbcc-tile-desc">Tennis, padel and pickleball courts for every level &mdash; from first serve to championship play.</span>
                    </span>
                </a>
            </div>
            <!-- Fitness -->
            <div class="col-12 col-md-4">
                <a href="<%= wellnesses_path %>" class="bbcc-tile bbcc-tile-sm" style="background-image:url('<%= image_url('facilities/gym.png') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body"><span class="bbcc-tile-label">Fitness</span></span>
                </a>
            </div>
            <!-- Aqua / Pool -->
            <div class="col-12 col-md-4">
                <a href="<%= wellnesses_path %>" class="bbcc-tile bbcc-tile-sm" style="background-image:url('<%= image_url('facilities/swimming-pool.png') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body"><span class="bbcc-tile-label">Aqua &amp; Pool</span></span>
                </a>
            </div>
            <!-- Spa + Wellness -->
            <div class="col-12 col-md-4">
                <a href="<%= wellnesses_path %>" class="bbcc-tile bbcc-tile-sm" style="background-image:url('<%= image_url('facilities/yoga.png') %>');">
                    <span class="bbcc-tile-shade"></span>
                    <span class="bbcc-tile-body"><span class="bbcc-tile-label">Spa + Wellness</span></span>
                </a>
            </div>
        </div>
    </div>
</section>
<!-- end feature grid -->
