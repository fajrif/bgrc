<!-- start hero + availability search -->
<section class="bbcc-hero" style="background-image:url('<%= image_url('home-banner.png') %>');">
    <div class="bbcc-hero-overlay"></div>
    <div class="container-lg">
        <div class="bbcc-hero-search">
            <form action="<%= search_path %>" method="GET">
                <div class="bbcc-hero-search-fields">
                    <div class="bbcc-hero-field">
                        <label>Select Which Club</label>
                        <select name="sport_id" required>
                            <option value="" disabled selected>Choose Club Life</option>
                            <% Sport.all.order(:name).each do |sport| %>
                                <option value="<%= sport.id %>"><%= sport.name %></option>
                            <% end %>
                        </select>
                        <i class="fa-solid fa-chevron-down bbcc-hero-field-icon" aria-hidden="true"></i>
                    </div>
                    <div class="bbcc-hero-field">
                        <label>Select Date</label>
                        <input type="text" name="date" class="datecourtpicker" placeholder="Select date" autocomplete="off">
                        <i class="fa-regular fa-calendar bbcc-hero-field-icon" aria-hidden="true"></i>
                    </div>
                    <button type="submit" class="bbcc-hero-search-btn">Check Availability</button>
                </div>
            </form>
        </div>
    </div>
</section>
<!-- end hero + availability search -->
