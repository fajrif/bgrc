<div marginwidth="0" marginheight="0" style="background-color:rgb(245,245,245)">
  <div style="margin:0px;padding:70px 0px;width:100%;background-color:rgb(245,245,245)">
    <table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%">
      <tbody>
        <tr>
          <td align="center" valign="top">
            <table border="0" cellpadding="0" cellspacing="0" width="600" style="width:700px;font-family:Helvetica,Arial,sans-serif;border-radius:21px;background-color:rgb(255,255,255)">
              <tbody>
                <tr>
                  <td style="display:block;padding:36px 48px 0 48px">
                    <h1 style="font-size:26px;font-weight:500;text-align:center;color:rgb(80,80,80)">Paid order needs attention</h1>
                  </td>
                </tr>
                <tr>
                  <td valign="top" style="background-color:rgb(255,255,255)">
                    <table border="0" cellpadding="20" cellspacing="0" width="100%">
                      <tbody>
                        <tr>
                          <td valign="top" style="padding:10px 28px 48px 28px;font-size:16px;font-family:Helvetica,Arial,sans-serif;color:rgb(80,80,80)">
                            <p style="margin:0 0 16px">
                              Grab &amp; Go order <strong><%= @food_order.order_id %></strong> has been paid, but stock for at least one
                              item ran out before the payment arrived. The order has gone to the kitchen as normal; please offer
                              <%= @food_order.customer_name %> (<%= @food_order.customer_phone %>) a substitute at pickup.
                            </p>
                            <table border="0" cellpadding="6" cellspacing="0" width="100%" style="font-size:15px;color:rgb(80,80,80)">
                              <tbody>
                                <% @food_order.food_order_items.includes(:menu).each do |item| %>
                                  <% menu = item.menu %>
                                  <tr>
                                    <td><%= item.quantity %> × <%= item.name %></td>
                                    <td style="text-align:right">
                                      <%= menu.nil? || !menu.available? ? "Out of stock" : (menu.stock_count.nil? ? "In stock" : "#{menu.stock_count} left") %>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
