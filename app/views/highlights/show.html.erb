<% if @highlight.image.attached? %>
    <!-- start highlight hero -->
    <section class="bbcc-article-hero" style="background-image:url('<%= url_for(@highlight.image) %>');" aria-label="<%= @highlight.title %>"></section>
    <!-- end highlight hero -->
<% end %>

<%= render "shared/breadcrumb", crumbs: [
  { label: "Highlights", path: highlights_path },
  { label: @highlight.title }
] %>

<!-- start highlight content -->
<section class="bbcc-section bbcc-article">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4">
                <div class="bbcc-article-sidebar-block">
                    <h1 class="bbcc-article-title"><%= @highlight.title %></h1>
                    <p class="bbcc-article-bio"><%= @highlight.short_description %></p>
                    <%= link_to "Contact Us Now", get_contact_path, class: "bbcc-btn" %>
                </div>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-article-body">
                    <%= raw @highlight.content %>
                </div>

                <% if @highlight.images.attached? %>
                    <div class="row g-3 bbcc-article-gallery">
                        <% @highlight.images.each do |img| %>
                            <div class="col-12 col-md-6">
                                <%= image_tag img.variant(resize_to_fill: [750, 500]), alt: @highlight.title %>
                            </div>
                        <% end %>
                    </div>
                <% end %>
            </div>
        </div>
    </div>
</section>
<!-- end highlight content -->

<% if @highlights.any? %>
<!-- start other highlights -->
<section class="bbcc-section bbcc-blog">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-section-title">Other BBCC Highlights</h2>
        </div>
        <div class="row g-4">
            <%= render partial: "card", collection: @highlights, as: :highlight %>
        </div>
    </div>
</section>
<!-- end other highlights -->
<% end %>

<%= render "home/blogs" %>
