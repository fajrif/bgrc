<% content_for :header_light, true %>
<!-- start highlight head -->
<section class="bbcc-intro-head">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-12 col-lg-4">
                <h1 class="bbcc-title-lg bbcc-intro-title"><%= @highlight.title %></h1>
                <p class="bbcc-intro-desc"><%= @highlight.short_description %></p>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-prose bbcc-article-body"><%= raw @highlight.content %></div>
            </div>
        </div>
    </div>
</section>
<!-- end highlight head -->

<% if @highlight.image.attached? || @highlight.images.attached? %>
<!-- start highlight images -->
<section class="bbcc-page-body bbcc-highlight-media">
    <div class="container-lg">
        <div class="bbcc-square-grid">
            <% if @highlight.image.attached? %>
                <%= image_tag @highlight.image.variant(resize_to_fill: [900, 900]), alt: @highlight.title %>
            <% end %>
            <% @highlight.images.each do |img| %>
                <%= image_tag img.variant(resize_to_fill: [900, 900]), alt: @highlight.title, loading: "lazy" %>
            <% end %>
        </div>
    </div>
</section>
<!-- end highlight images -->
<% end %>

<%= render "shared/bbcc_highlights", title: "Other Highlights", highlights: @highlights %>
<%= render "home/social_media" %>
