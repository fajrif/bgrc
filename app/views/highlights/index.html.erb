<%
  tabs = [{ label: "All", path: highlights_path, active: @category.nil? }] +
         @categories.map { |c| { label: c.name, path: highlights_path(category_id: c.id), active: @category == c } }
%>
<%= render "shared/page_intro", title: "BBCC Highlights", tabs: tabs,
    description: simple_format("Socials, clinics, tournaments and the regular fixtures that make up the club calendar \u2014 on the course, on the courts and around the club.") %>

<!-- start highlights index -->
<section class="bbcc-page-body bbcc-blog-index">
    <div class="container-lg">
        <% if @highlights.any? %>
            <div class="bbcc-post-grid" id="highlights-grid">
                <%= render partial: "card", collection: @highlights, as: :highlight %>
            </div>
            <%= paginate @highlights, theme: "bbcc" %>
        <% else %>
            <p class="bbcc-empty">No highlights in this category yet.</p>
        <% end %>
    </div>
</section>
<!-- end highlights index -->

<%= render "home/blogs" %>
<%= render "home/social_media" %>
