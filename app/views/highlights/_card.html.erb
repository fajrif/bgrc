<div class="col-12 col-md-6 col-lg-4">
    <article class="bbcc-post">
        <%= link_to highlight_path(highlight), class: "bbcc-post-image" do %>
            <% if highlight.image.attached? %>
                <%= image_tag highlight.image.variant(resize_to_fill: [750, 500]), alt: highlight.title %>
            <% else %>
                <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-4.png') %>');"></span>
            <% end %>
        <% end %>
        <div class="bbcc-post-body">
            <span class="bbcc-post-meta"><%= raw highlight.meta_label %></span>
            <%= link_to highlight.title, highlight_path(highlight), class: "bbcc-post-title" %>
            <p class="bbcc-post-excerpt"><%= highlight.short_description.to_s.truncate(140) %></p>
            <%= link_to "Read More", highlight_path(highlight), class: "bbcc-btn" %>
        </div>
    </article>
</div>
