<%= render "shared/small_banner", title: @recurring_event.title, page_name: @recurring_event.title %>

<section class="pt-5 pb-5">
  <div class="container">
    <div class="row">
      <!-- event details -->
      <div class="col-lg-5 col-md-6 mb-4 mb-md-0">
        <% if @recurring_event.image.attached? %>
          <div class="mb-4 overflow-hidden">
            <%= image_tag @recurring_event.image.variant(resize_to_fill: [600, 350]), class: "img-fluid w-100" %>
          </div>
        <% end %>

        <h6 class="alt-font text-extra-dark-gray mb-3"><%= @recurring_event.title %></h6>

        <% if @recurring_event.short_description.present? %>
          <p class="text-medium mb-4"><%= @recurring_event.short_description %></p>
        <% end %>

        <table class="table table-borderless">
          <tr>
            <td class="text-medium ps-0" style="width:40%;">Court</td>
            <td><%= @recurring_event.court.try(:name_label) %></td>
          </tr>
          <tr>
            <td class="text-medium ps-0">Schedule</td>
            <td>
              <% if @recurring_event.one_time? %>
                <%= @recurring_event.specific_date.strftime("%A, %d %b %Y") %>
              <% else %>
                Every <%= @recurring_event.day_name %>
              <% end %>
              &nbsp;&middot;&nbsp; <%= @recurring_event.start_time %> – <%= @recurring_event.end_time %>
            </td>
          </tr>
          <% if @recurring_event.capacity > 0 %>
          <tr>
            <td class="text-medium ps-0">Capacity</td>
            <td>
              <%= @recurring_event.event_rsvps.count %> / <%= @recurring_event.capacity %> registered
            </td>
          </tr>
          <% end %>
        </table>

        <% if @recurring_event.description.present? %>
          <div class="text-medium mt-3"><%= raw @recurring_event.description %></div>
        <% end %>
      </div>

      <!-- RSVP panel -->
      <div class="col-lg-7 col-md-6">
        <div class="card border-0 box-shadow p-4">
          <% if @recurring_event.rsvp_open? %>
            <h6 class="alt-font text-extra-dark-gray mb-3">Sign Up for this Event</h6>

            <% if flash[:notice] %>
              <div class="alert alert-success"><%= flash[:notice] %></div>
            <% end %>

            <%= form_tag rsvp_recurring_event_path(@recurring_event), method: :post do %>
              <% if @rsvp.errors.any? %>
                <div class="alert alert-danger">
                  <% @rsvp.errors.full_messages.each do |msg| %>
                    <div><%= msg %></div>
                  <% end %>
                </div>
              <% end %>

              <div class="mb-3">
                <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                <%= text_field_tag "event_rsvp[full_name]", @rsvp.full_name, class: "form-control", placeholder: "Your full name" %>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                <%= email_field_tag "event_rsvp[email]", @rsvp.email, class: "form-control", placeholder: "your@email.com" %>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Phone</label>
                <%= text_field_tag "event_rsvp[phone]", @rsvp.phone, class: "form-control", placeholder: "+62..." %>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">Date of Birth</label>
                  <%= date_field_tag "event_rsvp[dob]", @rsvp.dob, class: "form-control" %>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">Gender</label>
                  <%= select_tag "event_rsvp[gender]", options_for_select(EventRsvp::GENDERS, @rsvp.gender), include_blank: "— Select —", class: "form-select" %>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Address</label>
                <%= text_area_tag "event_rsvp[address]", @rsvp.address, class: "form-control", rows: 3, placeholder: "Your address" %>
              </div>

              <button type="submit" class="btn btn-dark w-100 text-uppercase letter-spacing-1 text-extra-small text-white">
                Register for this Event
              </button>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <p class="text-medium mb-0">This event is fully booked.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
