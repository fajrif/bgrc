<div marginwidth="0" marginheight="0" style="background-color:rgb(245,245,245)">
  <div style="margin:0px;padding:70px 0px;width:100%;background-color:rgb(245,245,245)">
    <table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%">
      <tbody>
        <tr>
          <td align="center" valign="top">
            <table border="0" cellpadding="0" cellspacing="0" width="600" style="width:700px;font-family:Helvetica,Arial,sans-serif;border-radius:21px;background-color:rgb(255,255,255)">
              <tbody>
                <tr>
                  <td style="display:block;padding:36px 48px 0 48px">
                    <h1 style="font-size:26px;font-weight:500;text-align:center;color:rgb(80,80,80)">New Golf Reservation</h1>
                  </td>
                </tr>
                <tr>
                  <td valign="top" style="background-color:rgb(255,255,255)">
                    <table border="0" cellpadding="20" cellspacing="0" width="100%">
                      <tbody>
                        <tr>
                          <td valign="top" style="padding:10px 28px 48px 28px;font-size:16px;font-family:Helvetica,Arial,sans-serif;color:rgb(80,80,80)">
                            <table cellspacing="0" cellpadding="6">
                              <tbody>
                                <tr><td style="padding:4px 12px;">Order ID:</td><td style="padding:4px 12px;"><%= @golf_reservation.order_id %></td></tr>
                                <tr><td style="padding:4px 12px;">Customer:</td><td style="padding:4px 12px;"><%= @golf_reservation.user&.full_name || "Guest" %></td></tr>
                                <tr><td style="padding:4px 12px;">Tee Time:</td><td style="padding:4px 12px;"><%= @golf_reservation.tee_time_label %></td></tr>
                                <tr><td style="padding:4px 12px;">Holes:</td><td style="padding:4px 12px;"><%= @golf_reservation.holes_label %></td></tr>
                                <tr><td style="padding:4px 12px;">Players:</td><td style="padding:4px 12px;"><%= @golf_reservation.players_count %></td></tr>
                                <tr><td style="padding:4px 12px;font-weight:bold;">Total:</td><td style="padding:4px 12px;font-weight:bold;"><%= @golf_reservation.total_price_label %></td></tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
