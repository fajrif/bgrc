<!-- Golf Reservation New -->
<section>
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="border padding-30px-all margin-60px-top margin-60px-bottom">
          <h4 class="alt-font text-uppercase font-weight-600 margin-20px-bottom">Book Your Tee Time</h4>

          <% if @tee_time.blank? %>
            <div class="alert alert-warning">
              No tee time selected. <a href="<%= golf_path %>">Choose from available slots.</a>
            </div>
          <% end %>

          <%= form_tag golf_reservations_path, method: :post do %>
            <input type="hidden" name="tee_time" value="<%= @tee_time %>">

            <!-- Tee Time Display -->
            <div class="mb-4">
              <label class="text-medium font-weight-600 mb-1 d-block">Selected Tee Time</label>
              <div class="border padding-15px-all" style="background-color:#f8f9fa;border-radius:6px;">
                <% if @tee_time.present? %>
                  <% tt = DateTime.parse(@tee_time) rescue nil %>
                  <span class="text-medium font-weight-600">
                    <%= tt ? tt.strftime("%A, %d %B %Y — %I:%M %p") : @tee_time %>
                  </span>
                <% else %>
                  <span class="text-medium text-medium-gray">No tee time selected</span>
                <% end %>
              </div>
            </div>

            <!-- Players -->
            <div class="mb-4">
              <label class="text-medium font-weight-600 mb-2 d-block" for="players_count">Number of Players</label>
              <select name="players_count" id="players_count" class="form-select text-medium">
                <% [1, 2, 3, 4].each do |n| %>
                  <option value="<%= n %>"><%= n %> <%= "Player".pluralize(n) %></option>
                <% end %>
              </select>
            </div>

            <!-- Holes -->
            <div class="mb-4">
              <label class="text-medium font-weight-600 mb-2 d-block">Number of Holes</label>
              <div class="d-flex flex-wrap gap-3">
                <% @golf_course.holes_list.each do |holes| %>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="holes" id="holes_<%= holes %>"
                           value="<%= holes %>" <%= holes == 18 ? "checked" : "" %>>
                    <label class="form-check-label text-medium" for="holes_<%= holes %>">
                      <%= holes %> Holes
                    </label>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="d-flex gap-3">
              <%= link_to "Back", golf_path, class: "btn btn-light-gray btn-medium text-medium" %>
              <%= submit_tag "Reserve Tee Time", class: "btn btn-dark-gray btn-medium text-medium", disabled: @tee_time.blank? %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

