<% status_class, status_text =
     if @golf_reservation.is_unpaid? then ["", "AWAITING PAYMENT"]
     elsif @golf_reservation.status == GolfReservation::PAID then ["is-paid", "PAID ✓"]
     elsif @golf_reservation.expired? then ["is-expired", "EXPIRED"]
     else ["is-expired", "CANCELLED"] end %>
<div id="payment-status-badge" class="bbcc-status-bar <%= status_class %>">
  <small>STATUS: <%= status_text %></small>
</div>

<ul class="bbcc-confirm-lines">
  <li><span>Green Fee (<%= @golf_reservation.holes_label %> × <%= @golf_reservation.players_count %> pax)</span><span><%= @golf_reservation.green_fee_label %></span></li>
  <% @golf_reservation.golf_add_ons.each do |ao| %>
    <li><span><%= ao.item_with_quantity %></span><span><%= ao.total_price_label %></span></li>
  <% end %>
  <li class="is-total"><span>Total</span><span><%= @golf_reservation.total_price_label %></span></li>
</ul>

<% if @golf_reservation.is_unpaid? %>
  <div id="payment-actions" class="bbcc-confirm-actions">
    <%= link_to "Cancel", golf_reservation_path(@golf_reservation.order_id), class: "bbcc-btn bbcc-btn-light", method: :delete, data: { confirm: "Cancel this reservation?" } %>
    <% if user_signed_in? %>
      <a href="#" class="bbcc-btn" data-bs-toggle="modal" data-bs-target="#disclaimerModal">Pay Now</a>
    <% else %>
      <a href="#" class="bbcc-btn" data-bs-toggle="modal" data-bs-target="#loginModal">Pay Now</a>
    <% end %>
  </div>
  <div id="expired-actions" class="bbcc-confirm-end" hidden>
    <p>The time limit for payment has expired.</p>
    <%= link_to "Search Again", golf_path, class: "bbcc-btn bbcc-btn-light" %>
  </div>
<% elsif @golf_reservation.expired? %>
  <div class="bbcc-confirm-end">
    <p>The time limit for payment has expired.</p>
    <%= link_to "Book Again", golf_path, class: "bbcc-btn bbcc-btn-light" %>
  </div>
<% elsif @golf_reservation.cancelled? %>
  <div class="bbcc-confirm-end">
    <p>This reservation has been cancelled.</p>
    <%= link_to "Book Again", golf_path, class: "bbcc-btn bbcc-btn-light" %>
  </div>
<% else %>
  <div class="bbcc-confirm-end">
    <div class="bbcc-confirm-qr"><%= raw @golf_reservation.qrcode %></div>
    <p>Show this QR code upon arrival</p>
  </div>
<% end %>
