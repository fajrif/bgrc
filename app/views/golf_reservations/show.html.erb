<%= content_for :head do %>
  <% if user_signed_in? && @golf_reservation.is_unpaid? %>
    <%= gateway_checkout_script_tag %>
  <% end %>
<% end %>

<% content_for :header_light, true %>

<section class="bbcc-section bbcc-confirm">
  <div class="container-lg">
    <div class="row g-4 g-lg-5">
      <article class="col-12 col-lg-8">
        <p class="bbcc-confirm-id">Order ID: <%= @golf_reservation.order_id %></p>
        <h1 class="bbcc-confirm-title">Golf Tee Time Booking Confirmation</h1>
        <p class="bbcc-confirm-when"><%= @golf_reservation.tee_time_label %></p>

        <ul class="bbcc-confirm-facts">
          <li>Course: <%= @golf_reservation.golf_course.name %></li>
          <li>Holes: <%= @golf_reservation.holes_label %></li>
          <li>Players: <%= @golf_reservation.players_count %></li>
          <% names = Array(@golf_reservation.player_names).reject(&:blank?) %>
          <% if names.any? %>
            <li>Other players: <%= names.join(", ") %></li>
          <% end %>
          <% if @golf_reservation.notes.present? %>
            <li>Notes: <%= @golf_reservation.notes %></li>
          <% end %>
          <% if @golf_reservation.is_unpaid? %>
            <li id="cancellation-note">Please note: Reservations cannot be canceled or refunded once payment is completed.</li>
          <% end %>
        </ul>

        <div id="itemLists" class="bbcc-confirm-addons">
          <%= render "item_lists" %>
        </div>
      </article>

      <aside class="col-12 col-lg-4">
        <div class="bbcc-confirm-panel">
          <h2 class="bbcc-confirm-panel-title">Booking Details</h2>
          <%= render "shared/payment_countdown", record: @golf_reservation, noun: "reservation",
                     expire_url: expire_golf_reservation_path(@golf_reservation.order_id) %>
          <div id="itemListsPayment">
            <%= render "item_lists_payment" %>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<%= render "home/social_media" %>

<% unless user_signed_in? %>
  <%= render "bookings/login_modal" %>
<% end %>

<% if user_signed_in? && @golf_reservation.is_unpaid? %>
  <%= render "golf_reservations/disclaimer_modal" %>
<% end %>

<% if @golf_reservation.is_unpaid? %>
  <%= render "shared/payment_timer" %>
<% end %>
