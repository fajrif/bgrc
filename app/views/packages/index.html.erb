<%= render "home/banner" %>
<section class="wow animate__fadeIn">
    <div class="container">
        <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 justify-content-start align-items-center">
          <% @packages.each do |package| %>
            <!-- start features box item -->
            <div class="col margin-30px-bottom wow animate__fadeInUp">
                <div class="text-white">
                    <%= link_to package_path(package) do %>
                      <%= image_tag package.image.variant(resize_to_fill: [750,500]) %>
                    <% end %>
                    <div class="padding-25px-all bg-medium-grey">
                      <span class="font-weight-600 d-block alt-font text-uppercase margin-10px-bottom"><%= package.name %></span>
                      <hr/>
                      <span class="font-weight-500 d-block alt-font margin-10px-bottom text-uppercase"><%= package.sport.name %></span>
                      <p><%= package.short_description.truncate(150) %></p>
                      <p class="text-medium">Valid: <%= package.valid_date %></p>
                      <%= link_to "Read More", package_path(package), class: "btn btn-medium btn-light-gray w-100" %>
                    </div>
                </div>
            </div>
            <!-- end features box item -->
          <% end %>
        </div>
        <%= paginate @packages, theme: :pofo %>
    </div>
</section>
