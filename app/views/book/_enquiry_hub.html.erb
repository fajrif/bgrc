<%# locals: active:, title:, lead:, section:, children:, treatments: (optional)
    Shared by the two hub categories that have no online booking of their own —
    they list what can be booked and hand off to the enquiry form. %>
<% treatments = local_assigns.fetch(:treatments, []) %>
<%= render "shared/breadcrumb", crumbs: [{ label: "Book", path: book_path }, { label: title }] %>

<section class="bbcc-section bbcc-hub">
    <div class="container-lg">
        <%= render "shared/booking_hub_tabs", active: active %>

        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4">
                <h2 class="bbcc-hub-heading"><%= title %></h2>
                <p class="bbcc-lead"><%= lead %></p>
                <%= link_to "Enquire Now", get_contact_path, class: "bbcc-btn" %>
                <% if section %>
                    <p class="mt-3 bbcc-lead mb-0">
                        <%= link_to "Read more about #{title}", club_life_page_path(section) %>
                    </p>
                <% end %>
            </div>

            <div class="col-12 col-lg-8">
                <% if children.any? %>
                    <div class="row g-4">
                        <% children.each do |child| %>
                            <div class="col-12 col-md-6">
                                <article class="bbcc-service-card">
                                    <%= link_to club_life_page_path(child), class: "bbcc-service-card-image" do %>
                                        <% if child.card_image.present? %>
                                            <%= image_tag child.card_image.variant(resize_to_fill: [750, 500]), alt: child.name %>
                                        <% else %>
                                            <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-4.png') %>');"></span>
                                        <% end %>
                                    <% end %>
                                    <div class="bbcc-service-card-body">
                                        <%= link_to child.name, club_life_page_path(child), class: "bbcc-service-card-title" %>
                                        <p class="bbcc-service-card-desc"><%= child.short_description.to_s.truncate(120) %></p>
                                    </div>
                                </article>
                            </div>
                        <% end %>
                    </div>
                <% else %>
                    <div class="bbcc-table-empty">
                        <p>Details are not available yet. Please check back later.</p>
                        <%= link_to "Explore Club Life", club_life_path, class: "bbcc-btn" %>
                    </div>
                <% end %>
            </div>
        </div>

        <% if treatments.any? %>
            <h2 class="bbcc-hub-heading mt-5">Treatments &amp; Services</h2>
            <div class="row g-4">
                <% treatments.each do |treatment| %>
                    <div class="col-12 col-md-6 col-lg-3">
                        <article class="bbcc-service-card bbcc-treatment-card">
                            <span class="bbcc-service-card-image">
                                <% if treatment.image.attached? %>
                                    <%= image_tag treatment.image.variant(resize_to_fill: [750, 500]), alt: treatment.name %>
                                <% end %>
                            </span>
                            <div class="bbcc-service-card-body">
                                <h3 class="bbcc-service-card-title"><%= treatment.name %></h3>
                                <p class="bbcc-service-card-desc"><%= treatment.short_description %></p>
                                <p class="bbcc-treatment-meta">
                                    <%= treatment.duration %><%= " &middot; #{treatment.price}".html_safe if treatment.price.present? %>
                                </p>
                            </div>
                        </article>
                    </div>
                <% end %>
            </div>
        <% end %>
    </div>
</section>
