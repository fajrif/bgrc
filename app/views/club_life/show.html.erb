<% gallery_initial = 6 %>
<%# each section fronts its own hero banner, falling back to its root's, then to the bundled Phase 4 photo, then to the shared Club Life banner %>
<%
  own_banner = @section.banner.attached? ? url_for(@section.banner) : nil
  hero_image = own_banner ||
    (url_for(@root.banner) if @root&.banner&.attached?) ||
    club_life_fallback_banner(@section) ||
    (url_for(@banner.image) if @banner&.image&.attached?)
  # Golf ships with its own banner until one is uploaded in the admin
  hero_image ||= image_url("new-design/banner-golf.png") if (@root || @section).en_name == "Golf"
  # a plain child page shows its own banner as a band under the intro, never its root's
  band_image = own_banner || club_life_fallback_banner(@section)
  racquet_root = @show_mits && @root == @section
  beach_club   = @section.en_name == "Beach Club"
%>
<% if @band_layout %>
    <% content_for :header_light, true %>
<% else %>
    <%= render "shared/hero_search", hero_image: hero_image, selected_sport_id: @section.sport_id %>
<% end %>

<div class="bbcc-clublife-page<%= " bbcc-band-page" if @band_layout %><%= " bbcc-fitness-page" if @fitness_child || @spa_child %><%= " bbcc-fitness-root" if @fitness_root || @spa_root %>">
<!-- start club life tabs -->
<% tab_root = @root || @section %>
<nav class="bbcc-clublife-tabs bbcc-clublife-tabs-row-only" aria-label="Club Life sections">
    <div class="container-lg">
        <% if @band_layout %>
            <% if @show_subtabs %>
                <div class="bbcc-clublife-tabs-row">
                    <% tab_root.children.each do |child| %>
                        <%= link_to child.name, club_life_page_path(child), class: ("active" if child == @section), "aria-current": (child == @section ? "page" : nil) %>
                    <% end %>
                </div>
            <% end %>
        <% else %>
            <div class="bbcc-clublife-tabs-row">
                <% Facility.club_life_roots.each do |section| %>
                    <%= link_to section.name.sub("+", "&"), club_life_page_path(section), class: ("active" if section == tab_root), "aria-current": (section == tab_root ? "page" : nil) %>
                <% end %>
            </div>
            <% if tab_root.children.any? && !racquet_root && !@fitness_root && !@spa_root %>
                <div class="bbcc-clublife-subtabs">
                    <% tab_root.children.each do |child| %>
                        <%= link_to child.name, club_life_page_path(child), class: ("active" if child == @section) %>
                    <% end %>
                </div>
            <% end %>
        <% end %>
    </div>
</nav>
<!-- end club life tabs -->

<!-- start club life section -->
<section class="bbcc-section bbcc-clublife-section">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4">
                <h1 class="bbcc-title-lg"><%= @spa_child ? @section.heading : "BBCC #{@spa_root ? @section.name.sub("+", "&") : @section.name}" %></h1>
            </div>
            <div class="col-12 col-lg-8">
                <p class="bbcc-lead"><%= @section.short_description %></p>
                <div class="bbcc-clublife-body">
                    <% @section.description.to_s.split(/\n+/).each do |para| %>
                        <p><%= para %></p>
                    <% end %>
                </div>
                <%# free-form info blocks — opening hours, capacity, pool specs, ... %>
                <% @details.each do |detail| %>
                    <h2 class="bbcc-detail-title"><%= detail.title %></h2>
                    <div class="bbcc-detail-body">
                        <%= club_life_detail_body(detail.body) %>
                    </div>
                <% end %>
                <% if @section.cta_url.present? %>
                    <% cta_external = @section.cta_url.start_with?("http://", "https://") %>
                    <%= link_to (@section.cta_label.presence || "Enquire Today"), @section.cta_url, class: "bbcc-solid-btn",
                                target: (cta_external ? "_blank" : nil), rel: (cta_external ? "noopener" : nil) %>
                <% end %>
            </div>
        </div>
    </div>
</section>
<!-- end club life section -->

<% if @band_layout && band_image.present? %>
    <!-- start club life banner band -->
    <section class="bbcc-clublife-band" style="background-image:url('<%= band_image %>');" role="img" aria-label="<%= @section.name %>"></section>
    <!-- end club life banner band -->
<% end %>

<% unless @band_layout || beach_club || racquet_root || @fitness_root || @spa_root %>
    <%= render "shared/bbcc_highlights" %>
<% end %>

<% if @section.middle_banner.attached? && !@band_layout %>
    <!-- start club life middle banner -->
    <section class="bbcc-section bbcc-midbanner">
        <div class="container-lg">
            <span class="bbcc-midbanner-image" style="background-image:url('<%= url_for(@section.middle_banner) %>');"
                  role="img" aria-label="<%= @section.name %>"></span>
            <% if (@fitness_root || @spa_root) && @section.facilities_intro.present? %>
                <p class="bbcc-midbanner-caption"><%= @section.facilities_intro %></p>
            <% end %>
        </div>
    </section>
    <!-- end club life middle banner -->
<% end %>

<% if @benefits.any? %>
    <%= render "club_life/benefit_cards", section: @section, benefits: @benefits %>
<% end %>

<% if @rate_cards.any? && @section.show_pricing? %>
    <% book_path = @section.sport_id.present? ? search_path(sport_id: @section.sport_id) : (@section.cta_url.presence || get_contact_path) %>
    <% if @band_layout %>
        <!-- start club life pricing (photo cards) -->
        <section class="bbcc-section bbcc-rate-row">
            <div class="container-lg">
                <div class="bbcc-section-head">
                    <h2 class="bbcc-title-lg"><%= @section.name %> Pricing</h2>
                </div>
                <% wide = @rate_cards.size < 3 %>
                <div class="row g-4">
                    <% @rate_cards.each_with_index do |rate, index| %>
                        <%# a rate with no photo of its own borrows the page's gallery, in order %>
                        <% photo = rate[:image] || (@gallery[index % @gallery.size] if @gallery.any?) %>
                        <div class="col-12 <%= wide ? "col-md-6" : "col-6 col-lg-3" %>">
                            <%= render "club_life/media_card", title: rate[:name], image: photo,
                                       size: (wide ? [900, 560] : (@fitness_child ? [650, 696] : [600, 800])), ratio: (wide ? "landscape" : (@fitness_child ? "pricing" : "portrait")),
                                       lines: [(rate[:time].present? ? "Time: #{rate[:time]}" : nil),
                                               (rate[:duration].present? ? "Duration: #{rate[:duration]}" : nil),
                                               (rate[:access].present? ? "Access: #{rate[:access]}" : nil),
                                               "Price: #{rate[:price]}"],
                                       link_label: "Book Now",
                                       link_path: (@section.sport_id.present? ? book_path : get_contact_path(about: "#{@section.name} – #{rate[:name]}")) %>
                        </div>
                    <% end %>
                </div>
            </div>
        </section>
        <!-- end club life pricing -->
    <% else %>
        <!-- start club life pricing -->
        <section class="bbcc-section bbcc-rate-row bbcc-section-alt">
            <div class="container-lg">
                <div class="bbcc-section-head bbcc-section-head-center">
                    <h2 class="bbcc-section-title">BBCC <%= @section.name %> Pricing</h2>
                </div>
                <div class="row g-4">
                    <% @rate_cards.each do |rate| %>
                        <div class="col-12 col-sm-6 col-lg-3">
                            <article class="bbcc-rate-card">
                                <% if @sport_rates %>
                                    <i class="fa-solid fa-table-tennis-paddle-ball bbcc-rate-card-icon" aria-hidden="true"></i>
                                <% end %>
                                <h3 class="bbcc-rate-card-title"><%= rate[:name] %></h3>
                                <p class="bbcc-rate-card-meta">
                                    <% if rate[:time].present? %><span>Time: <%= rate[:time] %></span><% end %>
                                    <% if rate[:duration].present? %><span>Duration: <%= rate[:duration] %></span><% end %>
                                    <% if rate[:access].present? %><span>Access: <%= rate[:access] %></span><% end %>
                                    <span>Price: <%= rate[:price] %></span>
                                </p>
                                <%= link_to "Book Now", book_path, class: "bbcc-btn bbcc-btn-block" %>
                            </article>
                        </div>
                    <% end %>
                </div>
            </div>
        </section>
        <!-- end club life pricing -->
    <% end %>
<% end %>

<% if @amenities.any? && beach_club %>
    <%= render "club_life/venue_slider", section: @section, venues: @amenities %>
<% elsif @amenities.any? && @band_layout %>
    <%= render "club_life/facility_grid", section: @section, items: @amenities, square: (@fitness_child || @spa_child),
               title: (@spa_child && @section.page_heading.present? ? "#{@section.heading} Facilities" : nil) %>
<% elsif @amenities.any? %>
    <!-- start club life facilities (card-only, no page of their own) -->
    <section class="bbcc-section bbcc-cat-row">
        <div class="container-lg">
            <div class="bbcc-section-head bbcc-section-head-center">
                <h2 class="bbcc-section-title">BBCC <%= @section.name %> Facilities</h2>
                <% if @section.facilities_intro.present? %>
                    <p class="bbcc-lead bbcc-section-sub"><%= @section.facilities_intro %></p>
                <% end %>
            </div>
            <%# a trailing row of two runs half-width each, so the mosaic never
                leaves a third of the row empty %>
            <% pairs_last = @amenities.size % 3 == 2 %>
            <div class="row g-4">
                <% @amenities.each_with_index do |amenity, index| %>
                    <div class="col-12 col-md-6 <%= pairs_last && index >= @amenities.size - 2 ? "col-lg-6" : "col-lg-4" %>">
                        <%= render "shared/category_card", facility: amenity %>
                    </div>
                <% end %>
            </div>
        </div>
    </section>
    <!-- end club life facilities -->
<% elsif @fitness_root && @children.any? %>
    <%= render "club_life/children_slider", title: "BBCC #{@section.name}", children: @children %>
<% elsif @children.any? && @use_overlay_cards %>
    <!-- start club life categories -->
    <section class="bbcc-section bbcc-cat-row">
        <div class="container-lg">
            <% if @spa_root %>
                <div class="bbcc-section-head">
                    <h2 class="bbcc-title-lg">Services</h2>
                </div>
            <% end %>
            <div class="row g-4">
                <% @children.each do |child| %>
                    <div class="col-12 col-md-6 col-lg-4">
                        <%= render "club_life/media_card", title: child.heading, image: child.card_image,
                                   size: [900, 800], ratio: "square",
                                   text: child.short_description.to_s.truncate(120),
                                   link_label: "Discover more", link_path: club_life_page_path(child) %>
                    </div>
                <% end %>
            </div>
        </div>
    </section>
    <!-- end club life categories -->
<% elsif @children.any? %>
    <%= render "club_life/child_cards", children: @children, title: "BBCC #{@section.name}" %>
<% end %>

<% if @treatments.any? %>
    <% book_path = @section.cta_url.presence || get_contact_path %>
    <% if @band_layout %>
        <!-- start club life lessons (photo cards) -->
        <% treatment_categories = GroupClass::CATEGORIES.select { |_label, slug| @treatments.any? { |t| t.category == slug } } %>
        <section class="bbcc-section bbcc-service-row" data-class-filter>
            <div class="container-lg">
                <div class="bbcc-section-head">
                    <h2 class="bbcc-title-lg"><%= @section.treatments_title.presence || "Treatment" %></h2>
                </div>
                <% if treatment_categories.size > 1 %>
                    <nav class="bbcc-tabs bbcc-tabs-center bbcc-class-tabs" aria-label="Class categories">
                        <button type="button" class="bbcc-tab active" data-filter="all">All</button>
                        <% treatment_categories.each do |label, slug| %>
                            <button type="button" class="bbcc-tab" data-filter="<%= slug %>"><%= label.pluralize %></button>
                        <% end %>
                    </nav>
                <% end %>
                <div class="row g-4 bbcc-class-grid">
                    <% @treatments.each do |treatment| %>
                        <div class="col-6 col-lg-<%= (@fitness_child || @spa_child) ? 4 : 3 %> bbcc-class-col" data-category="<%= treatment.category %>">
                            <%= render "club_life/media_card", title: treatment.name, image: treatment.image,
                                       size: ((@fitness_child || @spa_child) ? [880, 756] : [600, 800]), ratio: ((@fitness_child || @spa_child) ? "photo" : "portrait"),
                                       text: treatment.short_description, chip: (treatment_categories.size > 1 ? treatment.category_label : nil),
                                       lines: [(treatment.duration.present? ? "Duration: #{treatment.duration}" : nil),
                                               (treatment.price.present? ? "Price: #{treatment.price}" : nil)],
                                       link_label: "Book Now",
                                       link_path: ((@fitness_child || @spa_child) ? get_contact_path(about: "#{@section.name} – #{treatment.name}") : book_path) %>
                        </div>
                    <% end %>
                </div>
            </div>
        </section>
        <!-- end club life lessons -->
    <% else %>
        <!-- start club life treatments -->
        <section class="bbcc-section bbcc-service-row">
            <div class="container-lg">
                <div class="bbcc-section-head bbcc-section-head-center">
                    <h2 class="bbcc-section-title"><%= @section.treatments_title.presence || "Treatment" %></h2>
                </div>
                <div class="row g-4">
                    <% @treatments.each do |treatment| %>
                        <div class="col-12 col-md-6 col-lg-4">
                            <article class="bbcc-service-card bbcc-treatment-card">
                                <span class="bbcc-service-card-image">
                                    <% if treatment.image.attached? %>
                                        <%= image_tag treatment.image.variant(resize_to_fill: [750, 500]), alt: treatment.name %>
                                    <% else %>
                                        <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-4.png') %>');"></span>
                                    <% end %>
                                </span>
                                <div class="bbcc-service-card-body">
                                    <h3 class="bbcc-service-card-title"><%= treatment.name %></h3>
                                    <p class="bbcc-service-card-desc"><%= treatment.short_description %></p>
                                    <p class="bbcc-treatment-meta">
                                        <% if treatment.duration.present? %><span>Duration: <%= treatment.duration %></span><% end %>
                                        <% if treatment.price.present? %><span>Price: <%= treatment.price %></span><% end %>
                                    </p>
                                    <%= link_to "Book Now", book_path, class: "bbcc-btn bbcc-btn-block" %>
                                </div>
                            </article>
                        </div>
                    <% end %>
                </div>
            </div>
        </section>
        <!-- end club life treatments -->
    <% end %>
<% end %>

<% if @group_classes.any? %>
    <%# only offer a tab for a category that actually has classes here %>
    <% present_categories = GroupClass::CATEGORIES.select { |_label, slug| @group_classes.any? { |gc| gc.category == slug } } %>
    <!-- start club life classes -->
    <section class="bbcc-section bbcc-classes-row<%= " bbcc-section-alt" unless @band_layout %>" data-class-filter>
        <div class="container-lg">
            <div class="bbcc-section-head bbcc-section-head-center">
                <h2 class="bbcc-section-title">BBCC <%= @section.name %> Classes</h2>
            </div>

            <% if present_categories.size > 1 %>
                <nav class="bbcc-tabs bbcc-tabs-center bbcc-class-tabs" aria-label="Class categories">
                    <button type="button" class="bbcc-tab active" data-filter="all">All</button>
                    <% present_categories.each do |label, slug| %>
                        <button type="button" class="bbcc-tab" data-filter="<%= slug %>"><%= label.pluralize %></button>
                    <% end %>
                </nav>
            <% end %>

            <div class="row g-4 bbcc-class-grid">
                <% @group_classes.each do |group_class| %>
                    <%= render "shared/class_card", gc: group_class,
                                book_path: group_class_path(group_class),
                                date_label: (group_class.upcoming_sessions.first&.dig(:date_label) if group_class.is_prescheduled?),
                                cta_label: (@band_layout ? "Book Now" : "View Class") %>
                <% end %>
            </div>
        </div>
    </section>
    <!-- end club life classes -->

<% end %>

<% if @treatments.any? || @group_classes.any? %>
    <script>
      // plain JS: filters in place so the visitor keeps their scroll position,
      // which a link_to tab strip two-thirds down the page would lose.
      document.querySelectorAll('[data-class-filter]').forEach(function (section) {
        var tabs = section.querySelectorAll('.bbcc-class-tabs .bbcc-tab');
        var cards = section.querySelectorAll('.bbcc-class-grid .bbcc-class-col');
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var filter = tab.getAttribute('data-filter');
            tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
            cards.forEach(function (card) {
              var show = filter === 'all' || card.getAttribute('data-category') === filter;
              card.classList.toggle('bbcc-class-col-hidden', !show);
            });
          });
        });
      });
    </script>
<% end %>

<% if @coaches.any? %>
    <!-- start club life coaches -->
    <section class="bbcc-section bbcc-coach-row">
        <div class="container-lg">
            <div class="bbcc-section-head bbcc-section-head-center">
                <h2 class="bbcc-section-title"><%= @band_layout && @group_classes.any? ? "Our Coaches" : "BBCC #{@section.name} Coaches" %></h2>
            </div>
            <div class="row g-4">
                <% @coaches.each do |coach| %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <article class="bbcc-team-card">
                            <span class="bbcc-team-card-image">
                                <% if coach.photo.attached? %>
                                    <%= image_tag coach.photo.variant(resize_to_fill: [600, 700]), alt: coach.name %>
                                <% else %>
                                    <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-2.png') %>');"></span>
                                <% end %>
                            </span>
                            <div class="bbcc-team-card-body">
                                <div class="bbcc-team-card-meta">
                                    <span class="bbcc-team-card-dept"><%= coach.sport&.name %></span>
                                    <span class="bbcc-team-card-role"><%= coach.role %></span>
                                </div>
                                <span class="bbcc-team-card-name"><%= coach.name %></span>
                                <p class="bbcc-team-card-bio"><%= coach.bio.to_s.truncate(160) %></p>
                            </div>
                        </article>
                    </div>
                <% end %>
            </div>
        </div>
    </section>
    <!-- end club life coaches -->
<% end %>

<% if @fitness_team.any? %>
    <!-- start fitness team -->
    <section class="bbcc-section bbcc-coach-row bbcc-fitness-team">
        <div class="container-lg">
            <div class="bbcc-section-head bbcc-section-head-center">
                <h2 class="bbcc-title-lg"><%= @fitness_root ? "Our #{@section.name} Team" : "Our Coaches" %></h2>
            </div>
            <div class="row g-4">
                <% @fitness_team.each do |member| %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <article class="bbcc-team-card">
                            <span class="bbcc-team-card-image">
                                <% if member.photo.attached? %>
                                    <%= image_tag member.photo.variant(resize_to_fill: [900, 900]), alt: member.name, loading: "lazy" %>
                                <% else %>
                                    <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-2.png') %>');"></span>
                                <% end %>
                            </span>
                            <div class="bbcc-team-card-body">
                                <div class="bbcc-team-card-meta">
                                    <span class="bbcc-team-card-dept"><%= member.department_label %></span>
                                    <span class="bbcc-team-card-role"><%= member.role %></span>
                                </div>
                                <span class="bbcc-team-card-name"><%= member.name %></span>
                                <p class="bbcc-team-card-bio"><%= member.bio.to_s.truncate(160) %></p>
                            </div>
                        </article>
                    </div>
                <% end %>
            </div>
            <div class="text-center">
                <%= link_to "View All", our_team_path(department: "fitness"), class: "bbcc-btn" %>
            </div>
        </div>
    </section>
    <!-- end fitness team -->
<% end %>

<% if @specialists.any? %>
    <!-- start specialists -->
    <section class="bbcc-section bbcc-coach-row bbcc-specialists">
        <div class="container-lg">
            <div class="bbcc-section-head<%= " bbcc-section-head-center" unless @spa_child %>">
                <h2 class="<%= @spa_child ? "bbcc-title-lg" : "bbcc-section-title" %>">Our Specialists</h2>
            </div>
            <div class="row g-4">
                <% @specialists.each do |member| %>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <article class="bbcc-team-card">
                            <span class="bbcc-team-card-image">
                                <% if member.photo.attached? %>
                                    <%= image_tag member.photo.variant(resize_to_fill: [900, 900]), alt: member.name, loading: "lazy" %>
                                <% else %>
                                    <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-2.png') %>');"></span>
                                <% end %>
                            </span>
                            <div class="bbcc-team-card-body">
                                <div class="bbcc-team-card-meta">
                                    <span class="bbcc-team-card-dept"><%= member.department_label %></span>
                                    <span class="bbcc-team-card-role"><%= member.role %></span>
                                </div>
                                <span class="bbcc-team-card-name"><%= member.name %></span>
                                <p class="bbcc-team-card-bio"><%= member.bio.to_s.truncate(160) %></p>
                            </div>
                        </article>
                    </div>
                <% end %>
            </div>
            <% unless @spa_child %>
                <div class="text-center">
                    <%= link_to "View All", our_team_path(department: "specialists"), class: "bbcc-btn" %>
                </div>
            <% end %>
        </div>
    </section>
    <!-- end specialists -->
<% end %>

<% if @spa_root %>
    <%= render "shared/bbcc_highlights" %>
<% end %>

<% if @show_mits && racquet_root %>
    <%= render "home/mits_partner" %>
<% end %>

<% if @golf_siblings.present? %>
    <%= render "club_life/child_cards", children: @golf_siblings, title: "BBCC Golf" %>
<% end %>

<% if @gallery.any? %>
    <!-- start club life gallery -->
    <section class="bbcc-section bbcc-gallery-page">
        <div class="container-lg">
            <div class="bbcc-section-head bbcc-section-head-center">
                <h2 class="bbcc-title-lg">Gallery</h2>
            </div>
            <div class="bbcc-masonry">
                <% @gallery.each_with_index do |image, index| %>
                    <span class="bbcc-masonry-item<%= " bbcc-clublife-photo-hidden" if index >= gallery_initial %>">
                        <%= image_tag image.variant(resize_to_limit: [700, 700]), alt: @section.name %>
                    </span>
                <% end %>
            </div>
            <% if @gallery.count > gallery_initial %>
                <div class="text-center">
                    <button type="button" class="bbcc-btn bbcc-view-more" data-target=".bbcc-clublife-photo-hidden">View More</button>
                </div>
            <% end %>
        </div>
    </section>
    <!-- end club life gallery -->
<% end %>

</div>

<%= render "home/blogs" %>
<%= render "home/social_media" %>
