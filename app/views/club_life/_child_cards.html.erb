<%# Service cards for a section's children (Golf: Course / Lessons / Driving Range).
    locals: children:, title: %>
<!-- start club life children -->
<section class="bbcc-section bbcc-service-row">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-title-lg"><%= title %></h2>
        </div>
        <div class="row g-4">
            <% children.each do |child| %>
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="bbcc-service-card">
                        <%= link_to club_life_page_path(child), class: "bbcc-service-card-image" do %>
                            <% if child.image.attached? %>
                                <%= image_tag child.image.variant(resize_to_fill: [750, 500]), alt: child.name %>
                            <% else %>
                                <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-4.png') %>');"></span>
                            <% end %>
                        <% end %>
                        <div class="bbcc-service-card-body">
                            <%= link_to child.name, club_life_page_path(child), class: "bbcc-service-card-title" %>
                            <p class="bbcc-service-card-desc"><%= child.short_description.to_s.truncate(140) %></p>
                            <%= link_to (child.cta_label.presence || "Explore"),
                                        (child.cta_url.presence || club_life_page_path(child)),
                                        class: "bbcc-btn bbcc-btn-block" %>
                        </div>
                    </article>
                </div>
            <% end %>
        </div>
    </div>
</section>
<!-- end club life children -->
