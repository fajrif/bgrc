<%# Sticky summary bar. Hidden until the first item is added. %>
<div class="bbcc-cart-bar" id="grab-go-cart" hidden>
    <div class="container-lg bbcc-cart-bar-inner">
        <div class="bbcc-cart-bar-summary">
            <span class="bbcc-cart-bar-count" id="grab-go-cart-count">0 items</span>
            <span class="bbcc-cart-bar-total" id="grab-go-cart-total">Rp. 0</span>
        </div>
        <div class="bbcc-cart-bar-actions">
            <button type="button" class="bbcc-btn bbcc-btn-light bbcc-btn-sm" id="grab-go-cart-clear">Clear</button>
            <button type="button" class="bbcc-btn bbcc-btn-sm" data-bs-toggle="modal" data-bs-target="#grabGoCheckoutModal">Place Order</button>
        </div>
    </div>
</div>
