<%
  paragraphs1 = @restaurant.description1.to_s.split(/\n+/).reject(&:blank?)
  intro_lines = {
    "Concept"         => @restaurant.concept,
    "Operating Hours" => @restaurant.operating_hours,
    "Location"        => @restaurant.location_note
  }.select { |_label, value| value.present? }
  strip_photo = @restaurant.middle_banner.attached? ? @restaurant.middle_banner : (@restaurant.banner.attached? ? @restaurant.banner : nil)
  closing_photo = @restaurant.banner.attached? ? @restaurant.banner : (@restaurant.image.attached? ? @restaurant.image : nil)
  later_paragraphs = [*paragraphs1.drop(1), @restaurant.description2.presence].compact

  # Shared copy across every restaurant page — only the name changes — so a
  # new venue never needs an admin to write this section from scratch.
  dine_now_text = if I18n.locale == :id
    "Siap bersantap di #{@restaurant.name}? Pesan meja hanya dalam beberapa klik melalui sistem reservasi online kami, atau hubungi kami langsung melalui WhatsApp dan tim kami akan mengonfirmasi reservasi Anda serta membantu memilih menu. Tamu tanpa reservasi selalu kami sambut selagi tempat tersedia, dan untuk kelompok besar atau acara khusus kami sarankan memesan setidaknya 24 jam sebelumnya agar meja Anda siap tepat waktu. Pesanan untuk dibawa pulang maupun layanan makan di kamar juga dapat diatur bagi tamu yang menginap — cukup sampaikan pesanan Anda ke front desk."
  else
    "Ready to eat at #{@restaurant.name}? Book a table in a few taps through our online reservation system, or reach out directly via WhatsApp and our team will confirm your booking and talk you through the menu. Walk-ins are always welcome subject to availability, and for larger groups or special occasions we recommend booking at least 24 hours ahead so your table is ready when you arrive. Takeaway orders and in-room dining can also be arranged for guests staying on property — just let the front desk know what you'd like and when."
  end
%>
<% content_for :header_light, true %>
<nav class="bbcc-resto-tabs" aria-label="Dining venues">
    <div class="container-lg">
        <div class="bbcc-filter-tabs bbcc-filter-tabs-top">
            <% @restaurants.each do |restaurant| %>
                <%= link_to restaurant.name, dining_restaurant_path(restaurant), class: ["bbcc-filter-tab", ("active" if restaurant == @restaurant)] %>
            <% end %>
        </div>
    </div>
</nav>

<!-- start restaurant intro -->
<section class="bbcc-intro-head">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-12 col-lg-4">
                <h1 class="bbcc-title-lg bbcc-intro-title"><%= @restaurant.name %></h1>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-intro-desc">
                    <p><%= @restaurant.description %></p>
                    <% if paragraphs1.first.present? %>
                        <p><%= paragraphs1.first %></p>
                    <% end %>
                    <% intro_lines.each do |label, value| %>
                        <p class="bbcc-intro-fact"><%= label %>: <%= value %></p>
                    <% end %>
                    <%= link_to "Reserve Now", get_contact_path, class: "bbcc-solid-btn" %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end restaurant intro -->

<% if strip_photo %>
<!-- start restaurant photo strip -->
<%= image_tag url_for(strip_photo), alt: @restaurant.name, class: "bbcc-strip bbcc-strip-tall" %>
<!-- end restaurant photo strip -->
<% end %>

<% if later_paragraphs.any? %>
<!-- start restaurant description -->
<section class="bbcc-intro-head">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-8 offset-lg-4">
                <div class="bbcc-intro-desc">
                    <% later_paragraphs.each do |paragraph| %>
                        <p><%= paragraph %></p>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end restaurant description -->
<% end %>

<% if @restaurant.menus.any? %>
<!-- start menu highlight -->
<section class="bbcc-section bbcc-venues bbcc-menu-highlight">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-12 col-lg-3">
                <h2 class="bbcc-title-lg">Menu Highlight</h2>
                <p><%= I18n.locale == :id ? "Hidangan andalan dari #{@restaurant.name}." : "Signature dishes from #{@restaurant.name}." %></p>
                <%= link_to "Discover more", get_contact_path, class: "bbcc-text-link" %>
            </div>
            <div class="col-12 col-lg-9">
                <div class="bbcc-swiper bbcc-slider bbcc-venue-slider" data-slides="1.2,2,3,3.3">
                    <div class="swiper-wrapper">
                        <% @restaurant.menus.each do |menu| %>
                            <div class="swiper-slide">
                                <article class="bbcc-venue-card" <%= raw(%(style="background-image:url('#{url_for(menu.image)}');")) if menu.image.attached? %>>
                                    <span class="bbcc-venue-card-body">
                                        <span class="bbcc-venue-card-name"><%= menu.name %></span>
                                        <span class="bbcc-venue-card-desc"><%= menu.short_description.to_s.truncate(110) %></span>
                                    </span>
                                </article>
                            </div>
                        <% end %>
                    </div>
                    <%= render "shared/slider_controls" %>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end menu highlight -->
<% end %>

<% if @restaurant.images.attached? %>
<!-- start restaurant gallery -->
<section class="bbcc-section bbcc-gallery-page bbcc-restaurant-gallery">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Gallery</h2>
        <div class="bbcc-masonry">
            <% @restaurant.images.each do |image| %>
                <span class="bbcc-masonry-item">
                    <%= image_tag image.variant(resize_to_fill: [700, 700]), alt: @restaurant.name, loading: "lazy" %>
                </span>
            <% end %>
        </div>
    </div>
</section>
<!-- end restaurant gallery -->
<% end %>

<!-- start dine now -->
<section class="bbcc-section bbcc-vision-tan bbcc-dine-now">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-12 col-lg-4">
                <h2 class="bbcc-title-lg">Dine at <%= @restaurant.name %> Now</h2>
            </div>
            <div class="col-12 col-lg-8">
                <p class="bbcc-intro-desc"><%= dine_now_text %></p>
            </div>
        </div>
    </div>
</section>
<!-- end dine now -->

<% if closing_photo %>
<%= image_tag url_for(closing_photo), alt: @restaurant.name, class: "bbcc-strip bbcc-strip-tall", loading: "lazy" %>
<% end %>

<% if @others.any? %>
<!-- start other dining experiences -->
<section class="bbcc-section bbcc-service-row">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Other Dining Experiences</h2>
        <div class="bbcc-post-grid">
            <% @others.each do |other| %>
                <%= render "shared/post_card", path: dining_restaurant_path(other), title: other.name, image: other.image,
                           excerpt: other.short_description.to_s.truncate(120) %>
            <% end %>
        </div>
    </div>
</section>
<!-- end other dining experiences -->
<% end %>

<%= render "home/social_media" %>
