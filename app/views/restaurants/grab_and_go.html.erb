<%
  crumbs = [{ label: "Dining", path: dining_path }, { label: @restaurant.name }]
  intro_lines = {
    "Concept"         => @restaurant.concept,
    "Operating Hours" => @restaurant.operating_hours,
    "Location"        => @restaurant.location_note
  }.select { |_label, value| value.present? }
  steps = [
    { icon: "fa-book-open", label: "Browse Menu" },
    { icon: "fa-burger",    label: "Place Order" },
    { icon: "fa-hand",      label: "Pick Up" }
  ]
%>
<% content_for :header_light, true %>
<nav class="bbcc-resto-tabs" aria-label="Dining venues">
    <div class="container-lg">
        <div class="bbcc-filter-tabs bbcc-filter-tabs-top">
            <% @restaurants.each do |restaurant| %>
                <%= link_to restaurant.name, dining_restaurant_path(restaurant), class: ["bbcc-filter-tab", ("active" if restaurant == @restaurant)] %>
            <% end %>
        </div>
    </div>
</nav>

<!-- start grab and go intro -->
<section class="bbcc-intro-head">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-12 col-lg-4">
                <h1 class="bbcc-title-lg bbcc-intro-title"><%= @restaurant.name %></h1>
            </div>
            <div class="col-12 col-lg-8">
                <div class="bbcc-intro-desc">
                    <p><%= @restaurant.description %></p>
                    <% if @restaurant.description2.present? %>
                        <p><%= @restaurant.description2 %></p>
                    <% end %>
                    <% intro_lines.each do |label, value| %>
                        <p class="bbcc-intro-fact"><%= label %>: <%= value %></p>
                    <% end %>
                    <a href="#grab-go-menu" class="bbcc-solid-btn">Order Now</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end grab and go intro -->

<% if @restaurant.banner.attached? %>
    <%= image_tag url_for(@restaurant.banner), alt: @restaurant.name, class: "bbcc-strip bbcc-strip-tall" %>
<% end %>

<!-- start grab and go menu -->
<section class="bbcc-section bbcc-grabgo-menu" id="grab-go-menu">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Menu Categories</h2>

        <% if @menus.any? %>
            <% if @menu_categories.size > 1 %>
                <nav class="bbcc-filter-tabs bbcc-menu-tabs" aria-label="Menu categories">
                    <button type="button" class="bbcc-filter-tab active" data-filter="all">All</button>
                    <% @menu_categories.each do |category| %>
                        <button type="button" class="bbcc-filter-tab" data-filter="<%= category.slug %>"><%= category.name %></button>
                    <% end %>
                </nav>
            <% end %>

            <div class="row g-4 bbcc-menu-grid">
                <% @menus.each do |menu| %>
                    <%= render "restaurants/grab_go_card", menu: menu %>
                <% end %>
            </div>
        <% else %>
            <p class="bbcc-lead text-center mb-0">
                Online ordering is taking a short break. Please order at the counter, or
                <%= link_to "get in touch", get_contact_path, class: "bbcc-link" %>.
            </p>
        <% end %>
    </div>
</section>
<!-- end grab and go menu -->

<!-- start how it works -->
<section class="bbcc-section bbcc-vision-tan bbcc-howitworks">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">How It Works</h2>
        <div class="bbcc-steps">
            <% steps.each_with_index do |step, index| %>
                <div class="bbcc-step">
                    <span class="bbcc-step-icon"><i class="fa-solid <%= step[:icon] %>" aria-hidden="true"></i></span>
                    <span class="bbcc-step-label"><%= step[:label] %></span>
                </div>
                <% unless index == steps.size - 1 %>
                    <span class="bbcc-step-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                <% end %>
            <% end %>
        </div>
    </div>
</section>
<!-- end how it works -->

<%= image_tag "middle_banner_resto.png", alt: "", class: "bbcc-strip bbcc-strip-tall", loading: "lazy" %>

<% if @others.any? %>
<!-- start other dining experiences -->
<section class="bbcc-section bbcc-service-row">
    <div class="container-lg">
        <h2 class="bbcc-title-lg">Other Dining Experiences</h2>
        <div class="bbcc-post-grid">
            <% @others.each do |other| %>
                <%= render "shared/post_card", path: dining_restaurant_path(other), title: other.name, image: other.image,
                    excerpt: other.short_description.to_s.truncate(110) %>
            <% end %>
        </div>
    </div>
</section>
<!-- end other dining experiences -->
<% end %>

<%= render "home/social_media" %>

<% if @menus.any? %>
    <%= render "restaurants/grab_go_cart" %>
    <%= render "restaurants/grab_go_checkout_modal" %>

    <script>
      // The basket is held in memory only — no round trip per tap, and no order
      // record (and so no 10-minute payment clock) until Place Order is submitted.
      (function () {
        var cart  = {};
        var grid  = document.querySelector('.bbcc-menu-grid');
        var bar   = document.getElementById('grab-go-cart');
        if (!grid || !bar) return;

        var countEl   = document.getElementById('grab-go-cart-count');
        var totalEl   = document.getElementById('grab-go-cart-total');
        var summaryEl = document.getElementById('grab-go-summary');
        var modalTotal = document.getElementById('grab-go-modal-total');
        var itemsInput = document.getElementById('grab-go-items-input');

        function formatRupiah(amount) {
          return 'Rp. ' + amount.toLocaleString('id-ID');
        }

        function cartEntries() {
          return Object.keys(cart).filter(function (id) { return cart[id].qty > 0; });
        }

        function render() {
          var ids = cartEntries();
          var count = 0, total = 0, rows = '';

          ids.forEach(function (id) {
            var line = cart[id];
            count += line.qty;
            total += line.qty * line.price;
            rows += '<div class="bbcc-modal-summary-row"><span>' + line.name + ' &times; ' + line.qty +
                    '</span><span>' + formatRupiah(line.qty * line.price) + '</span></div>';
          });

          countEl.textContent = count + (count === 1 ? ' item' : ' items');
          totalEl.textContent = formatRupiah(total);
          if (summaryEl) summaryEl.innerHTML = rows;
          if (modalTotal) modalTotal.textContent = formatRupiah(total);
          if (itemsInput) itemsInput.value = JSON.stringify(
            ids.reduce(function (acc, id) { acc[id] = cart[id].qty; return acc; }, {})
          );

          bar.hidden = count === 0;
        }

        function step(card, delta) {
          var id  = card.getAttribute('data-menu-id');
          var max = parseInt(card.getAttribute('data-max'), 10);
          var line = cart[id] || (cart[id] = {
            qty: 0,
            price: parseInt(card.getAttribute('data-price'), 10) || 0,
            name: card.getAttribute('data-name') || ''
          });

          var next = line.qty + delta;
          if (next < 0) next = 0;
          // A counted item can't be ordered beyond what's left on the counter.
          if (!isNaN(max) && next > max) next = max;

          line.qty = next;
          card.querySelector('.bbcc-qty-value').textContent = next;
          card.classList.toggle('bbcc-menu-card-picked', next > 0);
          render();
        }

        grid.addEventListener('click', function (event) {
          var button = event.target.closest('.bbcc-qty-btn');
          if (!button) return;
          step(button.closest('.bbcc-menu-card'), button.classList.contains('bbcc-qty-plus') ? 1 : -1);
        });

        document.getElementById('grab-go-cart-clear').addEventListener('click', function () {
          cart = {};
          grid.querySelectorAll('.bbcc-menu-card').forEach(function (card) {
            var value = card.querySelector('.bbcc-qty-value');
            if (value) value.textContent = '0';
            card.classList.remove('bbcc-menu-card-picked');
          });
          render();
        });

        document.getElementById('grab-go-checkout-form').addEventListener('submit', function (event) {
          if (cartEntries().length === 0) event.preventDefault();
        });

        // Filters in place so the visitor keeps both their scroll position and
        // their basket — a link_to tab strip would reload the page and drop both.
        var tabs  = document.querySelectorAll('.bbcc-menu-tabs .bbcc-filter-tab');
        var cols  = document.querySelectorAll('.bbcc-menu-grid .bbcc-menu-col');
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var filter = tab.getAttribute('data-filter');
            tabs.forEach(function (t) { t.classList.toggle('active', t === tab); });
            cols.forEach(function (col) {
              var show = filter === 'all' || col.getAttribute('data-category') === filter;
              col.classList.toggle('bbcc-menu-col-hidden', !show);
            });
          });
        });
      })();
    </script>
<% end %>
