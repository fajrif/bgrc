<%
  crumbs = [{ label: "Dining", path: dining_path }, { label: @restaurant.name }]
  intro_lines = {
    "Concept"         => @restaurant.concept,
    "Operating Hours" => @restaurant.operating_hours,
    "Location"        => @restaurant.location_note
  }.select { |_label, value| value.present? }
  steps = [
    { icon: "fa-book-open", label: "Browse Menu" },
    { icon: "fa-burger",    label: "Place Order" },
    { icon: "fa-hand",      label: "Pick Up" }
  ]
%>
<% if @restaurant.banner.attached? %>
<!-- start grab and go hero -->
<section class="bbcc-page-hero" style="background-image:url('<%= url_for(@restaurant.banner) %>');">
    <div class="bbcc-page-hero-overlay"></div>
    <div class="container-lg">
        <div class="bbcc-page-hero-body">
            <h1 class="bbcc-page-hero-title"><%= @restaurant.name %></h1>
            <p class="bbcc-page-hero-desc"><%= @restaurant.banner_description.to_s.truncate(200) %></p>
        </div>
    </div>
</section>
<!-- end grab and go hero -->
<% end %>
<%= render "shared/breadcrumb", crumbs: crumbs %>

<!-- start grab and go intro -->
<section class="bbcc-section bbcc-clublife-section">
    <div class="container-lg">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-3">
                <%= render "shared/dining_nav", restaurants: @restaurants, active: @restaurant %>
            </div>
            <div class="col-12 col-lg-9">
                <h2 class="bbcc-section-title"><%= @restaurant.name %></h2>
                <p class="bbcc-lead"><%= @restaurant.description %></p>
                <% if @restaurant.description2.present? %>
                    <p><%= @restaurant.description2 %></p>
                <% end %>
                <% if intro_lines.any? %>
                    <dl class="bbcc-factlist">
                        <% intro_lines.each do |label, value| %>
                            <div class="bbcc-factlist-row">
                                <dt><%= label %>:</dt>
                                <dd><%= value %></dd>
                            </div>
                        <% end %>
                    </dl>
                <% end %>
                <a href="#grab-go-menu" class="bbcc-btn">Order Now</a>
            </div>
        </div>
    </div>
</section>
<!-- end grab and go intro -->

<!-- start grab and go menu -->
<section class="bbcc-section bbcc-grabgo-menu" id="grab-go-menu">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-section-title">Menu Categories</h2>
        </div>

        <% if @menus.any? %>
            <%# The menu, basket and checkout (app/frontend/components/grab_and_go). %>
            <%= vue_component "GrabAndGoApp", grab_and_go_props(menus: @menus, categories: @menu_categories) do %>
                <p class="bbcc-lead text-center mb-0">Loading the menu&hellip;</p>
            <% end %>
        <% else %>
            <p class="bbcc-lead text-center mb-0">
                Online ordering is taking a short break. Please order at the counter, or
                <%= link_to "get in touch", get_contact_path, class: "bbcc-link" %>.
            </p>
        <% end %>
    </div>
</section>
<!-- end grab and go menu -->

<!-- start how it works -->
<section class="bbcc-section bbcc-section-alt bbcc-howitworks">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-section-title">How It Works</h2>
        </div>
        <div class="bbcc-steps">
            <% steps.each_with_index do |step, index| %>
                <div class="bbcc-step">
                    <span class="bbcc-step-icon"><i class="fa-solid <%= step[:icon] %>" aria-hidden="true"></i></span>
                    <span class="bbcc-step-label"><%= step[:label] %></span>
                </div>
                <% unless index == steps.size - 1 %>
                    <span class="bbcc-step-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                <% end %>
            <% end %>
        </div>
    </div>
</section>
<!-- end how it works -->

<% if @others.any? %>
<!-- start other dining experiences -->
<section class="bbcc-section bbcc-service-row">
    <div class="container-lg">
        <div class="bbcc-section-head bbcc-section-head-center">
            <h2 class="bbcc-section-title">Other Dining Experiences</h2>
        </div>
        <div class="row g-4">
            <% @others.each do |other| %>
                <div class="col-12 col-md-4">
                    <%= link_to dining_restaurant_path(other), class: "bbcc-tile bbcc-tile-sm",
                                style: ("background-image:url('#{url_for(other.image)}');" if other.image.attached?) do %>
                        <span class="bbcc-tile-shade"></span>
                        <span class="bbcc-tile-body">
                            <span class="bbcc-tile-label"><%= other.name %></span>
                        </span>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</section>
<!-- end other dining experiences -->
<% end %>
