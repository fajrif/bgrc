<% content_for :header_light, true %>

<!-- start location -->
<section class="bbcc-page-body bbcc-location-info">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-start">
            <div class="col-12 col-lg-4">
                <h1 class="bbcc-title-lg bbcc-intro-title">Location</h1>
            </div>
            <div class="col-12 col-lg-8">
                <div class="row g-4">
                    <div class="col-12 col-md-6">
                        <div class="bbcc-contact-block"><%= raw(configatron.location_address) %></div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="bbcc-contact-block">
                            <p><%= configatron.company_phone1 %><br><%= configatron.company_phone2 %></p>
                            <p><a href="mailto:<%= configatron.admin_email %>"><%= configatron.admin_email %></a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end location -->

<!-- start map -->
<section class="bbcc-contact-map" aria-label="Our location on the map">
    <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3942.7868004742595!2d115.227!3d-8.80609!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd243daf154eb6f%3A0xaa5df7a8cd7e82f8!2sBali%20Beach%20Country%20Club!5e0!3m2!1sen!2sid!4v1748883655931!5m2!1sen!2sid"
        title="Bali Beach Country Club location map"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
</section>
<!-- end map -->



<%= render "home/blogs" %>
<%= render "home/social_media" %>
