<div class="row">
	<div class="col-12 col-lg-12">
		<%= simple_form_for @inquiry, url: contacts_path, method: :post, remote: true do |f| %>
      <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
          <%= f.input :name, label: false, placeholder: "Name", input_html: { class: "input-border-bottom" } %>
          <%= f.input :email, label: false, placeholder: "Email", input_html: { class: "input-border-bottom" } %>
          <%= f.input :phone, label: false, placeholder: "Phone", input_html: { class: "input-border-bottom" } %>
          <%= f.input :message, label: false, placeholder: "Message", input_html: { class: "input-border-bottom" } %>
          <% if @show_recaptcha_v2 %>
            <input type="hidden" value="true" name="inquiry[use_v2]" id="inquiry_use_v2">
            <%= raw Bgrc::Recaptcha.recaptcha_v2_render %>
          <% else %>
            <%= raw Bgrc::Recaptcha.recaptcha_execute('inquiry') %>
          <% end %>
          <button type="submit" class="btn btn-light-gray btn-medium text-medium margin-30px-top sm-margin-three-top">send message</button>
        </div>
			</div>
		<% end %>
	</div>
</div>
