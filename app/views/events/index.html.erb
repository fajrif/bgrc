<%= render "shared/page_intro", title: "BBCC Events",
    description: simple_format("Weddings, corporate events and private celebrations at Bali Beach Country Club.") %>

<!-- start event types -->
<section class="bbcc-page-body bbcc-service-row">
    <div class="container-lg">
        <div class="bbcc-post-grid">
            <% @event_types.each do |type| %>
                <%= render "shared/post_card", path: event_type_path(type), title: type.name, image: type.image,
                    excerpt: type.short_description, label: "Discover more" %>
            <% end %>
        </div>
    </div>
</section>
<!-- end event types -->

<!-- start plan your event now -->
<section class="bbcc-cta-band">
    <div class="container-lg">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-7 order-lg-1">
                <%= image_tag "facilities/restaurant.png", alt: "", loading: "lazy" %>
            </div>
            <div class="col-12 col-lg-5 order-lg-2">
                <h2 class="bbcc-title-lg">Plan Your <br>Event Now</h2>
                <p>
                    From an intimate wedding on the lawn to a full-scale corporate conference, our
                    events team handles the details so you don&rsquo;t have to. Tell us your date, your
                    guest count and the occasion, and we&rsquo;ll put together a proposal covering venue,
                    catering, decor and entertainment.
                </p>
                <%= link_to "Enquire Today", get_contact_path, class: "bbcc-solid-btn" %>
            </div>
        </div>
    </div>
</section>
<!-- end plan your event now -->

<%= render "home/blogs" %>
<%= render "home/tennis_band" %>
<%= render "home/social_media" %>
