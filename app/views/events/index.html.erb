<%= render "shared/page_hero", banner: @banner, crumbs: [{ label: "Events" }] %>

<!-- start event types -->
<section class="bbcc-section bbcc-service-row">
    <div class="container-lg">
        <div class="row g-4">
            <% @event_types.each do |type| %>
                <div class="col-12 col-md-4">
                    <article class="bbcc-service-card">
                        <span class="bbcc-service-card-image">
                            <% if type.image.attached? %>
                                <%= image_tag type.image.variant(resize_to_fill: [750, 500]), alt: type.name %>
                            <% else %>
                                <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-4.png') %>');"></span>
                            <% end %>
                        </span>
                        <div class="bbcc-service-card-body">
                            <h3 class="bbcc-service-card-title"><%= type.name %></h3>
                            <p class="bbcc-service-card-desc"><%= type.short_description %></p>
                        </div>
                    </article>
                </div>
            <% end %>
        </div>
    </div>
</section>
<!-- end event types -->

<% if @gallery_images.any? %>
    <!-- start gallery -->
    <section class="bbcc-section bbcc-section-alt">
        <div class="container-lg">
            <div class="bbcc-section-head bbcc-section-head-center">
                <h2 class="bbcc-section-title">Gallery</h2>
            </div>
            <div class="bbcc-masonry">
                <% @gallery_images.first(12).each do |image| %>
                    <span class="bbcc-masonry-item">
                        <%= image_tag image.variant(resize_to_limit: [700, 700]) %>
                    </span>
                <% end %>
            </div>
        </div>
    </section>
    <!-- end gallery -->
<% end %>

<!-- start plan your event now -->
<section class="bbcc-section bbcc-event-cta">
    <div class="container-lg">
        <div class="row g-0 align-items-stretch">
            <div class="col-12 col-lg-6">
                <div class="bbcc-event-cta-body">
                    <h2 class="bbcc-section-title">Plan Your Event Now</h2>
                    <p>
                        From an intimate wedding on the lawn to a full-scale corporate conference, our
                        events team handles the details so you don't have to. Tell us your date, your
                        guest count and the occasion, and we'll put together a proposal covering venue,
                        catering, decor and entertainment tailored to your event.
                    </p>
                    <p>
                        Every enquiry gets a dedicated coordinator who stays with you from the first
                        conversation through to the day itself, and every venue on property &mdash; from
                        the beach club to the golf course lawns &mdash; can be booked exclusively for
                        private functions.
                    </p>
                    <%= link_to "Contact Us", get_contact_path, class: "bbcc-btn" %>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="bbcc-article-cta-image" style="background-image:url('<%= image_url('facilities/restaurant.png') %>');"></div>
            </div>
        </div>
    </div>
</section>
<!-- end plan your event now -->

<%= render "shared/bbcc_highlights" %>
<%= render "home/blogs" %>
