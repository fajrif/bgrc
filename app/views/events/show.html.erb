<%
  paragraphs = @event_type.description.to_s.split(/\n+/)
  hero = @event_type.banner.attached? ? @event_type.banner : (@event_type.image if @event_type.image.attached?)
%>
<%= render "shared/page_intro", title: "#{@event_type.name} with BBCC",
    description: safe_join(paragraphs.map { |paragraph| content_tag(:p, paragraph) }) %>

<% if hero %>
    <!-- start event type banner -->
    <div class="bbcc-fullbanner bbcc-fullbanner-tall" style="background-image:url('<%= url_for(hero) %>');" role="img" aria-label="<%= @event_type.name %>"></div>
    <!-- end event type banner -->
<% end %>

<% if @others.any? %>
    <!-- start other event types -->
    <section class="bbcc-section bbcc-service-row">
        <div class="container-lg">
            <div class="row g-4 g-lg-5">
                <div class="col-12 col-lg-4">
                    <h2 class="bbcc-title-lg">Other Events</h2>
                    <p>Explore more ways to celebrate at the club.</p>
                </div>
                <div class="col-12 col-lg-8">
                    <div class="bbcc-post-grid bbcc-post-grid-2">
                        <% @others.each do |other| %>
                            <%= render "shared/post_card", path: event_type_path(other), title: other.name, image: other.image, excerpt: other.short_description %>
                        <% end %>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end other event types -->
<% end %>

<%= render "shared/bbcc_highlights", title: "Other Highlights" %>

<% if @gallery.any? %>
    <!-- start event type gallery -->
    <section class="bbcc-section bbcc-gallery-page">
        <div class="container-lg">
            <h2 class="bbcc-title-lg">Gallery</h2>
            <div class="bbcc-square-grid">
                <% @gallery.first(6).each do |image| %>
                    <%= image_tag image.variant(resize_to_fill: [700, 700]), alt: @event_type.name, loading: "lazy" %>
                <% end %>
            </div>
        </div>
    </section>
    <!-- end event type gallery -->
<% end %>

<%= render "home/social_media" %>
