<ul class="bbcc-booking-summary">
  <li>Court: <%= @court.name_label %></li>
  <li>Date: <%= @dates %></li>
  <li>Duration: <%= @duration %></li>
  <% if @court_type %>
    <li>Court Type: <%= @court_type %></li>
  <% end %>
  <% if @group_class %>
    <li>Class Name: <%= @group_class.name_with_pax(@pax) %></li>
  <% end %>
  <% if @pax %>
    <li>Pax: <span class="js-pax-value"><%= @pax %></span></li>
  <% end %>
  <li>Total Price: <%= @priceLabel %></li>
</ul>
