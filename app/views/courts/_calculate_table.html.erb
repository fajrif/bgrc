<ul class="mb-2 text-medium ps-0">
  <li class="mb-1"><strong>Court:</strong> <%= @court.name_label %></li>
  <li class="mb-1"><strong>Date:</strong> <%= @dates %></li>
  <li class="mb-1"><strong>Duration:</strong> <%= @duration %></li>
  <% if @court_type %>
    <li class="mb-1"><strong>Court Type:</strong> <%= @court_type %></li>
  <% end %>
  <% if @group_class %>
    <li class="mb-1"><strong>Class Name:</strong> <%= @group_class.name_with_pax(@pax) %></li>
  <% end %>
  <% if @pax %>
    <li class="mb-1"><strong>Pax:</strong> <%= @pax %></li>
  <% end %>
  <li><strong>Total Price:</strong> <%= @priceLabel %></li>
</ul>
