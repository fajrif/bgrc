<div marginwidth="0" marginheight="0" style="background-color:rgb(245,245,245)">
  <div style="margin:0px;padding:70px 0px;width:100%;background-color:rgb(245,245,245)">
    <table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%">
      <tbody>
        <tr>
          <td align="center" valign="top">
            <table border="0" cellpadding="0" cellspacing="0" width="600" style="width:700px;font-family:Helvetica,Arial,sans-serif;border-radius:21px;background-color:rgb(255,255,255)">
              <tbody>
                <tr>
                  <td style="display:block;padding:36px 48px 0 48px">
                    <h1 style="font-size:26px;font-weight:500;text-align:center;color:rgb(80,80,80)">Hi <%= @user.full_name.presence || @user.email %></h1>
                  </td>
                </tr>
                <tr>
                  <td valign="top" style="background-color:rgb(255,255,255)">
                    <table border="0" cellpadding="20" cellspacing="0" width="100%">
                      <tbody>
                        <tr>
                          <td valign="top" style="padding:10px 28px 48px 28px;font-size:16px;font-family:Helvetica,Arial,sans-serif;color:rgb(80,80,80);text-align:center">
                            <p style="margin:0 0 20px">Enter this code on the Bali Beach Country Club payment page to verify your email:</p>
                            <p style="margin:0 0 20px;font-size:36px;font-weight:700;letter-spacing:10px;color:rgb(40,40,40);font-family:Menlo,Consolas,monospace"><%= @code %></p>
                            <p style="margin:0">The code expires in <%= @minutes %> minutes. If you didn't try to sign in or register, you can ignore this email.</p>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
