<%= content_for :head do %>
	<script src="https://www.google.com/recaptcha/api.js?render=<%= configatron.recaptcha_v3_site_key %>"></script>
<% end %>

<h5 class="font-weight-600 margin-40px-bottom sm-margin-15px-bottom letter-spacing-8">REGISTER</h5>
<%= simple_form_for(resource, :as => resource_name, :url => registration_path(resource_name), :wrapper => :vertical_form_no_margin) do |f| %>
  <%= f.input :full_name, label: false, placeholder: "Full name" %>
  <div class="row">
    <div class="col-6">
      <%= f.input :email, label: false, placeholder: "Email address" %>
    </div>
    <div class="col-6">
      <%= f.input :phone, label: false, placeholder: "Phone" %>
    </div>
  </div>
  <%= f.input :dob, as: :string, label: false, placeholder: "Date of Birth", input_html: { class: "datepicker", value: get_input_date_value(f.object.dob,'%d/%m/%Y') } %>
  <div class="row">
    <div class="col-6">
      <%= f.input :gender, as: :select, label: false, wrapper: :vertical_select_big, collection: [[1, "Male"],[0, "Female"]], value_method: :first, label_method: :last, prompt: "Choose your Gender" %>
    </div>
    <div class="col-6">
      <%= f.input :nationality, as: :select, label: false, wrapper: :vertical_select_big, collection: options_for_nationalities, prompt: "Choose your Nationality" %>
    </div>
  </div>
  <%= f.input :password, label: false, placeholder: "Password" %>
  <%= f.input :password_confirmation, label: false, placeholder: "Password confirmation" %>
  <div class="mb-4 text-center">
    <% if @show_recaptcha_v2 %>
      <input type="hidden" value="true" name="user[use_v2]" id="user_use_v2">
      <%= raw Bgrc::Recaptcha.recaptcha_v2_render %>
    <% else %>
      <%= raw Bgrc::Recaptcha.recaptcha_execute('registration') %>
    <% end %>
  </div>
  <div class="mb-4">
    <button type="submit" class="btn btn-light-gray btn-medium text-medium margin-30px-top sm-margin-three-top">submit</button>
  </div>
  <div>
    <%- if controller_name != 'sessions' %>
      Alrady have an account? <%= link_to "Login", new_session_path(resource_name) %>
    <% end %>
  </div>
<% end %>
