<!-- start golf reservations -->
<section class="bbcc-section bbcc-account">
  <div class="container-lg">
    <%= render "users/shared/account_nav" %>
    <%= render "users/shared/booking_view_switch" %>

    <% if @golf_reservations.empty? %>
      <div class="bbcc-table-empty">
        <p>You have no active golf reservations.</p>
        <%= link_to "Book a Tee Time", golf_path, class: "bbcc-btn" %>
      </div>
    <% else %>
      <%= render "table", golf_reservations: @golf_reservations, show_actions: true %>
      <%= paginate @golf_reservations, theme: "bbcc" %>
    <% end %>
  </div>
</section>
<!-- end golf reservations -->
