<!-- start golf reservation history -->
<section class="bbcc-section bbcc-account">
  <div class="container-lg">
    <%= render "users/shared/account_nav" %>
    <%= render "users/shared/booking_view_switch" %>

    <div class="bbcc-viewswitch">
      <%= link_to "Active Reservations", users_golf_reservations_path, class: "bbcc-viewswitch-btn" %>
      <span class="bbcc-viewswitch-btn active">Golf Reservation History</span>
    </div>

    <% if @golf_reservations.empty? %>
      <div class="bbcc-table-empty">
        <p>No past golf reservations found.</p>
      </div>
    <% else %>
      <%= render "table", golf_reservations: @golf_reservations, show_actions: false %>
      <%= paginate @golf_reservations, theme: "bbcc" %>
    <% end %>
  </div>
</section>
<!-- end golf reservation history -->
