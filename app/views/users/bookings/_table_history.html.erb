<% if @bookings.empty? %>
  <div class="bbcc-table-empty">
    <p>No past bookings yet.</p>
    <%= link_to "Book Now", search_path, class: "bbcc-btn" %>
  </div>
<% else %>
<div class="bbcc-table-scroll">
  <table class="bbcc-table">
    <thead>
      <tr>
        <th>Order ID</th>
        <th>Date</th>
        <th>Duration</th>
        <th>Court</th>
        <th>Class Name</th>
        <th>Status</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      <% @bookings.each do |booking| %>
        <tr>
          <td><%= link_to booking.order_id, booking_path(booking.order_id), class: "bbcc-table-id" %></td>
          <td><%= booking.date.strftime('%a %b %d, %Y %I.%M %p') %></td>
          <td><%= booking.duration_label %></td>
          <td><%= booking.try(:court).try(:name_label) %></td>
          <td><%= booking.try(:group_class).try(:name_with_pax, booking.pax) || '-' %></td>
          <td>
            <% badge = case booking.status
                       when Booking::PAID      then ""
                       when Booking::EXPIRED   then "bbcc-badge-danger"
                       when Booking::CANCELLED then "bbcc-badge-muted"
                       else "bbcc-badge-warn"
                       end %>
            <span class="bbcc-badge <%= badge %>"><%= booking.status_label %></span>
          </td>
          <td><%= booking.total_price_label %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% end %>
