<table class="table-responsive cart-wrap">
		<thead>
			<tr>
				<th class="product-2">#Order ID</th>
				<th class="product-2">Court</th>
				<th class="product-2">Date</th>
				<th class="product-2">Duration</th>
				<th class="ptice">Price</th>
				<th class="ptice">Status</th>
			</tr>
		</thead>
		<tbody>
			<% @bookings.each do |booking| %>
				<tr>
						<td><strong><%= booking.order_id %></strong></td>
						<td class="product">
							<%= link_to booking.court.name, court_path(booking.court) %>
						</td>
						<td><%= booking.date.strftime('%A, %d-%m-%Y %H:%M') %></td>
						<td><%= booking.duration_label %></td>
						<td class="ptice"><%= booking.price_label %></td>
						<td>
							<% case booking.status %>
							<% when Booking::PAID %>
								<span style="color: #28a745; font-weight: bold;"><%= booking.status_label %></span>
							<% when Booking::EXPIRED %>
								<span style="color: #dc3545; font-weight: bold;"><%= booking.status_label %></span>
							<% when Booking::CANCELLED %>
								<span style="color: #6c757d; font-weight: bold;"><%= booking.status_label %></span>
							<% else %>
								<span style="color: #ffc107; font-weight: bold;"><%= booking.status_label %></span>
							<% end %>
						</td>
				</tr>
			<% end %>
		</tbody>
</table>
<%= paginate @bookings, theme: "osru" %>
