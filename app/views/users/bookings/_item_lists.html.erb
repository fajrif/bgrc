<% if @booking.is_unpaid? %>
  <div class="col padding-25px-all">
    <div class="d-flex justify-content-between">
      <span class="d-block mb-2">Add Ons:</span>
      <span class="d-block mb-2">Quantity:</span>
    </div>
    <ul class="p-0 text-medium list-style-12">
      <% Item.all.each do |item| %>
        <li>
          <div class="d-flex justify-content-between">
            <div class="checkbox checkbox-inline checkbox-warning checkbox-sm">
              <%= check_box_tag "item_#{item.id}", item.id, @booking.add_ons.where(item_id: item.id).exists?, {
                class: "styled",
                onchange: "$(this).data('params', 'selected=' + this.checked)",
                data: { url: add_on_users_booking_url(@booking.id, item.id), remote: true, method: :patch },
              } %>
            <label for="item_<%= item.id %>"> <%= item.name %> (<%= item.price_label %>) </label>
          </div>
          <% if @add_on = @booking.add_ons.where(item_id: item.id).first %>
            <div class="qty-input">
              <%= link_to "", remove_quantity_users_booking_path(@booking, @add_on), class: "qty-count qty-count--minus", :method => :patch, :remote => true %>
              <input class="product-qty" type="number" name="product-qty" min="1" max="6" value="<%= @add_on.quantity %>" disabled="disabled">
              <%= link_to "", add_quantity_users_booking_path(@booking, @add_on), class: "qty-count qty-count--add", :method => :patch, :remote => true %>
            </div>
          <% end %>
        </div>
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="content padding-25px-all">
    <p class="text-medium"><strong>Booked by:</strong> <%= @booking.user.full_name %></p>
    <p class="text-medium"><strong>Email:</strong> <%= @booking.user.email %></p>
    <p class="text-medium"><strong>Phone:</strong> <%= @booking.user.phone %></p>
    <p class="text-medium"><strong>Status Payment:</strong> PAID</p>
  </div>
<% end %>
