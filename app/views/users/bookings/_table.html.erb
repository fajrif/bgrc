<table class="table-responsive cart-wrap">
		<thead>
			<tr>
				<th class="images images-b">Court</th>
				<th class="product-2">Name</th>
				<th class="product-2">Date</th>
				<th class="product-2">Duration</th>
				<th class="ptice">Status</th>
				<th class="ptice">Price</th>
				<th class="remove remove-b">Action</th>
			</tr>
		</thead>
		<tbody>
			<% @bookings.each do |booking| %>
				<tr>
						<td class="images">
							<%= link_to court_path(booking.court) do %>
								<%= image_tag(booking.court.images.first.variant(resize: "100x100").processed) if booking.court.images.first %>
							<% end %>
						</td>
						<td class="product">
								<ul>
										<li class="first-cart"><%= link_to booking.court.name, court_path(booking.court) %></li>
								</ul>
						</td>
						<td><%= booking.date.strftime('%A, %d-%m-%Y %H:%M') %></td>
						<td><%= booking.duration_label %></td>
						<td class="<%= booking.is_unpaid? ? 'text-red' : 'text-green' %>"><%= booking.status_label %></td>
						<td class="ptice"><%= booking.price_label %></td>
						<td class="action">
							<% if booking.is_unpaid? %>
								<ul>
									<li class="w-btn">
										<%= link_to "Pay", users_new_purchase_path(booking.class.to_s.downcase, booking.id.to_s), :remote => true %>
									</li>
									<li class="w-btn">
										<%= link_to "Cancel", users_booking_path(booking), method: :delete %>
									</li>
								</ul>
							<% end %>
						</td>
				</tr>
			<% end %>
		</tbody>
</table>
