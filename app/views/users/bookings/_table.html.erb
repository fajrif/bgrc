<% if @bookings.empty? %>
  <div class="text-center padding-40px-tb">
    <p class="text-medium">You have no bookings yet.</p>
    <%= link_to "Book Now", search_path, class: "btn btn-dark btn-small text-white" %>
  </div>
<% else %>
<table class="table table-striped table-responsive">
		<thead>
			<tr>
				<th>Order ID</th>
				<th>Date</th>
				<th>Duration</th>
				<th>Court</th>
				<th>Class Name</th>
				<th>Status</th>
				<th>Price</th>
			</tr>
		</thead>
		<tbody>
			<% @bookings.each do |booking| %>
				<tr>
						<td>
              <%= link_to booking.order_id, booking_path(booking.order_id), class: "text-black font-weight-500 d-block" %>
              <% if booking.class_credit_purchase_id.present? && booking.status == Booking::PAID %>
                <% if booking.created_at > 24.hours.ago %>
                  <button type="button"
                    class="btn-link border-0 bg-transparent p-0 text-extra-small text-warning fw-semibold d-block reschedule-trigger"
                    data-url="<%= return_credit_users_booking_path(booking) %>"
                    data-message="Cancel this session and return the credit? You can book a different date."
                    data-bs-toggle="modal" data-bs-target="#rescheduleConfirmModal">
                    Reschedule
                  </button>
                  <p class="text-extra-small text-muted mb-0 mt-1">
                    Until <%= (booking.created_at + 24.hours).strftime('%d %b %H:%M') %>
                  </p>
                <% else %>
                  <span class="text-extra-small text-muted">Locked</span>
                <% end %>
              <% else %>
                <% hours_remaining = (booking.date - Time.current) / 1.hour %>
                <% can_reschedule = booking.status == Booking::PAID &&
                      booking.group_class_id.present? &&
                      hours_remaining.between?(12, 24) &&
                      booking.reschedule_count < (configatron.max_reschedule_count || 2) %>
                <% if can_reschedule %>
                  <button type="button"
                    class="btn btn-outline-warning btn-small mt-1 reschedule-trigger"
                    data-url="<%= reschedule_to_credit_users_booking_path(booking) %>"
                    data-message="Convert this session to a credit? You can rebook later."
                    data-bs-toggle="modal" data-bs-target="#rescheduleConfirmModal">
                    Reschedule
                  </button>
                <% end %>
              <% end %>
						</td>
						<td><%= booking.date.strftime('%a %b %d, %Y %I:%M %p') %></td>
						<td><%= booking.duration_label %></td>
						<td><%= booking.try(:court).try(:name_label) %></td>
            <td>
              <%= booking.try(:group_class).try(:name_with_pax, booking.pax) || '-' %>
              <% if booking.cashier_booking? %>
                <span class="badge bg-secondary ms-1">Cashier</span>
              <% end %>
            </td>
						<td class="<%= booking.is_unpaid? ? 'text-red' : 'text-green' %> font-weight-500"><%= booking.status_label %></td>
						<td class="font-weight-500"><%= booking.total_price_label %></td>
				</tr>
			<% end %>
		</tbody>
</table>

<% end %>

<!-- Reschedule confirmation modal -->
<div class="modal fade" id="rescheduleConfirmModal" tabindex="-1" aria-labelledby="rescheduleConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h6 class="modal-title alt-font text-extra-dark-gray" id="rescheduleConfirmModalLabel">Confirm Reschedule</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="reschedule-modal-message" class="text-medium mb-0"></p>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-outline-secondary btn-small" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="reschedule-confirm-btn" class="btn btn-warning btn-small text-white">Confirm</button>
      </div>
    </div>
  </div>
</div>

<!-- Hidden form used to POST the reschedule action -->
<%= form_tag "", method: :post, id: "reschedule-form", style: "display:none;" do %>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
<% end %>

<script>
  (function() {
    var modal   = document.getElementById('rescheduleConfirmModal');
    var message = document.getElementById('reschedule-modal-message');
    var form    = document.getElementById('reschedule-form');
    var confirmBtn = document.getElementById('reschedule-confirm-btn');

    modal.addEventListener('show.bs.modal', function(e) {
      var trigger = e.relatedTarget;
      message.textContent = trigger.dataset.message || '';
      form.action = trigger.dataset.url || '';
    });

    confirmBtn.addEventListener('click', function() {
      if (form.action) form.submit();
    });
  })();
</script>
