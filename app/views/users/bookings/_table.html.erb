<table class="table table-striped table-hover table-responsive">
		<thead>
			<tr>
				<th class="product-2">Order ID</th>
				<th class="product-2">Date</th>
				<th class="product-2">Duration</th>
				<th class="price">Status</th>
				<th class="price">Price</th>
			</tr>
		</thead>
		<tbody>
			<% @bookings.each do |booking| %>
				<tr>
						<td class="product">
              <%= link_to booking.order_id, users_booking_path(booking.order_id), class: "text-black" %>
						</td>
						<td><%= booking.date.strftime('%A %b %d, %Y %I:%M %p') %></td>
						<td><%= booking.duration_label %></td>
						<td class="<%= booking.is_unpaid? ? 'text-red' : 'text-green' %>"><%= booking.status_label %></td>
						<td class="price"><%= booking.total_price_label %></td>
				</tr>
			<% end %>
		</tbody>
</table>
