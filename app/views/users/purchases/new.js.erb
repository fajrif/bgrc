function ajaxPostResult(result){
	// console.log(result);
	result['token'] = '<%= @purchase.token %>';
	result['order_id'] = '<%= @purchase.order_id %>';

	$.ajax({
		url: '<%= users_purchase_path(type: @purchase.productable.class.to_s.underscore, id: @purchase.productable.id.to_s) %>',
		type: 'POST',
		dataType: "script",
		beforeSend: function(xhr) {xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'))},
		data: result
	});
}

snap.pay('<%= @purchase.token %>', {
	onSuccess: function(result){
		console.log('MIDTRANS: success purchase');
		ajaxPostResult(result);
	},
	onPending: function(result){
		console.log('MIDTRANS: pending purchase');
		ajaxPostResult(result);
	},
	onError: function(result){
		console.log('MIDTRANS: error purchase');
		ajaxPostResult(result);
	},
	onClose: function(){
		console.log('MIDTRANS: User closed the popup without finishing the purchase');
	}
});
