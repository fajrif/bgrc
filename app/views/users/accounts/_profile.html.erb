<div class="row">
	<div class="col-sm-6">
		<h4>User Profile</h4>
		<ul class="mb_20">
				<li><%= current_user.full_name %></li>
				<li><%= current_user.email %></li>
				<li><%= current_user.phone %></li>
				<li><%= current_user.gender_label %></li>
				<li><%= current_user.address.city if current_user.address %></li>
		</ul>
		<%= link_to "Edit", edit_users_account_path, :class => "btn link-btn btn-outline btn-rounded" %>
	</div>
</div>
