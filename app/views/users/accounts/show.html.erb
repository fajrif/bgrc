<!-- start my account -->
<section class="bbcc-section bbcc-account">
    <div class="container-lg">
        <%= render "users/shared/account_nav" %>

        <%= form_for @user, url: users_account_path, html: { method: :put } do |f| %>
            <div class="row g-4 g-lg-5">
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="bbcc-account-photo">
                        <% if @user.photo.attached? %>
                            <%= image_tag @user.photo.variant(resize_to_fill: [600, 600]), alt: @user.full_name %>
                        <% else %>
                            <span class="bbcc-account-photo-ph"><i class="fa-regular fa-user"></i></span>
                        <% end %>
                    </div>
                    <div class="bbcc-account-photo-actions">
                        <label for="user_photo">Upload</label>
                        <% if @user.photo.attached? %>
                            <%= link_to "Delete", delete_photo_users_account_path(@user.photo.id),
                                        data: { confirm: "Are you sure you want to delete this photo?" }, method: :delete %>
                        <% end %>
                        <%= f.file_field :photo, class: "d-none" %>
                    </div>
                </div>

                <div class="col-12 col-md-7 col-lg-8">
                    <% if @user.errors.any? %>
                        <p class="bbcc-field-error-text mb-3"><%= @user.errors.full_messages.to_sentence %>.</p>
                    <% end %>

                    <div class="bbcc-field">
                        <%= f.label :full_name, "Name" %>
                        <%= f.text_field :full_name %>
                    </div>
                    <div class="bbcc-field">
                        <%= f.label :email, "Email Address" %>
                        <%= f.email_field :email %>
                    </div>
                    <div class="bbcc-field">
                        <%= f.label :phone, "Phone Number" %>
                        <%= f.text_field :phone %>
                    </div>
                    <div class="bbcc-field">
                        <%= f.label :dob, "Date of Birth" %>
                        <%= f.text_field :dob, class: "datepicker", value: get_input_date_value(@user.dob, '%d/%m/%Y') %>
                    </div>
                    <div class="bbcc-field">
                        <%= f.label :gender, "Gender" %>
                        <%= f.select :gender, [["Male", 1], ["Female", 0]] %>
                    </div>
                    <div class="bbcc-field">
                        <%= f.label :nationality, "Nationality" %>
                        <%= f.select :nationality, options_for_nationalities, include_blank: "Choose your nationality" %>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="bbcc-btn">Save Changes</button>
                    </div>
                </div>
            </div>
        <% end %>
    </div>
</section>
<!-- end my account -->
