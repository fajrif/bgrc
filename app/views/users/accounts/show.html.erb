<section class="half-section">
    <div class="container">
        <%= render "users/shared/sidebar" %>
        <%= simple_form_for @user, :url => users_account_path, :wrapper => :vertical_form_no_margin, :html => { :method => :put } do |f| %>
        <div class="row align-items-start">
            <div class="col-lg-3 col-md-3 text-center md-margin-30px-bottom">
              <% unless @user.photo.attached? %>
                <%= image_tag("https://placehold.co/600x400", class: "border-radius-6 mb-1 w-100") %>
              <% else %>
                <%= image_tag @user.photo.variant(resize_to_fit: [600,400]), class: "border-radius-6 mb-1 w-100" %>
              <% end %>
              <div class="d-flex justify-content-center gap-2">
                <label for="user_photo" class="cursor-pointer">Upload</label>
                <% if @user.photo.attached? %>
                  <%= link_to "Delete", delete_photo_users_account_path(@user.photo.id), :data => { :confirm => 'Are You sure want to delete this photo?' }, :method => :delete %>
                <% end %>
                <%= f.input :photo, as: :file, label: false, input_html: { class: "d-none" } %>
              </div>
            </div>
            <div class="col-lg-9 col-md-9 text-center text-md-start padding-eight-lr lg-padding-six-lr md-padding-15px-lr">
                <%= flash_message2 %>
                <h6 class="font-weight-600 text-uppercase margin-20px-bottom letter-spacing-8">My Account</h6>
                <div class="row">
                  <div class="col-lg-12">
                    <%= f.input :full_name, label: false, placeholder: "Full name" %>
                  </div>
                  <div class="col-lg-12">
                    <%= f.input :email, label: false, placeholder: "Email address" %>
                  </div>
                  <div class="col-lg-12">
                    <%= f.input :phone, label: false, placeholder: "Phone" %>
                  </div>
                  <div class="col-lg-12">
                    <%= f.input :dob, as: :string, label: false, placeholder: "Date of Birth", input_html: { class: "datepicker", value: get_input_date_value(f.object.dob,'%d/%m/%Y') } %>
                  </div>
                  <div class="col-lg-6">
                    <%= f.input :gender, as: :select, label: false, wrapper: :vertical_select_big, collection: [['1', 'Male'], ['0', 'Female']], label_method: :second, value_method: :first, prompt: "Choose your Gender" %>
                  </div>
                  <div class="col-lg-6">
                    <%= f.input :nationality, as: :select, label: false, collection: options_for_nationalities, prompt: "Choose your nationality" %>
                  </div>
                  <div class="submit-btn-wrapper text-center mt-2">
                      <button type="submit" class="btn btn-light-gray btn-medium text-medium margin-30px-top sm-margin-three-top">save changes</button>
                  </div>
                </div>
            </div>
        </div>
        <% end %>
    </div>
</section>
