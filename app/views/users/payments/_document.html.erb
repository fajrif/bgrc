<%# The one post-payment document. Rendered both standalone (show.html.erb) and
    into the modal on the Payment tab (show.js.erb), so the two cannot drift.
    Keyed on Purchase, which is what lets Golf, Grab & Go and Class Credits have
    a document at all — previously only court bookings did. %>
<div class="bbcc-receipt" id="receipt-document">
    <div class="bbcc-receipt-head">
        <div>
            <h1 class="bbcc-receipt-title"><%= configatron.site_title %></h1>
            <p class="bbcc-account-since"><%= raw configatron.location_address %></p>
        </div>
        <div class="bbcc-receipt-meta">
            <p class="bbcc-account-since mb-0">Receipt</p>
            <p class="bbcc-table-id mb-0">#<%= purchase.order_id %></p>
            <%# paid_at is settlement; created_at is only when checkout started. %>
            <p class="bbcc-account-since mb-0"><%= club_time(purchase.paid_at || purchase.created_at).strftime('%d %b %Y %H:%M') %></p>
        </div>
    </div>

    <table class="bbcc-receipt-rows">
        <tbody>
            <tr>
                <th>Billed to</th>
                <td>
                    <%= purchase.user.try(:full_name) %>
                    <% if purchase.user.try(:email).present? %>&middot; <%= purchase.user.email %><% end %>
                </td>
            </tr>
            <tr>
                <th>Type</th>
                <td><%= productable_type_label(purchase.productable_type) %></td>
            </tr>
        </tbody>
    </table>

    <%= render "users/payments/lines", purchase: purchase %>

    <table class="bbcc-receipt-rows">
        <tbody>
            <tr>
                <th>Payment method</th>
                <td>
                    <%= purchase.payment_type&.humanize || "—" %>
                    <%# Xendit puts the same value in payment_type and bank for card
                        payments, so only show bank when it actually adds something. %>
                    <% if purchase.bank.present? && !purchase.bank.casecmp?(purchase.payment_type.to_s) %>&middot; <%= purchase.bank.upcase %><% end %>
                    <% if purchase.masked_card.present? %>&middot; <%= purchase.masked_card %><% end %>
                </td>
            </tr>
            <tr>
                <th>Transaction ID</th>
                <td><%= purchase.transaction_id.presence || purchase.gateway_reference.presence || "—" %></td>
            </tr>
            <tr>
                <th>Status</th>
                <td>
                    <% if purchase.paid? %>
                        <span class="bbcc-badge bbcc-badge-paid">Paid</span>
                    <% elsif purchase.awaiting_payment? %>
                        <span class="bbcc-badge bbcc-badge-warn">Pending</span>
                    <% else %>
                        <span class="bbcc-badge bbcc-badge-danger"><%= purchase.status_message.presence || "Failed" %></span>
                    <% end %>
                </td>
            </tr>
            <tr class="bbcc-receipt-total">
                <th>Total paid</th>
                <td><%= purchase.price_label %></td>
            </tr>
        </tbody>
    </table>
</div>
