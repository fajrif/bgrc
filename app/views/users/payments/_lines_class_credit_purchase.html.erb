<table class="bbcc-receipt-lines">
    <thead>
        <tr><th>Description</th><th class="bbcc-receipt-lines-amount">Amount</th></tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <strong>Class Credits</strong>
                <span class="bbcc-receipt-lines-note"><%= item.group_class.try(:name) %></span>
                <span class="bbcc-receipt-lines-note"><%= item.sessions_count %> session(s)</span>
                <% if item.expires_at.present? %>
                    <span class="bbcc-receipt-lines-note">Valid until <%= item.expires_at.strftime('%d %b %Y') %></span>
                <% end %>
            </td>
            <td class="bbcc-receipt-lines-amount"><%= item.try(:price_label) %></td>
        </tr>
    </tbody>
</table>
