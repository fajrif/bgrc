<!-- start payment receipt -->
<section class="bbcc-section bbcc-account">
    <div class="container-lg">
        <%# bbcc-print-hide, not Bootstrap's d-print-none: application.css never
            requires bootstrap.min.css, so d-print-none does not exist here and
            this bar used to print itself. %>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 bbcc-print-hide">
            <%= link_to "Back to Payments", users_payments_path, class: "bbcc-link" %>
            <button type="button" class="bbcc-btn bbcc-btn-sm" onclick="window.print()">Print / Save as PDF</button>
        </div>

        <%= render "users/payments/document", purchase: @purchase %>
    </div>
</section>
<!-- end payment receipt -->
