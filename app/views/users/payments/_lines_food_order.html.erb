<table class="bbcc-receipt-lines">
    <thead>
        <tr><th>Description</th><th class="bbcc-receipt-lines-amount">Amount</th></tr>
    </thead>
    <tbody>
        <% item.food_order_items.each do |line| %>
            <tr>
                <td><strong><%= line.item_with_quantity %></strong></td>
                <td class="bbcc-receipt-lines-amount"><%= line.total_price_label %></td>
            </tr>
        <% end %>
    </tbody>
</table>
