<% if purchases.any? %>
<div class="bbcc-table-scroll">
  <table class="bbcc-table">
    <thead>
      <tr>
        <th>Order ID</th>
        <th>Type</th>
        <th>Description</th>
        <th>Amount</th>
        <th>Payment Type</th>
        <th>Status</th>
        <th>Date</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% purchases.each do |purchase| %>
        <tr>
          <td class="bbcc-table-id"><%= purchase.order_id %></td>
          <td><span class="bbcc-badge bbcc-badge-muted"><%= productable_type_label(purchase.productable_type) %></span></td>
          <td><%= purchase.productable.try(:name) || "—" %></td>
          <td><%= number_to_currency(purchase.gross_amount, unit: "Rp. ", separator: ",", delimiter: ".", precision: 0) %></td>
          <td><%= purchase.payment_type&.humanize || "—" %></td>
          <td>
            <% if purchase.status_code.in?(["200", "201"]) %>
              <span class="bbcc-badge bbcc-badge-paid">Paid</span>
            <% elsif purchase.status_code == "000" %>
              <span class="bbcc-badge bbcc-badge-warn">Pending</span>
            <% else %>
              <span class="bbcc-badge bbcc-badge-danger"><%= purchase.status_message&.truncate(20) || "Failed" %></span>
            <% end %>
          </td>
          <td><%= purchase.created_at.strftime('%d %b %Y %H:%M') %></td>
          <td>
            <% if purchase.status_code.in?(["200", "201"]) %>
              <%= link_to "Download", users_payment_path(purchase), class: "bbcc-btn bbcc-btn-sm" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<% else %>
  <div class="bbcc-table-empty">
    <p>No payment records found.</p>
  </div>
<% end %>
