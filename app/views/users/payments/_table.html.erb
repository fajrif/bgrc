<% if @purchases.any? %>
<table class="table table-hover table-responsive">
  <thead>
    <tr>
      <th>Order ID</th>
      <th>Type</th>
      <th>Description</th>
      <th>Amount</th>
      <th>Payment Type</th>
      <th>Status</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% @purchases.each do |purchase| %>
      <tr>
        <td class="font-weight-500 text-small"><%= purchase.order_id %></td>
        <td class="text-small">
          <span class="badge bg-secondary"><%= productable_type_label(purchase.productable_type) %></span>
        </td>
        <td class="text-small"><%= purchase.productable.try(:name) || "—" %></td>
        <td class="font-weight-500">
          <%= number_to_currency(purchase.gross_amount, unit: "Rp. ", separator: ",", delimiter: ".", precision: 0) %>
        </td>
        <td class="text-small"><%= purchase.payment_type&.humanize || "—" %></td>
        <td>
          <% status = purchase.status_code %>
          <% if status == "200" || status == "201" %>
            <span class="badge bg-success">Paid</span>
          <% elsif status == "000" %>
            <span class="badge bg-warning text-dark">Pending</span>
          <% else %>
            <span class="badge bg-danger"><%= purchase.status_message&.truncate(20) || "Failed" %></span>
          <% end %>
        </td>
        <td class="text-small text-muted"><%= purchase.created_at.strftime('%d %b %Y %H:%M') %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<% else %>
  <div class="text-center padding-40px-tb">
    <p class="text-medium">No payment records found.</p>
  </div>
<% end %>
