<div class="question-area section-padding pt-120">
		<div class="container">
				<div class="row">
						<div class="col-lg-12">
								<div class="question-touch">
										<h2>Login</h2>
										<p>
											Login to Book Your Experience
										</p>
										<p>
											<%= link_to user_google_oauth2_omniauth_authorize_path, :method => :post, :class => "theme-btn btn-big white" do %>
												<i class="fa fa-google"></i> Sign in with Google
											<% end %>
										</p>
										<%= simple_form_for(resource, :as => resource_name, :url => session_path(resource_name), :html => { :class => "contact-validation-active" }) do |f| %>
											<%= f.input :email, label: false, placeholder: "Email Address" %>
											<%= f.input :password, label: false, placeholder: "Password" %>
											<div class="col-lg-12 mb-45">
												<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
													<%= link_to "Forgot your password?", new_password_path(resource_name) %><br />
												<% end %>
												<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
													No Account? <%= link_to "Create one", new_registration_path(resource_name) %>
												<% end %>
											</div>
											<div class="submit-btn-wrapper">
													<button type="submit" class="theme-btn btn-big default">Login</button>
											</div>
										<% end %>
								</div>
						</div>
				</div>
		</div>
</div>
