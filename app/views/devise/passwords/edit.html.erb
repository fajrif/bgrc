<% content_for :auth_switch_text, "Remembered it?" %>
<% content_for :auth_switch_link, link_to("Log in", new_session_path(resource_name)) %>

<h1 class="bbcc-auth-title">Reset password</h1>
<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), wrapper: :vertical_form_plain, html: { method: :put, class: "bbcc-auth-formbody" }) do |f| %>
  <%= f.input :reset_password_token, as: :hidden %>
  <%= f.full_error :reset_password_token %>
  <%= f.input :password, label: "New Password", required: true, autofocus: true, placeholder: "Write your new password here" %>
  <%= f.input :password_confirmation, label: "Password Confirmation", placeholder: "Confirm your new password", required: true %>
  <button type="submit" class="bbcc-auth-submit">Save Changes</button>
<% end %>
