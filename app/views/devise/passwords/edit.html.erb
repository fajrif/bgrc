<h5 class="font-weight-600 margin-40px-bottom sm-margin-15px-bottom letter-spacing-8">RESET PASSWORD</h5>
<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), wrapper: :vertical_form_no_margin, html: { method: :put }) do |f| %>
  <%= f.input :reset_password_token, as: :hidden %>
  <%= f.full_error :reset_password_token %>
  <%= f.input :password,
              label: false,
              required: true,
              autofocus: true,
              placeholder: "New Password" %>
  <%= f.input :password_confirmation, label: false, placeholder: "Confirm your new password", required: true %>
  <div class="mb-4">
    <button type="submit" class="btn btn-light-gray btn-medium text-medium margin-30px-top sm-margin-three-top">Save Changes</button>
  </div>
  <div class="col-lg-12 mb-45">
    <%- if controller_name != 'sessions' %>
      <%= link_to "I already remember my password!", new_session_path(resource_name) %><br />
    <% end %>
  </div>
<% end %>
