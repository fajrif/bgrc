<% content_for :auth_switch_text, "Remembered it?" %>
<% content_for :auth_switch_link, link_to("Log in", new_session_path(resource_name)) %>

<h1 class="bbcc-auth-title">Forgot password</h1>
<p class="bbcc-auth-lead">Enter your email and we will send you instructions to reset your password.</p>
<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), wrapper: :vertical_form_plain, html: { class: "bbcc-auth-formbody" }) do |f| %>
  <%= f.input :email, label: "Email Address", placeholder: "Write your email here" %>
  <button type="submit" class="bbcc-auth-submit">Send Instructions</button>
<% end %>
