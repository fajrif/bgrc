<section class="small-section wow animate__fadeIn">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 text-center">
                <div class="bg-light-gray padding-eight-all border-radius-6 w-70 lg-w-80 xs-w-100 mx-auto lg-padding-60px-all sm-padding-30px-all">
                    <h5 class="font-weight-600 margin-40px-bottom sm-margin-15px-bottom letter-spacing-8">FORGOT PASSWORD</h5>
                    <%= flash_message2 %>
										<%= simple_form_for(resource, :as => resource_name, :url => password_path(resource_name)) do |f| %>
                      <%= f.input :email, label: false, placeholder: "Email Address" %>
											<div class="mb-4">
                        <button type="submit" class="btn btn-light-gray btn-medium text-medium margin-30px-top sm-margin-three-top">Send Instructions</button>
											</div>
                      <div class="col-lg-12 mb-45">
												<%- if controller_name != 'sessions' %>
													<%= link_to "I already remember my password!", new_session_path(resource_name) %><br />
												<% end %>
                      </div>
										<% end %>
                </div>
            </div>
        </div>
    </div>
</section>
