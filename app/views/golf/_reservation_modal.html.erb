<div class="modal fade bbcc-modal" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="bbcc-modal-title" id="reservationModalLabel">Book Tee Time</h2>
        <button type="button" class="bbcc-modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>

      <%= form_tag golf_reservations_path, method: :post, id: "reservation-modal-form" do %>
        <div class="modal-body">
          <input type="hidden" name="tee_time" id="modal-tee-time-input">

          <!-- Selected Tee Time -->
          <div class="bbcc-modal-callout">
            <span class="bbcc-modal-label">Selected Tee Time</span>
            <span class="bbcc-modal-value" id="modal-tee-time-display">—</span>
          </div>
          <p id="modal-tee-time-error" class="bbcc-field-error-text" style="display:none;"></p>

          <!-- Number of Players -->
          <div class="bbcc-field">
            <label for="modal_players_count">Number of Players</label>
            <select name="players_count" id="modal_players_count">
              <% [1, 2, 3, 4].each do |n| %>
                <option value="<%= n %>"><%= n %> <%= "Player".pluralize(n) %></option>
              <% end %>
            </select>
          </div>

          <!-- Number of Holes -->
          <div class="bbcc-modal-group">
            <span class="bbcc-modal-label">Number of Holes</span>
            <div class="bbcc-radio-row">
              <% golf_course.holes_list.each do |holes| %>
                <label class="bbcc-radio" for="modal_holes_<%= holes %>">
                  <input type="radio" name="holes" id="modal_holes_<%= holes %>"
                         value="<%= holes %>" <%= holes == golf_course.holes_list.last ? "checked" : "" %>>
                  <span><%= holes %> Holes</span>
                </label>
              <% end %>
            </div>
          </div>

          <!-- Estimated Green Fee -->
          <div class="bbcc-modal-summary">
            <div class="bbcc-modal-summary-row">
              <span>Rate per player</span>
              <span id="modal-rate-per-player">—</span>
            </div>
            <div class="bbcc-modal-summary-row bbcc-modal-summary-total">
              <span>Estimated Green Fee</span>
              <span id="modal-green-fee">—</span>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="bbcc-btn bbcc-btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="modal-submit-btn" class="bbcc-btn">Reserve Tee Time</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
(function() {
  var rates = <%= golf_course.golf_rates.each_with_object({}) { |r, h| (h[r.day_type] ||= {})[r.holes.to_s] = r.price.to_i }.to_json.html_safe %>;

  function formatRupiah(amount) {
    return 'Rp. ' + amount.toLocaleString('id-ID');
  }

  window.updateModalPrice = function() {
    var teeTimeVal = document.getElementById('modal-tee-time-input').value;
    var rateEl    = document.getElementById('modal-rate-per-player');
    var feeEl     = document.getElementById('modal-green-fee');
    if (!rateEl || !feeEl) return;

    if (!teeTimeVal) {
      rateEl.textContent = '—';
      feeEl.textContent  = '—';
      return;
    }

    var dt      = new Date(teeTimeVal);
    var day     = dt.getDay();
    var dayType = (day === 0 || day === 6) ? 'weekend' : 'weekday';

    var holesEl = document.querySelector('input[name="holes"]:checked');
    var holes   = holesEl ? holesEl.value : null;

    var playersEl = document.getElementById('modal_players_count');
    var players   = playersEl ? parseInt(playersEl.value) : 1;

    var dayRates  = rates[dayType] || {};
    var rate      = holes && dayRates[holes] ? dayRates[holes] : 0;
    var greenFee  = rate * players;

    rateEl.textContent = rate > 0 ? formatRupiah(rate) + ' / player' : '—';
    feeEl.textContent  = greenFee > 0 ? formatRupiah(greenFee) : '—';
  };

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('input[name="holes"]').forEach(function(radio) {
      radio.addEventListener('change', window.updateModalPrice);
    });

    var playersEl = document.getElementById('modal_players_count');
    if (playersEl) playersEl.addEventListener('change', window.updateModalPrice);
  });
})();
</script>
