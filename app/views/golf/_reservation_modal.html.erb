<div class="modal fade" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title alt-font text-uppercase font-weight-600" id="reservationModalLabel">Book Tee Time</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_tag golf_reservations_path, method: :post, id: "reservation-modal-form" do %>
        <div class="modal-body">
          <input type="hidden" name="tee_time" id="modal-tee-time-input">

          <!-- Selected Tee Time -->
          <div class="mb-4">
            <label class="text-medium font-weight-600 mb-1 d-block">Selected Tee Time</label>
            <div class="border padding-15px-all" style="background-color:#f8f9fa;border-radius:6px;">
              <span class="text-medium font-weight-600" id="modal-tee-time-display">—</span>
            </div>
            <div id="modal-tee-time-error" class="text-danger text-medium mt-2" style="display:none;"></div>
          </div>

          <!-- Number of Players -->
          <div class="mb-4">
            <label class="text-medium font-weight-600 mb-2 d-block" for="modal_players_count">Number of Players</label>
            <select name="players_count" id="modal_players_count" class="form-select text-medium">
              <% [1, 2, 3, 4].each do |n| %>
                <option value="<%= n %>"><%= n %> <%= "Player".pluralize(n) %></option>
              <% end %>
            </select>
          </div>

          <!-- Number of Holes -->
          <div class="mb-4">
            <label class="text-medium font-weight-600 mb-2 d-block">Number of Holes</label>
            <div class="d-flex flex-wrap gap-3">
              <% golf_course.holes_list.each do |holes| %>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="holes"
                         id="modal_holes_<%= holes %>" value="<%= holes %>" <%= holes == golf_course.holes_list.last ? "checked" : "" %>>
                  <label class="form-check-label text-medium" for="modal_holes_<%= holes %>">
                    <%= holes %> Holes
                  </label>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Estimated Green Fee -->
          <div class="border padding-15px-all" style="background-color:#f8f9fa;border-radius:6px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-medium text-medium-gray">Rate per player</span>
              <span class="text-medium" id="modal-rate-per-player">—</span>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-medium font-weight-600">Estimated Green Fee</span>
              <span class="text-medium font-weight-700" id="modal-green-fee" style="font-size:1.05em;">—</span>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-light-gray btn-medium text-medium" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" id="modal-submit-btn" class="btn btn-dark-gray btn-medium text-medium">Reserve Tee Time</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
(function() {
  var rates = <%= golf_course.golf_rates.each_with_object({}) { |r, h| (h[r.day_type] ||= {})[r.holes.to_s] = r.price.to_i }.to_json.html_safe %>;

  function formatRupiah(amount) {
    return 'Rp. ' + amount.toLocaleString('id-ID');
  }

  window.updateModalPrice = function() {
    var teeTimeVal = document.getElementById('modal-tee-time-input').value;
    var rateEl    = document.getElementById('modal-rate-per-player');
    var feeEl     = document.getElementById('modal-green-fee');
    if (!rateEl || !feeEl) return;

    if (!teeTimeVal) {
      rateEl.textContent = '—';
      feeEl.textContent  = '—';
      return;
    }

    var dt      = new Date(teeTimeVal);
    var day     = dt.getDay();
    var dayType = (day === 0 || day === 6) ? 'weekend' : 'weekday';

    var holesEl = document.querySelector('input[name="holes"]:checked');
    var holes   = holesEl ? holesEl.value : null;

    var playersEl = document.getElementById('modal_players_count');
    var players   = playersEl ? parseInt(playersEl.value) : 1;

    var dayRates  = rates[dayType] || {};
    var rate      = holes && dayRates[holes] ? dayRates[holes] : 0;
    var greenFee  = rate * players;

    rateEl.textContent = rate > 0 ? formatRupiah(rate) + ' / player' : '—';
    feeEl.textContent  = greenFee > 0 ? formatRupiah(greenFee) : '—';
  };

  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('input[name="holes"]').forEach(function(radio) {
      radio.addEventListener('change', window.updateModalPrice);
    });

    var playersEl = document.getElementById('modal_players_count');
    if (playersEl) playersEl.addEventListener('change', window.updateModalPrice);
  });
})();
</script>
