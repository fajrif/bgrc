<% content_for :header_light, true %>

<!-- start booking hub — golf -->
<section class="bbcc-section bbcc-hub">
    <div class="container-lg">
        <%= render "shared/booking_hub_tabs", active: :golf %>

        <% unless @golf_course %>
            <div class="bbcc-table-empty">
                <p>Golf course information is not available yet. Please check back later.</p>
                <%= link_to "Explore Club Life", club_life_path, class: "bbcc-btn" %>
            </div>
        <% else %>
            <div class="row g-4 g-lg-5">
                <!-- Left: course details + green fees + confirm -->
                <div class="col-12 col-lg-4">
                    <h2 class="bbcc-hub-heading">Course Details</h2>
                    <ul class="bbcc-hub-list">
                        <li>Available Holes: <%= @golf_course.holes_list.join(" / ") %> Holes</li>
                        <li>Tee Time Interval: Every <%= @golf_course.interval_minutes %> minutes</li>
                        <li>Max Players Per Group: <%= @golf_course.max_players %></li>
                        <% if @golf_course.location.present? %>
                            <li>Location: <%= @golf_course.location %></li>
                        <% end %>
                    </ul>

                    <% if @golf_course.golf_rates.any? %>
                        <h2 class="bbcc-hub-heading">Green Fees (Per Player)</h2>
                        <table class="bbcc-fees-table">
                            <thead>
                                <tr>
                                    <th>Holes</th>
                                    <th>Weekday</th>
                                    <th>Weekend</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% @golf_course.holes_list.each do |holes| %>
                                    <% weekday = @golf_course.golf_rates.find_by(holes: holes, day_type: :weekday, start_time: nil) %>
                                    <% weekend = @golf_course.golf_rates.find_by(holes: holes, day_type: :weekend, start_time: nil) %>
                                    <tr>
                                        <td><%= holes %> Holes</td>
                                        <td><%= weekday&.price_label || "—" %></td>
                                        <td><%= weekend&.price_label || "—" %></td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    <% end %>

                    <% window_rates = @golf_course.golf_rates.where.not(start_time: nil, end_time: nil) %>
                    <% if window_rates.any? %>
                        <h2 class="bbcc-hub-heading">Time-Based Pricing</h2>
                        <table class="bbcc-fees-table">
                            <thead>
                                <tr>
                                    <th>Holes</th>
                                    <th>Time</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% window_rates.order(:holes, :start_time).each do |rate| %>
                                    <tr>
                                        <td><%= rate.holes %> Holes</td>
                                        <td>
                                            <%= rate.start_time %>&ndash;<%= rate.end_time %><br>
                                            <span class="bbcc-fees-subtext"><%= rate.day_type.capitalize %></span>
                                        </td>
                                        <td><%= rate.price_label %></td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    <% end %>

                    <button type="button" id="tee-confirm-btn" class="bbcc-btn bbcc-hub-confirm" disabled>Confirm</button>

                    <%# the course photo only shows when an admin has attached one %>
                    <% if @golf_course.image.attached? %>
                        <div class="bbcc-hub-photo">
                            <%= image_tag @golf_course.image, alt: @golf_course.name %>
                        </div>
                    <% end %>
                </div>

                <!-- Right: tee time selector -->
                <div class="col-12 col-lg-8">
                    <h2 class="bbcc-hub-heading bbcc-teetime-title">Select Your Tee Time</h2>

                    <div class="bbcc-teetime-datefield">
                        <label for="golf-date-picker">Select Date</label>
                        <div class="bbcc-datenav">
                            <button type="button" id="golf-date-prev" class="bbcc-datenav-btn" aria-label="Previous day">
                                <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                            </button>
                            <input type="text" id="golf-date-picker"
                                   value="<%= Date.today.strftime('%d/%m/%Y') %>"
                                   placeholder="Select a date" readonly>
                            <button type="button" id="golf-date-next" class="bbcc-datenav-btn bbcc-datenav-btn-next" aria-label="Next day">
                                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <p id="tee-time-loading" class="bbcc-teetime-note" style="display:none;">
                        <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
                        Loading available tee times…
                    </p>

                    <div id="tee-time-grid" class="bbcc-teetime-grid">
                        <!-- Tee time slots loaded via AJAX -->
                        <p class="bbcc-teetime-note" id="tee-time-placeholder">Select a date to see available tee times.</p>
                    </div>
                </div>
            </div>
        <% end %>
    </div>
</section>
<!-- end booking hub — golf -->

<%= render "home/social_media" %>

<% if @golf_course %>
<%= render 'golf/reservation_modal', golf_course: @golf_course %>

<script>
(function() {
  var selectedDate = '<%= Date.today.strftime('%d/%m/%Y') %>';
  var teeTimesUrl = '<%= golf_tee_times_path %>';
  var autoRefreshInterval = null;
  var selectedSlot = null;   // { time, date, remaining } — chosen but not yet confirmed
  var picker = null;

  function formatDateForApi(dateStr) {
    var parts = dateStr.split('/');
    return parts[2] + '-' + parts[1] + '-' + parts[0];
  }

  function formatTeeTimeLabel(apiDate, time) {
    var dt = new Date(apiDate + 'T' + time);
    var options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    return dt.toLocaleDateString('en-US', options) + ' - ' + time;
  }

  function openReservationModal(slot) {
    var isoStr = slot.date + 'T' + slot.time;
    document.getElementById('modal-tee-time-input').value = isoStr;
    document.getElementById('modal-tee-time-display').textContent = formatTeeTimeLabel(slot.date, slot.time);
    document.getElementById('modal-tee-time-error').style.display = 'none';
    document.getElementById('modal-tee-time-error').textContent = '';
    if (typeof window.setModalMaxPlayers === 'function') window.setModalMaxPlayers(slot.remaining);
    if (typeof window.updateModalPrice === 'function') window.updateModalPrice();
    if (window.bbccPlayerNames) window.bbccPlayerNames.reset(document.getElementById('reservationModal'));
    bootstrap.Modal.getOrCreateInstance(document.getElementById('reservationModal')).show();
  }

  function setSelected(slot, button) {
    selectedSlot = slot;
    document.querySelectorAll('#tee-time-grid .bbcc-teeslot.is-selected').forEach(function(el) {
      el.classList.remove('is-selected');
      el.setAttribute('aria-pressed', 'false');
    });
    if (button) {
      button.classList.add('is-selected');
      button.setAttribute('aria-pressed', 'true');
    }
    document.getElementById('tee-confirm-btn').disabled = !slot;
  }

  function slotMarkup(slot, apiDate) {
    if (slot.past) {
      return '<span class="bbcc-teeslot is-disabled" title="This tee time has already passed">' + slot.time + '</span>';
    }
    if (!slot.available) {
      return '<span class="bbcc-teeslot is-disabled" title="Fully booked">' + slot.time + '</span>';
    }
    return '<button type="button" class="bbcc-teeslot tee-slot-btn" aria-pressed="false" ' +
           'data-time="' + slot.time + '" data-date="' + apiDate + '" data-remaining="' + slot.remaining + '" ' +
           'title="' + slot.remaining + ' spot' + (slot.remaining === 1 ? '' : 's') + ' left">' + slot.time + '</button>';
  }

  function loadTeeTimes(dateStr) {
    var grid = document.getElementById('tee-time-grid');
    var loading = document.getElementById('tee-time-loading');
    var placeholder = document.getElementById('tee-time-placeholder');
    var apiDate = formatDateForApi(dateStr);
    // an auto-refresh of the same day keeps the visitor's pick; a new day clears it
    var keep = selectedSlot && selectedSlot.date === apiDate ? selectedSlot : null;

    if (placeholder) placeholder.style.display = 'none';
    loading.style.display = 'block';
    grid.innerHTML = '';
    setSelected(null);

    fetch(teeTimesUrl + '?date=' + apiDate, { headers: { 'Accept': 'application/json' } })
    .then(function(r) { return r.json(); })
    .then(function(slots) {
      loading.style.display = 'none';
      if (!slots || slots.length === 0) {
        grid.innerHTML = '<p class="bbcc-teetime-note">No tee times available for this date.</p>';
        return;
      }
      grid.innerHTML = slots.map(function(slot) { return slotMarkup(slot, apiDate); }).join('');
      grid.querySelectorAll('.tee-slot-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          setSelected({ time: btn.dataset.time, date: btn.dataset.date,
                        remaining: parseInt(btn.dataset.remaining, 10) }, btn);
        });
        if (keep && btn.dataset.time === keep.time) {
          setSelected({ time: btn.dataset.time, date: btn.dataset.date,
                        remaining: parseInt(btn.dataset.remaining, 10) }, btn);
        }
      });
    })
    .catch(function() {
      loading.style.display = 'none';
      grid.innerHTML = '<p class="bbcc-teetime-note bbcc-teetime-note-error">Error loading tee times. Please try again.</p>';
    });
  }

  function startAutoRefresh(dateStr) {
    clearInterval(autoRefreshInterval);
    // Only auto-refresh for today — future dates have no slots going past
    var todayApi = formatDateForApi('<%= Date.today.strftime('%d/%m/%Y') %>');
    if (formatDateForApi(dateStr) === todayApi) {
      autoRefreshInterval = setInterval(function() { loadTeeTimes(dateStr); }, 60000);
    }
  }

  function updateDateNav() {
    var day = picker && picker.selectedDates[0];
    if (!day) return;
    var start = new Date(); start.setHours(0, 0, 0, 0);
    var current = new Date(day.getFullYear(), day.getMonth(), day.getDate());
    var diff = Math.round((current - start) / 86400000);
    document.getElementById('golf-date-prev').disabled = diff <= 0;
    document.getElementById('golf-date-next').disabled = diff >= 30;
  }

  function shiftDate(days) {
    var day = picker.selectedDates[0] || new Date();
    var next = new Date(day.getFullYear(), day.getMonth(), day.getDate() + days);
    picker.setDate(next, true);
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Modal form client-side past-time validation
    var modalForm = document.getElementById('reservation-modal-form');
    if (modalForm) {
      modalForm.addEventListener('submit', function(e) {
        var teeTimeVal = document.getElementById('modal-tee-time-input').value;
        var errorEl = document.getElementById('modal-tee-time-error');
        if (!teeTimeVal) {
          e.preventDefault();
          errorEl.textContent = 'No tee time selected.';
          errorEl.style.display = 'block';
          return;
        }
        if (new Date(teeTimeVal) <= new Date()) {
          e.preventDefault();
          errorEl.textContent = 'This tee time has already passed. Please select another slot.';
          errorEl.style.display = 'block';
        }
      });
    }

    document.getElementById('tee-confirm-btn').addEventListener('click', function() {
      if (selectedSlot) openReservationModal(selectedSlot);
    });
    document.getElementById('golf-date-prev').addEventListener('click', function() { shiftDate(-1); });
    document.getElementById('golf-date-next').addEventListener('click', function() { shiftDate(1); });

    if (typeof flatpickr === 'undefined') return;

    picker = flatpickr('#golf-date-picker', {
      dateFormat: 'd/m/Y',
      minDate: 'today',
      maxDate: new Date().fp_incr(30),
      defaultDate: 'today',
      onChange: function(selectedDates, dateStr) {
        selectedDate = dateStr;
        loadTeeTimes(dateStr);
        startAutoRefresh(dateStr);
        updateDateNav();
      }
    });
    updateDateNav();

    // Load today's tee times on page load and start auto-refresh
    loadTeeTimes(selectedDate);
    startAutoRefresh(selectedDate);
  });
})();
</script>
<% end %>
