<%= render "shared/breadcrumb", crumbs: [{ label: "Book", path: book_path }, { label: "Golf" }] %>

<!-- start booking hub — golf -->
<section class="bbcc-section bbcc-hub">
    <div class="container-lg">
        <%= render "shared/booking_hub_tabs", active: :golf %>

        <% unless @golf_course %>
            <div class="bbcc-table-empty">
                <p>Golf course information is not available yet. Please check back later.</p>
                <%= link_to "Explore Club Life", club_life_path, class: "bbcc-btn" %>
            </div>
        <% else %>
            <div class="row g-4 g-lg-5">
                <!-- Left: course details + green fees -->
                <div class="col-12 col-lg-4">
                    <h2 class="bbcc-hub-heading">Course Details</h2>
                    <ul class="bbcc-hub-list">
                        <li>Available Holes: <%= @golf_course.holes_list.join(" / ") %> Holes</li>
                        <li>Tee Time Interval: <%= @golf_course.interval_minutes %> minutes</li>
                        <li>Max Players Per Group: <%= @golf_course.max_players %></li>
                    </ul>

                    <% if @golf_course.golf_rates.any? %>
                        <h2 class="bbcc-hub-heading">Green Fees (Per Player)</h2>
                        <table class="bbcc-fees-table">
                            <thead>
                                <tr>
                                    <th>Holes</th>
                                    <th>Weekday</th>
                                    <th>Weekend</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% @golf_course.holes_list.each do |holes| %>
                                    <% weekday = @golf_course.golf_rates.find_by(holes: holes, day_type: :weekday, start_time: nil) %>
                                    <% weekend = @golf_course.golf_rates.find_by(holes: holes, day_type: :weekend, start_time: nil) %>
                                    <tr>
                                        <td><%= holes %> Holes</td>
                                        <td><%= weekday&.price_label || "—" %></td>
                                        <td><%= weekend&.price_label || "—" %></td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    <% end %>

                    <% window_rates = @golf_course.golf_rates.where.not(start_time: nil, end_time: nil) %>
                    <% if window_rates.any? %>
                        <h2 class="bbcc-hub-heading">Time-Based Pricing</h2>
                        <table class="bbcc-fees-table">
                            <thead>
                                <tr>
                                    <th>Holes</th>
                                    <th>Time</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% window_rates.order(:holes, :start_time).each do |rate| %>
                                    <tr>
                                        <td><%= rate.holes %> Holes</td>
                                        <td>
                                            <%= rate.start_time %>&ndash;<%= rate.end_time %><br>
                                            <span class="bbcc-fees-subtext"><%= rate.day_type.capitalize %></span>
                                        </td>
                                        <td><%= rate.price_label %></td>
                                    </tr>
                                <% end %>
                            </tbody>
                        </table>
                    <% end %>

                    <%# the mockup leaves this column empty below the fees; the course photo only
                        shows when an admin has attached one %>
                    <% if @golf_course.image.attached? %>
                        <div class="bbcc-hub-photo">
                            <%= image_tag @golf_course.image, alt: @golf_course.name %>
                        </div>
                    <% end %>
                </div>

                <!-- Right: tee time selector and reservation form (Vue) -->
                <div class="col-12 col-lg-8">
                    <%= vue_component "GolfBookingApp", golf_booking_props(@golf_course) do %>
                        <div class="bbcc-teetime-card">
                            <h2 class="bbcc-teetime-title">Select Your Tee Time</h2>
                            <p class="bbcc-teetime-note">Loading available tee times&hellip;</p>
                        </div>
                    <% end %>
                </div>
            </div>
        <% end %>
    </div>
</section>
<!-- end booking hub — golf -->
