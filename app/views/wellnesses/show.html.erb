<section class="wow animate__fadeIn bg-light-grey padding-35px-tb page-title-small top-space">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 col-md-6 text-center text-md-start">
                <h1 class="alt-font font-weight-600 mb-0 text-uppercase"><%= @wellness.name %></h1>
            </div>
            <div class="col-lg-4 col-md-6 breadcrumb alt-font text-small justify-content-center justify-content-md-end sm-margin-10px-top">
                <ul>
                  <li><a href="<%= root_url %>">Home</a></li>
                  <li><a href="<%= wellnesses_url %>"><%= t('menu.wellness') %></a></li>
                  <li class="text-dark-gray"><%= @wellness.name %></li>
                </ul>
            </div>
        </div>
    </div>
</section>
<section class="wow animate__fadeIn">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-lg-12 col-md-12 text-center text-md-start padding-three-lr wow animate__fadeInLeft" data-wow-delay="0.1s">
              <h5 class="alt-font text-extra-dark-gray mb-4"><%= @wellness.name %></h5>
              <p><%= @wellness.short_description %></p>
              <p><%= @wellness.description %></p>
            </div>
        </div>
    </div>
</section>
