<%= render "home/banner" %>
<section class="wow animate__fadeIn">
    <div class="container">
        <div class="row row-cols-1 row-cols-lg-3 row-cols-md-2 justify-content-start">
          <% @facilities.each do |facility| %>
            <!-- start services item -->
            <div class="col-sm-9 margin-40px-bottom">
              <div class="overflow-hidden margin-20px-bottom">
                <%= link_to facility_path(facility) do %>
                  <%= image_tag facility.image.variant(resize_to_fill: [750,500]) %>
                <% end %>
              </div>
              <%= link_to facility.name, facility_path(facility), class: "alt-font margin-5px-bottom d-block text-extra-dark-gray font-weight-600 text-uppercase" %>
              <p class="w-95 xl-w-100"><%= facility.short_description.truncate(150) %></p>
            </div>
            <!-- end services item -->
          <% end %>
        </div>
        <%= paginate @facilities, theme: :pofo %>
    </div>
</section>
