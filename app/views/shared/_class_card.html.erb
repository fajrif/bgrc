<%# locals: gc: (required), book_path:.
    Optional: date_label:, coach_name:, pax:, used:, used_label:, cta_label:.
    The account page passes the full set; public listings pass only gc: and book_path:.
    data-category is what the public tab strip filters on. %>
<%
  date_label = local_assigns[:date_label]
  coach_name = local_assigns[:coach_name]
  pax        = local_assigns[:pax]
  used       = local_assigns[:used]
  used_label = local_assigns[:used_label]
  cta_label  = local_assigns.fetch(:cta_label, "Book Now")
  category_icon = { "private_lesson" => "fa-lock", "group_class" => "fa-user-group", "social_class" => "fa-users" }[gc.category] || "fa-lock"
%>
<div class="col-12 col-md-6 col-lg-4 bbcc-class-col" data-category="<%= gc.category %>">
    <article class="bbcc-class-card <%= "bbcc-class-card-used" if used %>">
        <div class="bbcc-class-chips">
            <span class="bbcc-class-chip"><i class="fa-solid <%= category_icon %>"></i><%= gc.category_label %></span>
            <% if gc.sport %>
                <span class="bbcc-class-chip"><i class="fa-solid fa-table-tennis-paddle-ball"></i><%= gc.sport.name %></span>
            <% end %>
        </div>

        <h3 class="bbcc-class-card-title"><%= gc.name %></h3>

        <% if date_label.present? %>
            <p class="bbcc-class-meta"><span><i class="fa-regular fa-calendar"></i><%= date_label %></span></p>
        <% end %>
        <p class="bbcc-class-meta">
            <span><i class="fa-regular fa-clock"></i><%= gc.duration_label %></span>
            <span><i class="fa-solid fa-user-group"></i><%= gc.max_pax %> Max</span>
            <% if pax %>
                <span><i class="fa-solid fa-users"></i><%= pax %> Pax</span>
            <% end %>
        </p>

        <p class="bbcc-class-card-price"><%= gc.check_price(pax || gc.min_pax) %></p>

        <% if coach_name.present? %>
            <div class="bbcc-class-coach">
                <span class="bbcc-class-coach-avatar"><i class="fa-solid fa-user"></i></span>
                <div>
                    <div class="bbcc-class-coach-label">Coach</div>
                    <div class="bbcc-class-coach-name"><%= coach_name %></div>
                </div>
            </div>
        <% end %>

        <% if used %>
            <span class="bbcc-btn bbcc-btn-block bbcc-btn-disabled"><%= used_label %></span>
        <% else %>
            <%= link_to cta_label, book_path, class: "bbcc-btn bbcc-btn-block" %>
        <% end %>
    </article>
</div>
