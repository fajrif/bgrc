<!-- start header -->
<header>
    <!-- topbar -->
    <div class="top-header-area bg-black padding-10px-tb">
        <div class="container-lg">
            <div class="row align-items-center m-0">
                <div class="col-6 ps-lg-0 align-items-center justify-content-start text-white-2">
                    <div class="btn-group dropdown-style-1">
                        <button type="button" class="btn dropdown-toggle sm-w-100" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                          <% if I18n.locale == :en %>
                            EN <span class="caret"></span>
                          <% elsif I18n.locale == :id %>
                            ID <span class="caret"></span>
                          <% end %>
                        </button>
                        <%= get_locale_current_page_route %>
                    </div>
                </div>
                <div class="col-6 pe-lg-0 alt-font d-flex align-items-center justify-content-end gap-2">
                    <% if user_signed_in? %>
                      <div class="btn-group dropdown-style-1">
                        <button type="button" class="btn dropdown-toggle sm-w-100 text-uppercase text-white-2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                          <%= current_user.full_name %>
                        </button>
                        <%= get_current_user_menu_routes %>
                      </div>
                    <% else %>
                      <a href="<%= new_user_registration_path %>" class="text-small text-link-white-2 text-uppercase line-height-normal" title="Sign Up">Sign Up</a>
                      |
                      <a href="<%= new_user_session_path %>" class="text-small text-link-white-2 text-uppercase line-height-normal" title="Login">Login</a>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
    <!-- end topbar -->
    <!-- start navigation -->
    <nav class="navbar navbar-default bootsnav header-dark background-transparent menu-logo-center navbar-expand-lg">
        <div class="container-lg nav-header-container">
            <!-- start logo -->
            <div class="center-logo">
              <%= link_to root_path, class: "logo" do %>
                <%= image_tag("logo2.png", class: "logo", alt: "Bali Golf & Racket Club") %>
              <% end %>
            </div>
            <!-- end logo -->
            <div class="col col-lg-12 accordion-menu">
                <button type="button" class="navbar-toggler collapsed" data-bs-toggle="collapse" data-bs-target="#navbar-collapse-toggle-1">
                  <span class="sr-only">toggle navigation</span>
                  <span class="icon-bar"></span>
                  <span class="icon-bar"></span>
                  <span class="icon-bar"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between" id="navbar-collapse-toggle-1">
                    <ul class="nav navbar-nav alt-font text-normal w-40 md-w-100 text-sm-start justify-content-start" data-in="animate__fadeIn" data-out="animate__fadeOut">
                      <li><a href="<%= facilities_path %>"><%= t('menu.facilities') %></a></li>
                      <li class="dropdown simple-dropdown">
                        <a href="#"><%= t('menu.sports') %></a><i class="fa-solid fa-angle-down dropdown-toggle" data-bs-toggle="dropdown" aria-hidden="true"></i>
                          <!-- start sub menu -->
                          <ul class="dropdown-menu" role="menu">
                            <% Sport.all.each do |sport| %>
                              <li class="dropdown"><%= link_to sport.name, sport_path(sport) %></li>
                            <% end %>
                          </ul>
                      </li>
                      <li><a href="<%= packages_path %>"><%= t('menu.packages') %></a></li>
                      <li><a href="<%= promos_path %>"><%= t('menu.promos') %></a></li>
                    </ul>
                    <ul class="nav navbar-nav navbar-right no-margin alt-font text-normal w-40 md-w-100 justify-content-end" data-in="animate__fadeIn" data-out="animate__fadeOut">
                      <li><a href="<%= events_path %>"><%= t('menu.events') %></a></li>
                      <li><a href="<%= about_path %>"><%= t('menu.about') %></a></li>
                      <li><a href="<%= blogs_path %>"><%= t('menu.blogs') %></a></li>
                      <li><a href="<%= get_contact_path %>"><%= t('menu.contact') %></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>
    <!-- end navigation -->
</header>
<!-- end header -->
