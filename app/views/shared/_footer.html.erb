<!-- start footer -->
<footer class="footer-standard-light bg-light-grey">
    <div class="footer-widget-area padding-three-top sm-padding-30px-top">
        <div class="container">
            <div class="row">
                <div class="col-12 col-md-4 widget md-margin-30px-bottom text-center text-sm-start">
                    <!-- start logo -->
                    <%= link_to root_url, class: "margin-20px-bottom d-inline-block" do %>
                      <%= image_tag("logo.png", class: "footer-logo", alt: "Bali Golf & Racket Club") %>
                    <% end %>
                    <!-- end logo -->
                    <p class="d-block text-medium margin-30px-bottom w-100">
                      <%= raw(configatron.location_address) %>
                    </p>
                    <!-- start social media -->
                    <div class="social-icon-style-8 d-inline-block align-middle">
                      <ul class="small-icon no-margin-bottom">
                        <li><a class="facebook" href="<%= raw(configatron.social_facebook_url) %>" target="_blank"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a></li>
                        <li><a class="twitter" href="<%= raw(configatron.social_twitter_url) %>" target="_blank"><i class="fa-brands fa-twitter"></i></a></li>
                        <li><a class="google" href="<%= raw(configatron.social_google_plus_url) %>" target="_blank"><i class="fa-brands fa-google-plus-g"></i></a></li>
                        <li><a class="instagram" href="<%= raw(configatron.social_instagram_url) %>" target="_blank"><i class="fa-brands fa-instagram no-margin-right" aria-hidden="true"></i></a></li>
                      </ul>
                    </div>
                    <!-- end social media -->
                </div>
                <!-- start links -->
                <div class="col-12 col-md-8 widget padding-45px-left md-padding-15px-left xs-margin-30px-bottom text-center text-sm-start">
                    <p class="d-block text-medium margin-30px-bottom w-70 sm-w-100">
                      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi. 
                    </p>
                    <p class="text-medium">
                      Supported by: <strong>MITS ACADEMY</strong>
                    </p>
                    <div class="d-flex justify-content-start gap-4">
                      <ul class="list-unstyled">
                        <li><a class="text-medium" href="<%= about_path %>"><%= t('menu.about') %></a></li>
                        <li><a class="text-medium" href="<%= facilities_path %>"><%= t('menu.facilities') %></a></li>
                        <li><a class="text-medium" href="<%= packages_path %>"><%= t('menu.packages') %></a></li>
                      </ul>
                      <ul class="list-unstyled">
                        <li><a class="text-medium" href="<%= events_path %>"><%= t('menu.events') %></a></li>
                        <li><a class="text-medium" href="<%= blogs_path %>"><%= t('menu.blogs') %></a></li>
                        <li><a class="text-medium" href="<%= get_contact_path %>"><%= t('menu.contact') %></a></li>
                      </ul>
                    </div>
                </div>
                <!-- end links -->
            </div>
        </div>
    </div>
    <div class="bg-light-grey padding-20px-tb text-center sm-padding-30px-tb">
        <div class="container">
            <div class="row row-cols-1 row-cols-md-2">
                <!-- start copyright -->
                <div class="col text-small text-md-start text-center">&copy; 2024 Bali Golf &amp; Racket Club</div>
                <div class="col text-small">
                  <div class="d-flex align-center justify-content-center justify-content-md-end gap-2">
                    <a href="<%= disclaimer_path %>"><%= t('menu.disclaimer') %></a>
                    |
                    <a href="<%= privacy_path %>"><%= t('menu.privacy_policy') %></a>
                    |
                    <a href="<%= faq_path %>"><%= t('menu.faq') %></a>
                  </div>
                </div>
                <!-- end copyright -->
            </div>
        </div>
    </div>
</footer>
<!-- end footer -->


