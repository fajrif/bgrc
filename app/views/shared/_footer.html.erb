<div class="whatsapp-wrapper">
  <a id="floating-whatsapp-btn" href="https://wa.me/<%= configatron.whatsapp_number.to_s.gsub(/\D/, '') %>?text=<%= url_encode("Hi Bali Beach Country Club, I saw your website and would like to ask about your facilities and services. Could you please assist me?") %>"><img src="<%= image_url('whatsapp.png') %>" alt="Chat on WhatsApp" /></a>
</div>

<!-- start footer -->
<footer class="bbcc-footer">
    <div class="container-lg">
        <div class="row bbcc-footer-main">
            <!-- left column -->
            <div class="col-12 col-lg-5 bbcc-footer-left">
                <%= link_to root_url, class: "bbcc-footer-logo" do %>
                    <%= image_tag "bbcc-logo.png", alt: "Bali Beach Country Club" %>
                <% end %>

                <div class="bbcc-footer-links">
                    <ul>
                        <li><a href="<%= book_path %>">Book</a></li>
                        <li><a href="<%= about_path %>">About Us</a></li>
                        <li><a href="<%= club_life_path %>">Club Life</a></li>
                        <li><a href="<%= dining_path %>">Dining</a></li>
                        <li><a href="<%= faq_path %>">FAQ</a></li>
                    </ul>
                    <ul>
                        <li><a href="<%= events_path %>">Events</a></li>
                        <li><a href="<%= highlights_path %>">Highlights</a></li>
                        <li><a href="<%= blogs_path %>">Blog</a></li>
                        <li><a href="<%= get_contact_path %>">Contact Us</a></li>
                    </ul>
                </div>

                <address class="bbcc-footer-address"><%= raw(configatron.location_address) %></address>

                <div class="bbcc-footer-social">
                    <a href="<%= raw(configatron.social_facebook_url) %>" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
                    <a href="<%= raw(configatron.social_instagram_url) %>" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
                    <a href="<%= raw(configatron.social_twitter_url) %>" target="_blank" rel="noopener" aria-label="Twitter"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
                    <a href="<%= raw(configatron.social_linkedin_url) %>" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
                </div>
            </div>

            <!-- right column -->
            <div class="col-12 col-lg-7 bbcc-footer-right">
                <p class="bbcc-footer-intro">
                    Discover world-class sports, dining, and wellness at Bali Beach Country Club &mdash; your
                    premier destination in Nusa Dua for golf, racquet sports, group classes, and unforgettable events.
                </p>
                <p class="bbcc-footer-supported">
                    Supported by:&nbsp;&nbsp;<%= link_to raw("<strong>MITS ACADEMY</strong>"), mits_academy_path %>
                </p>
                <div class="bbcc-footer-form">
                    <%= render "inquiries/form" %>
                </div>
            </div>
        </div>
    </div>

    <div class="bbcc-footer-bottom">
        <div class="container-lg">
            <div class="bbcc-footer-bottom-inner">
                <span class="bbcc-footer-copy">&copy; 2026 Bali Beach Country Club</span>
                <div class="bbcc-footer-legal">
                    <a href="<%= disclaimer_path %>" class="<%= 'active' if request.path == disclaimer_path %>"><%= t('menu.disclaimer') %></a>
                    <a href="<%= privacy_path %>" class="<%= 'active' if request.path == privacy_path %>"><%= t('menu.privacy_policy') %></a>
                    <a href="<%= terms_path %>" class="<%= 'active' if request.path == terms_path %>"><%= t('menu.terms_conditions') %></a>
                </div>
            </div>
        </div>
    </div>
</footer>
<!-- end footer -->
