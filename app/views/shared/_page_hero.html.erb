<%# locals: banner:, crumbs: %>
<% if banner %>
<!-- start page hero -->
<section class="bbcc-page-hero" style="background-image:url('<%= url_for(banner.image) %>');">
    <div class="bbcc-page-hero-overlay"></div>
    <div class="container-lg">
        <div class="bbcc-page-hero-body">
            <h1 class="bbcc-page-hero-title"><%= banner.title %></h1>
            <p class="bbcc-page-hero-desc"><%= banner.description.truncate(200) %></p>
        </div>
    </div>
</section>
<!-- end page hero -->
<% end %>
<%= render "shared/breadcrumb", crumbs: crumbs %>
