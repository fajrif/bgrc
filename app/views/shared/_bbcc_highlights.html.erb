<%# locals (optional): title:, highlights: — otherwise it queries its own data, since it is rendered from several pages that do not all set an ivar. %>
<% bbcc_highlights = local_assigns[:highlights] || Highlight.published.limit(9) %>
<% if bbcc_highlights.any? %>
<!-- start bbcc highlights -->
<section class="bbcc-section bbcc-section-alt bbcc-highlights-grid">
    <div class="container-lg">
        <h2 class="bbcc-title-lg"><%= local_assigns[:title] || "BBCC Highlights" %></h2>
        <div class="bbcc-swiper bbcc-slider" data-slides="1.15,2,3,3">
            <div class="swiper-wrapper">
                <% bbcc_highlights.each do |highlight| %>
                    <div class="swiper-slide">
                        <article class="bbcc-news-card">
                            <%= link_to highlight_path(highlight), class: "bbcc-news-card-image" do %>
                                <% if highlight.image.attached? %>
                                    <%= image_tag highlight.image.variant(resize_to_fill: [750, 750]), alt: highlight.title, loading: "lazy" %>
                                <% else %>
                                    <span class="bbcc-post-image-ph" style="background-image:url('<%= image_url('images/image-4.png') %>');"></span>
                                <% end %>
                            <% end %>
                            <time class="bbcc-news-card-date"><%= raw highlight.meta_label %></time>
                            <h3 class="bbcc-news-card-title"><%= link_to highlight.title, highlight_path(highlight) %></h3>
                            <p><%= highlight.short_description.to_s.truncate(140) %></p>
                            <%= link_to "Discover more", highlight_path(highlight), class: "bbcc-text-link" %>
                        </article>
                    </div>
                <% end %>
            </div>
            <%= render "shared/slider_controls" %>
        </div>
    </div>
</section>
<!-- end bbcc highlights -->
<% end %>
