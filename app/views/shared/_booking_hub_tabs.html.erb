<%# locals: active: — :golf, :racquet, :fitness, :spa or :dining %>
<%
	# Every tab now has a page of its own under /book, so the tabs are a plain
	# list — no Club Life lookup by English name, and no sport lookup to build
	# the racquet link (SearchController picks its own default sport).
	hub_tabs = [
		{ key: :golf,    label: "Golf",           icon: "fa-golf-ball-tee",            path: golf_path },
		{ key: :racquet, label: "Racquet Sports", icon: "fa-table-tennis-paddle-ball", path: search_path },
		{ key: :fitness, label: "Fitness",        icon: "fa-dumbbell",                 path: book_fitness_path },
		{ key: :spa,     label: "Spa & Wellness", icon: "fa-spa",                      path: book_spa_wellness_path },
		{ key: :dining,  label: "Dining",         icon: "fa-utensils",                 path: book_dining_path }
	]
%>
<!-- start booking hub tabs -->
<nav class="bbcc-hubtabs" aria-label="Booking sections">
	<% hub_tabs.each do |tab| %>
		<%= link_to tab[:path], class: ["bbcc-hubtab", ("active" if tab[:key] == active)],
								aria: { current: ("page" if tab[:key] == active) } do %>
			<i class="fa-solid <%= tab[:icon] %>" aria-hidden="true"></i>
			<span><%= tab[:label] %></span>
		<% end %>
	<% end %>
</nav>
<!-- end booking hub tabs -->
