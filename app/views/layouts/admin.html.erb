<!doctype html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable">
<head>
	<meta charset="utf-8" />
	<title><%= @meta_title.nil? ? configatron.site_title : @meta_title %></title>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<!-- Google fonts -->
	<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<!-- CDNJS -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/line-awesome/1.3.0/line-awesome/css/line-awesome.min.css" integrity="sha512-vebUliqxrVkBy3gucMhClmyQP9On/HAWQdKDXRaAlb/FKuTbxkjPKUyqVOxAcGwFDka79eTF+YXwfke1h3/wfg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css" integrity="sha512-MqL4+Io386IOPMKKyplKII0pVW5e+kb+PI/I3N87G3fHIfrgNNsRpzIXEi+0MQC0sR9xZNqZqCYVcC61fL5+Vg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
	<!-- favicon -->
	<%= favicon_link_tag 'favicon.png' %>
	<%= stylesheet_link_tag 'admin', :media => "all" %>
	<%= csrf_meta_tag %>
	<meta name="club-now" content="<%= ClubTime.now_iso %>">
	<%# window.clubNow(): the club's wall-clock time (CLUB_TIME_ZONE) as a local Date, whatever the admin's device
	    zone — for the admin calendars' "today" (same idea as app/frontend/lib/clubClock.ts on the public site). %>
	<script>
		window.clubNow = (function () {
			var meta = document.querySelector('meta[name="club-now"]');
			var parts = meta ? meta.content.split(/[-T:]/).map(Number) : null;
			var offset = parts ? new Date(parts[0], parts[1] - 1, parts[2], parts[3], parts[4], parts[5]).getTime() - Date.now() : 0;
			if (isNaN(offset)) offset = 0;
			return function () { return new Date(Date.now() + offset); };
		})();
	</script>
	<%= yield :head %>
</head>
<body>
	<!-- Begin page -->
	<div id="layout-wrapper">
		<%= render "admins/shared/header" %>
		<%= render "admins/shared/sidebar" %>
		<!-- ============================================================== -->
		<!-- Start right Content here -->
		<!-- ============================================================== -->
		<div class="main-content">
			<div class="page-content">
				<div class="container-fluid">
					<%= yield :title %>
					<div id="forFlashMessage">
						<%= flash_message %>
					</div>
					<%= yield %>
				</div>
			</div>
		</div>
	</div>
	<!-- END layout-wrapper -->
	<div id="myModal" class="modal fade" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
			</div>
		</div>
	</div>
	<!-- JAVASCRIPT -->
	<%= javascript_include_tag 'admin' %>
	<%= yield :tail %>
</body>
</html>
