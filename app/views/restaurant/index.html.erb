<section class="wow animate__fadeIn bg-light-grey padding-35px-tb page-title-small top-space">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8 col-md-6 text-center text-md-start">
                <h1 class="alt-font font-weight-600 mb-0 text-uppercase"><%= t('menu.restaurant') %></h1>
            </div>
            <div class="col-lg-4 col-md-6 breadcrumb alt-font text-small justify-content-center justify-content-md-end sm-margin-10px-top">
                <ul>
                  <li><a href="<%= root_url %>">Home</a></li>
                  <li class="text-dark-gray"><%= t('menu.restaurant') %></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<% if @facility %>
  <% if @facility.image.attached? %>
  <section class="wow animate__fadeIn p-0">
      <div class="container-fluid px-0">
          <%= image_tag @facility.image.variant(resize_to_limit: [1920, 600]), class: "w-100", style: "max-height: 500px; object-fit: cover;" %>
      </div>
  </section>
  <% end %>

  <section class="wow animate__fadeIn padding-70px-tb">
      <div class="container">
          <div class="row justify-content-center">
              <div class="col-lg-8 col-md-10 text-center text-md-start">
                  <h4 class="alt-font text-extra-dark-gray font-weight-600 mb-4"><%= @facility.name %></h4>
                  <p class="text-medium-gray"><%= @facility.short_description %></p>
              </div>
          </div>
      </div>
  </section>

  <% if @facility.description.present? %>
  <section class="wow animate__fadeIn padding-50px-tb bg-light-grey">
      <div class="container">
          <div class="row justify-content-center">
              <div class="col-lg-8 col-md-10">
                  <div class="alt-font text-extra-dark-gray">
                      <%= @facility.description %>
                  </div>
              </div>
          </div>
      </div>
  </section>
  <% end %>

  <% if @facility.images.attached? %>
  <section class="wow animate__fadeIn padding-70px-tb">
      <div class="container">
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% @facility.images.each do |img| %>
              <div class="col">
                  <div class="overflow-hidden">
                      <%= image_tag img.variant(resize_to_fill: [600, 400]), class: "w-100" %>
                  </div>
              </div>
            <% end %>
          </div>
      </div>
  </section>
  <% end %>
<% end %>
