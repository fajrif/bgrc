# Copy to /home/deployer/preproduction/bgrc/.env.production and fill in. chmod 600. Never commit the real file.
# systemd reads this (EnvironmentFile): plain KEY=value, no quotes, no `export`.
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_LEVEL=info

# Generate with:  bin/rails secret
SECRET_KEY_BASE=

DATABASE_PASSWORD=

# Where the site is reached. Return URLs from the gateways and emailed links use this.
# Pre-production:  https://128.199.83.171      Go-live: https://www.balibeachcountryclub.com
SITE_URL=https://128.199.83.171
# true once a trusted certificate is installed (also true with the self-signed IP certificate).
# Only set false if nginx serves this host over plain HTTP alone.
FORCE_SSL=true

# --- Payment gateway: midtrans or xendit -------------------------------------
# Switch: edit this line, then  sudo systemctl restart bgrc-unicorn
# Check:  RAILS_ENV=production bin/rails payments:gateway
PAYMENT_GATEWAY=midtrans

# Midtrans. Sandbox values (these are the defaults, listed for clarity).
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_API_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_JS_FILE=https://app.sandbox.midtrans.com/snap/snap.js
MIDTRANS_STATUS_API_URL=https://api.sandbox.midtrans.com/v2
# Live Midtrans:
#   MIDTRANS_API_URL=https://app.midtrans.com/snap/v1/transactions
#   MIDTRANS_JS_FILE=https://app.midtrans.com/snap/snap.js
#   MIDTRANS_STATUS_API_URL=https://api.midtrans.com/v2

# Xendit. One host for both modes: the key prefix decides it
# (xnd_development_... = test, xnd_production_... = live). See docs/xendit-setup.md.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

SENDGRID_SECRET_KEY=
